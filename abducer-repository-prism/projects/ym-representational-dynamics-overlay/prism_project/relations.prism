# Relation layer for ym-representational-dynamics-overlay.
# Owns edge/certificate contracts only; builders belong to future materialization.

type YangMillsOverlayDependency[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation AuditInputEnablesOverlayDisposition[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> YangMillsOverlayDependency[SourceValue, TargetValue]
