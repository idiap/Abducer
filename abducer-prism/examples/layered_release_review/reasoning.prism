from examples.layered_release_review.types import (
    ReadyToDeploy,
    ReleaseCandidate,
)
from examples.layered_release_review.occurrences import (
    CaptureEvidence,
    DefeaterInput,
    DeriveChecks,
    FindDefeaters,
    ReadinessInput,
    SupportReadiness,
)
from examples.layered_release_review.relations import Calibrate, Requires, Test

reasoning ReleaseReadiness(
    change: ReleaseCandidate,
) -> Supported[ReadyToDeploy()]:
    sequence:
        [evidence: CaptureEvidence(change)]
        [checks: DeriveChecks(evidence)] by Requires
        [defeaters: FindDefeaters(DefeaterInput(
            checks = checks,
            change = change,
        ))] by Test
        [finding: SupportReadiness(ReadinessInput(
            evidence = evidence,
            checks = checks,
            defeaters = defeaters,
            change = change,
        ))] by Calibrate

    return finding
