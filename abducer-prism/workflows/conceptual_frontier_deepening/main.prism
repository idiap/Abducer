# Fixture-backed typed smoke entrypoint for conceptual_frontier_deepening.
# Routing comments and linked validators remain outside this executable boundary.
from workflows.conceptual_frontier_deepening.materialization import converted_reasoning
from workflows.conceptual_frontier_deepening.reasoning import ConceptualFrontierDeepening
from workflows.conceptual_frontier_deepening.types import FormalizationReadinessAssessment, FrozenConceptualContext

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[FormalizationReadinessAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    context = FrozenConceptualContext(
        frozen_context = "fixture:conceptual_frontier_deepening:context.frozen_context",
    )
    flow = converted_reasoning(context)
    return solve ConceptualFrontierDeepening(context) using flow
