{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/canonical_discovery_content_manifest.schema.json",
  "title": "Immutable canonical discovery publication content manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_kind", "content_id", "content_digest", "created_utc", "files", "metadata"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_kind": {"enum": ["canonical_discovery_bundle", "canonical_discovery_evidence", "legacy_archive"]},
    "content_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,160}$"},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_utc": {"type": "string", "format": "date-time"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "metadata": {"type": "object"}
  }
}
