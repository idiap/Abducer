# Occurrence layer for cohere_fast_manuscript_release.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.

from types import (
    IndependentAuditPacket,
    ClaimBoundedPresentation,
    ManuscriptReleaseDisposition,
)

type UnresolvedClaimBoundedPresentationProjection = IndependentAuditPacket -> Generated[ClaimBoundedPresentation]

type EvidentialManuscriptReleaseDispositionAssessment = ClaimBoundedPresentation -> Generated[ManuscriptReleaseDisposition]
