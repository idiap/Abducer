{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/dynamic_experiment_causal_materializer_portable_records_v3.schema.json",
  "title": "Path-free causal byte-materializer protocol records v3",
  "description": "A closed union of relocation-safe projections derived from one locally verified causal byte-materializer snapshot. These records preserve protocol identity, retry history, dependency commitments, and clock ordering while replacing every workspace locator with an exact content-object reference. They are typed opaque evidence, not semantic authorship, theory selection, proof, experiment interpretation, or physics authority.",
  "oneOf": [
    {"$ref": "#/$defs/requestRecord"},
    {"$ref": "#/$defs/attemptRecord"},
    {"$ref": "#/$defs/clockRecord"},
    {"$ref": "#/$defs/dependencyRecord"}
  ],
  "$defs": {
    "digest": {
      "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"
    },
    "identifier": {
      "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"
    },
    "namespace": {
      "$ref": "./dynamic_experiment_compact_evidence_ref_v3.schema.json#/properties/namespace"
    },
    "contentRef": {
      "$ref": "./dynamic_experiment_content_object_ref_v1.schema.json"
    },
    "artifactRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"object_kind": {"const": "causal_materializer_artifact_evidence_v3"}}}
      ]
    },
    "requestRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"object_kind": {"const": "causal_materializer_request_record_v3"}}}
      ]
    },
    "attemptRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"object_kind": {"const": "causal_materializer_attempt_record_v3"}}}
      ]
    },
    "authorityBoundary": {
      "const": "local_exact_byte_materialization_only_not_semantic_authorship_external_independence_theory_selection_proof_or_physics_authority"
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "version", "kind"],
      "properties": {
        "operator_id": {"const": "canonical-causal-byte-materializer-v3"},
        "version": {"const": "3.0.0"},
        "kind": {"const": "support_probe"}
      }
    },
    "baseRecord": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_version",
        "record_kind",
        "record_id",
        "record_digest",
        "source_snapshot_digest",
        "semantic_authorship",
        "authority_boundary"
      ],
      "properties": {
        "schema_version": {"const": "3.0.0"},
        "record_id": {"$ref": "#/$defs/identifier"},
        "record_digest": {"$ref": "#/$defs/digest"},
        "source_snapshot_digest": {"$ref": "#/$defs/digest"},
        "semantic_authorship": {"const": false},
        "authority_boundary": {"$ref": "#/$defs/authorityBoundary"}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "causal_stage_id",
        "materializer_role",
        "artifact_id",
        "artifact_digest",
        "evidence_authority_id",
        "authority_boundary",
        "semantic_authorship",
        "dependency_authority_digest"
      ],
      "properties": {
        "causal_stage_id": {"$ref": "#/$defs/identifier"},
        "materializer_role": {"$ref": "#/$defs/identifier"},
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "evidence_authority_id": {"$ref": "#/$defs/identifier"},
        "authority_boundary": {"$ref": "#/$defs/authorityBoundary"},
        "semantic_authorship": {"const": false},
        "dependency_authority_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "requestRecord": {
      "allOf": [
        {"$ref": "#/$defs/baseRecord"},
        {
          "type": "object",
          "required": [
            "source_request_id",
            "source_request_digest",
            "invocation_id",
            "operator",
            "identity",
            "required",
            "requested_at",
            "parameters",
            "artifact_ref",
            "declared_artifact_id",
            "declared_artifact_digest"
          ],
          "properties": {
            "contract_version": {"const": "causal-byte-materializer-portable-request/3.0.0"},
            "record_kind": {"const": "causal_materializer_request_record_v3"},
            "source_request_id": {"$ref": "#/$defs/identifier"},
            "source_request_digest": {"$ref": "#/$defs/digest"},
            "invocation_id": {"$ref": "#/$defs/identifier"},
            "operator": {"$ref": "#/$defs/operator"},
            "identity": {"$ref": "#/$defs/namespace"},
            "required": {"const": true},
            "requested_at": {"type": "string", "format": "date-time"},
            "parameters": {"$ref": "#/$defs/parameters"},
            "artifact_ref": {"$ref": "#/$defs/artifactRef"},
            "declared_artifact_id": {"$ref": "#/$defs/identifier"},
            "declared_artifact_digest": {"$ref": "#/$defs/digest"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_id",
        "version",
        "status",
        "dependency_authority_digest",
        "stdout_digest",
        "stderr_digest",
        "exit_code"
      ],
      "properties": {
        "validator_id": {"const": "canonical-causal-byte-materializer-validator-v3"},
        "version": {"const": "3.0.0"},
        "status": {"enum": ["passed", "failed", "not_run"]},
        "dependency_authority_digest": {"$ref": "#/$defs/digest"},
        "stdout_digest": {"$ref": "#/$defs/digest"},
        "stderr_digest": {"$ref": "#/$defs/digest"},
        "exit_code": {"type": ["integer", "null"]}
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["error_type", "message_digest"],
      "properties": {
        "error_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "message_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "attemptRecord": {
      "allOf": [
        {"$ref": "#/$defs/baseRecord"},
        {
          "type": "object",
          "required": [
            "source_receipt_id",
            "source_receipt_digest",
            "request_ref",
            "artifact_ref",
            "request_id",
            "request_digest",
            "invocation_id",
            "attempt",
            "operator",
            "started_at",
            "completed_at",
            "duration_seconds",
            "status",
            "exit_code",
            "stdout_digest",
            "stderr_digest",
            "validator",
            "error",
            "materialized_copy_status"
          ],
          "properties": {
            "contract_version": {"const": "causal-byte-materializer-portable-attempt/3.0.0"},
            "record_kind": {"const": "causal_materializer_attempt_record_v3"},
            "source_receipt_id": {"$ref": "#/$defs/identifier"},
            "source_receipt_digest": {"$ref": "#/$defs/digest"},
            "request_ref": {"$ref": "#/$defs/requestRef"},
            "artifact_ref": {"$ref": "#/$defs/artifactRef"},
            "request_id": {"$ref": "#/$defs/identifier"},
            "request_digest": {"$ref": "#/$defs/digest"},
            "invocation_id": {"$ref": "#/$defs/identifier"},
            "attempt": {"type": "integer", "minimum": 1, "maximum": 32},
            "operator": {"$ref": "#/$defs/operator"},
            "started_at": {"type": "string", "format": "date-time"},
            "completed_at": {"type": "string", "format": "date-time"},
            "duration_seconds": {"type": "number", "minimum": 0, "maximum": 60},
            "status": {"enum": ["failed", "timed_out", "succeeded"]},
            "exit_code": {"type": ["integer", "null"]},
            "stdout_digest": {"$ref": "#/$defs/digest"},
            "stderr_digest": {"$ref": "#/$defs/digest"},
            "validator": {"$ref": "#/$defs/validator"},
            "error": {"$ref": "#/$defs/error"},
            "materialized_copy_status": {
              "enum": ["not_available", "exact_input_output_history_alias_verified"]
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]},
          "then": {
            "properties": {
              "error": {"type": "null"},
              "materialized_copy_status": {"const": "exact_input_output_history_alias_verified"},
              "validator": {"properties": {"status": {"const": "passed"}}}
            }
          },
          "else": {
            "properties": {
              "error": {"type": "object"},
              "materialized_copy_status": {"const": "not_available"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "clockRecord": {
      "allOf": [
        {"$ref": "#/$defs/baseRecord"},
        {
          "type": "object",
          "required": [
            "source_clock_id",
            "source_clock_digest",
            "clock_authority_id",
            "invocation_id",
            "request_ref",
            "successful_receipt_ref",
            "requested_at",
            "started_at",
            "completed_at",
            "sealed_at",
            "ordering_verified"
          ],
          "properties": {
            "contract_version": {"const": "causal-byte-materializer-portable-clock/3.0.0"},
            "record_kind": {"const": "causal_materializer_clock_record_v3"},
            "source_clock_id": {"$ref": "#/$defs/identifier"},
            "source_clock_digest": {"$ref": "#/$defs/digest"},
            "clock_authority_id": {"const": "canonical-local-governed-utc-clock"},
            "invocation_id": {"$ref": "#/$defs/identifier"},
            "request_ref": {"$ref": "#/$defs/requestRef"},
            "successful_receipt_ref": {"$ref": "#/$defs/attemptRef"},
            "requested_at": {"type": "string", "format": "date-time"},
            "started_at": {"type": "string", "format": "date-time"},
            "completed_at": {"type": "string", "format": "date-time"},
            "sealed_at": {"type": "string", "format": "date-time"},
            "ordering_verified": {"const": true}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "source_entry_commitment",
        "roles",
        "byte_size",
        "content_digest"
      ],
      "properties": {
        "component_id": {"$ref": "#/$defs/identifier"},
        "source_entry_commitment": {"$ref": "#/$defs/digest"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "byte_size": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "declaredRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_id", "source_root_commitment", "kind", "roles", "component_id"],
      "properties": {
        "root_id": {"$ref": "#/$defs/identifier"},
        "source_root_commitment": {"$ref": "#/$defs/digest"},
        "kind": {"enum": ["entry_python", "semantic"]},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "component_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "runtimeDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "dependencyRecord": {
      "allOf": [
        {"$ref": "#/$defs/baseRecord"},
        {
          "type": "object",
          "required": [
            "source_dependency_authority_digest",
            "scope",
            "source_authority_boundary",
            "declared_roots",
            "components",
            "schema_closure",
            "import_boundary",
            "runtime_dependencies"
          ],
          "properties": {
            "contract_version": {"const": "causal-byte-materializer-portable-dependency/3.0.0"},
            "record_kind": {"const": "causal_materializer_dependency_record_v3"},
            "source_dependency_authority_digest": {"$ref": "#/$defs/digest"},
            "scope": {"const": "dynamic-experiment-runtime-v3"},
            "source_authority_boundary": {
              "const": "exact_local_dependency_environment_and_executable_identity_only_not_external_truth_theorem_or_physics_authority"
            },
            "declared_roots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/declaredRoot"}
            },
            "components": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/component"}
            },
            "schema_closure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["literal_component_ids", "referenced_component_ids"],
              "properties": {
                "literal_component_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"$ref": "#/$defs/identifier"}
                },
                "referenced_component_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"$ref": "#/$defs/identifier"}
                }
              }
            },
            "import_boundary": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policy",
                "repository_local_python_component_ids",
                "stdlib_modules",
                "third_party_modules"
              ],
              "properties": {
                "policy": {"const": "conservative_repository_local_ast_import_closure_v2"},
                "repository_local_python_component_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"$ref": "#/$defs/identifier"}
                },
                "stdlib_modules": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "third_party_modules": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            },
            "runtime_dependencies": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/runtimeDependency"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
