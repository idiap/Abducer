{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/schemas/literature_assimilation_packet.schema.json",
  "title": "Literature assimilation packet",
  "description": "Claim-level causal mapping from one frozen target-scoped search snapshot into theory, hypotheses, genealogy, and scheduling.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "target_id", "theory_state_digest", "prior_snapshot_id", "selected_snapshot", "resolution", "source_delta", "theory_mappings", "hypothesis_rebase_status", "hypothesis_rebase", "opportunity_frontier", "ledger_events", "stale_branch_ids", "explicit_unknowns", "next_theory_actions", "content_digest"],
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "2.0"}}},
      "then": {"required": ["mapping_provenance"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "3.0"}}},
      "then": {"required": ["mapping_provenance", "semantic_claim_layer_digest", "semantic_coverage_audit"]}
    },
    {"if": {"properties": {"schema_version": {"const": "4.0"}}}, "then": {"required": ["mapping_provenance", "semantic_claim_layer_digest", "semantic_coverage_audit", "derivation_replay"]}},
    {
      "if": {"properties": {"schema_version": {"const": "1.0"}}},
      "then": {"properties": {"mapping_provenance": false}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "digest": {"type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1}
  },
  "properties": {
    "schema_version": {"enum": ["1.0", "2.0", "3.0", "4.0"]},
    "packet_id": {"$ref": "#/$defs/id"},
    "target_id": {"$ref": "#/$defs/id"},
    "theory_state_digest": {"$ref": "#/$defs/digest"},
    "prior_snapshot_id": {"type": ["string", "null"]},
    "selected_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "content_digest", "search_completed_at", "coverage_cutoff", "provenance_mode", "coverage_limits", "validator_receipt_ids"],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/id"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "search_completed_at": {"type": "string", "format": "date-time"},
        "coverage_cutoff": {"$ref": "#/$defs/text"},
        "provenance_mode": {"enum": ["live", "local_only", "frozen_response_replay"]},
        "coverage_limits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "validator_receipt_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freshness_status", "candidate_snapshot_ids", "selection_reason", "target_match", "active_investment_gate"],
      "properties": {
        "freshness_status": {"enum": ["current", "stale", "local_only", "refresh_required"]},
        "candidate_snapshot_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "selection_reason": {"$ref": "#/$defs/text"},
        "target_match": {"enum": ["pass", "fail"]},
        "active_investment_gate": {"enum": ["pass", "blocked_local_only", "blocked_stale", "blocked_invalid"]},
        "freshness_policy": {"const": "search_completion_bounded_consumption_v1"},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "max_age_seconds": {"type": "integer", "minimum": 1, "maximum": 2592000},
        "consume_before": {"type": "string", "format": "date-time"},
        "authority_scope": {"const": "historical_assimilation_only; present use must recompute against consume_before"}
      }
    },
    "source_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed_or_retracted", "corrected_or_superseded", "newly_relevant_old_sources", "unchanged_decisive_sources"],
      "properties": {
        "added": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "removed_or_retracted": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "corrected_or_superseded": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "newly_relevant_old_sources": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "unchanged_decisive_sources": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "mapping_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "derivation_id", "derivation_digest", "authority_id"],
      "properties": {
        "mode": {"enum": ["operator_supplied_interpretive_mapping", "deterministic_claim_derivation"]},
        "derivation_id": {"type": ["string", "null"]},
        "derivation_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "authority_id": {"$ref": "#/$defs/id"},
        "semantic_claim_layer_id": {"type": ["string", "null"]},
        "semantic_claim_layer_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "semantic_authority_id": {"type": ["string", "null"]}
      }
    },
    "theory_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mapping_id", "source_id", "theory_object_ids", "object_kinds", "relation", "exact_claim", "source_limitation", "conceptual_change", "event_type", "coverage_limits", "confidence"],
        "properties": {
          "mapping_id": {"$ref": "#/$defs/id"},
          "source_id": {"$ref": "#/$defs/id"},
          "theory_object_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "object_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["concept", "assumption", "mechanism", "barrier", "comparator", "hypothesis", "genealogy", "proof_obligation", "schedule"]}},
          "relation": {"enum": ["supports", "contradicts", "absorbs", "sharpens", "reframes", "transfers", "leaves_open"]},
          "exact_claim": {"$ref": "#/$defs/text"},
          "source_limitation": {"$ref": "#/$defs/text"},
          "conceptual_change": {"$ref": "#/$defs/text"},
          "event_type": {"enum": ["spawn", "merge", "split", "reframe", "demote", "retire", "reprioritize", "new_question", "justified_no_change"]},
          "coverage_limits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
          "confidence": {"enum": ["low", "medium", "high"]},
          "source_version": {"$ref": "#/$defs/text"}, "source_correction_status": {"enum": ["none_known", "corrected", "superseded", "retracted", "unknown"]},
          "semantic_claim_id": {"$ref": "#/$defs/id"}, "semantic_claim_digest": {"$ref": "#/$defs/digest"},
          "semantic_relation": {"enum": ["entails", "contradicts", "leaves_open", "unresolved"]},
          "semantic_warrant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "semantic_warrant_digest": {"$ref": "#/$defs/digest"},
          "semantic_basis_mode": {"enum": ["source_level_explicit", "bounded_lexical_fallback"]}
          ,"claim_origin": {"enum": ["verbatim_source_excerpt", "author_paraphrase", "model_extraction", "internal_target_audit"]}, "claim_authority_class": {"type": "string", "minLength": 1}, "semantic_authority_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "hypothesis_rebase_status": {"enum": ["current", "provisional_local_only", "stale", "not_performed"]},
    "hypothesis_rebase": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "pre_search_genealogy", "literature_relation", "source_ids", "required_revision", "routing_effect", "rebased_snapshot_digest"],
        "properties": {
          "hypothesis_id": {"$ref": "#/$defs/id"},
          "pre_search_genealogy": {"type": "array", "items": {"$ref": "#/$defs/id"}},
          "literature_relation": {"enum": ["apparently_open", "partly_anticipated", "known_special_case", "absorbed", "contradicted", "independent", "cross_field_bridge", "coverage_unknown"]},
          "source_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
          "required_revision": {"$ref": "#/$defs/text"},
          "routing_effect": {"enum": ["continue", "sharpen", "hybridize", "targeted_reading", "demote", "retire", "incubate"]},
          "rebased_snapshot_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "opportunity_frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["neglected_conceptual_corners", "cross_field_connections", "unresolved_source_tensions", "newly_available_mechanisms"],
      "properties": {
        "neglected_conceptual_corners": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "cross_field_connections": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "unresolved_source_tensions": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "newly_available_mechanisms": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      }
    },
    "ledger_events": {"type": "array", "items": {"type": "object", "required": ["event_id", "event_type", "source_mapping_ids", "affected_object_ids", "payload"]}},
    "stale_branch_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "explicit_unknowns": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "next_theory_actions": {"type": "array", "items": {"type": "object", "required": ["action_id", "action", "source_mapping_ids", "target_object_ids"]}},
    "semantic_claim_layer_digest": {"$ref": "#/$defs/digest"},
    "semantic_coverage_audit": {"type": "object", "required": ["claim_record_count", "explicit_warrant_claim_count", "lexical_fallback_claim_count", "unresolved_claim_ids", "coverage_status"]},
    "derivation_replay": {"type": "object", "additionalProperties": false,
      "required": ["source_snapshot", "theory_catalog", "mapping_derivation", "hypothesis_inputs", "prior_snapshot", "candidate_snapshot_ids", "content_digest"],
      "properties": {
        "source_snapshot": {"type": "object", "required": ["schema_version", "snapshot_id", "content_digest"]}, "theory_catalog": {"type": "object", "required": ["schema_version", "catalog_id", "content_digest"]},
        "mapping_derivation": {"type": "object", "required": ["schema_version", "derivation_id", "semantic_claim_layer", "content_digest"]}, "hypothesis_inputs": {"type": "array", "items": {"type": "object"}},
        "prior_snapshot": {"type": ["object", "null"]}, "candidate_snapshot_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "freshness_max_age_seconds": {"type": "integer", "minimum": 1, "maximum": 2592000},
        "freshness_evaluated_at": {"type": "string", "format": "date-time"},
        "content_digest": {"$ref": "#/$defs/digest"}
      }},
    "content_digest": {"$ref": "#/$defs/digest"}
  }
}
