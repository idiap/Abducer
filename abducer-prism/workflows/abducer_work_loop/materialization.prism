agent derived_claim_reasoning_agent(
    task: ProofRouteHypothesis,
) -> Result[Generated[ProofRouteDerivedClaim], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ProofRouteHypothesis] = [derived_claim_reasoning_skill_1]

# RefutationalProofRouteClaimAssessment performs the reviewed refute boundary.
# Granularity: The source exposes RefutationalClaimTest as a separately consumed typed result in the abducer_work_loop occurrence graph.
# Linked source skill: skills/evaluation/counterexample-hunter/SKILL.md (sha256:413eb19c3dcdc59f53bac734b6a9864e1252095063f1cbb3674dcab3445c748d).
agent refutation_assessment_reasoning_agent(
