{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/history/discovery_proof_receipt_v1.schema.json",
  "title": "Historical decode-only discovery proof receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "handoff_id", "handoff_digest", "target_id", "run_id", "branch_id", "state_version", "concept_id", "hypothesis_id", "conjecture_id", "obligation_id", "attempt_id", "attempt_number", "proof_adapter", "status", "substantive_cycle_consumed", "started_at", "completed_at", "result", "certificate", "resource_usage", "ledger_events", "reflective_assimilation", "receipt_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "minLength": 1},
    "handoff_id": {"type": "string", "minLength": 1},
    "handoff_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": "string", "minLength": 1},
    "state_version": {"type": "integer", "minimum": 0},
    "concept_id": {"type": "string", "minLength": 1},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "conjecture_id": {"type": "string", "minLength": 1},
    "obligation_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "attempt_number": {"type": "integer", "minimum": 1},
    "proof_adapter": {"enum": ["exact", "finite_model", "lean", "command"]},
    "status": {"enum": ["success", "failure", "counterexample", "resource_limited", "unknown"]},
    "substantive_cycle_consumed": {"type": "boolean"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "result": {"type": "object"},
    "certificate": {"type": ["object", "null"]},
    "resource_usage": {"type": "object"},
    "ledger_events": {"type": "array", "items": {"type": "object"}},
    "reflective_assimilation": {"type": "object", "required": ["theory_programme_id", "recommendation", "authority_boundary"]},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
