{
  "version": 1,
  "purpose": "Schema-backed minimum contract for Abducer repo-local skills reviewed through mathematician and epistemologist roles.",
  "severity_levels": [
    "critical",
    "medium",
    "low"
  ],
  "thematic_folders": [
    "control-plane",
    "discovery",
    "evaluation",
    "ingest",
    "orchestration",
    "proof_delivery",
    "reasoning",
    "reporting",
    "results_ellaboration",
    "review",
    "yang_mills"
  ],
  "mandatory_for_all": {
    "required_sections": [
      "Output Contract",
      "Epistemic Discipline"
    ],
    "required_signals": [
      "output_contract",
      "epistemic_status",
      "evidence_citation",
      "validation_handoff"
    ]
  },
  "signal_definitions": {
    "guardrails": {
      "category": "epistemologist",
      "severity": "critical",
      "patterns": [
        "guardrails",
        "do not",
        "forbidden",
        "overclaim",
        "anti-overclaim"
      ]
    },
    "output_contract": {
      "category": "epistemologist",
      "severity": "critical",
      "patterns": [
        "output contract",
        "required output",
        "return:",
        "emit:"
      ]
    },
    "mathematical_object": {
      "category": "mathematician",
      "severity": "critical",
      "patterns": [
        "mathematical object",
        "mathematical objects",
        "objects compared",
        "definitions",
        "carrier"
      ]
    },
    "mathematical_invariant": {
      "category": "mathematician",
      "severity": "critical",
      "patterns": [
        "mathematical invariants",
        "preserved invariants",
        "broken invariants",
        "invariant"
      ]
    },
    "edge_case_or_counterexample": {
      "category": "mathematician",
      "severity": "medium",
      "patterns": [
        "edge case",
        "counterexample",
        "boundary regime",
        "failure regime"
      ]
    },
    "epistemic_status": {
      "category": "epistemologist",
      "severity": "critical",
      "patterns": [
        "epistemic status",
        "conjectural",
        "proof-obligation",
        "refuted",
        "promoted",
        "blocked"
      ]
    },
    "evidence_citation": {
      "category": "epistemologist",
      "severity": "critical",
      "patterns": [
        "evidence",
        "artifact paths",
        "kb ids",
        "source artifacts",
        "explicit unknowns"
      ]
    },
    "disconfirmation_or_demotion": {
      "category": "epistemologist",
      "severity": "critical",
      "patterns": [
        "disconfirming",
        "demotion",
        "falsify",
        "quarantine",
        "rejected"
      ]
    },
    "codex_exec_protocol": {
      "category": "epistemologist",
      "severity": "critical",
      "patterns": [
        "codex exec protocol",
        "deterministic run",
        "executed commands",
        "artifact inspection",
        "docs/reference/codex-exec-skill-protocol.md"
      ]
    },
    "validation_handoff": {
      "category": "epistemologist",
      "severity": "critical",
      "patterns": [
        "validation handoff",
        "validator",
        "validation",
        "next action",
        "unresolved obligations"
      ]
    }
  },
  "role_family_requirements": {
    "control-plane": {
      "role": "governance and lifecycle control",
      "required_sections": [
        "Guardrails",
