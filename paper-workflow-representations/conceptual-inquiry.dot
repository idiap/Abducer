digraph inquiry {
  graph [rankdir=TB, bgcolor="transparent", nodesep=0.32, ranksep=0.36, pad=0.15];
  node [shape=box, style="rounded,filled", fillcolor="#eef4f8", color="#35566b", fontname="Helvetica", fontsize=14, margin="0.16,0.10"];
  edge [color="#35566b", fontname="Helvetica", fontsize=12, arrowsize=0.7];
  situation [label="Conceptual situation\nCommitments and protected successes"];
  tension [label="Tension and diagnosis\nWhat creates the difficulty?"];
  ordinary [label="Ordinary work\nConcepts are adequate", fillcolor="#f4f4f4"];
  rivals [label="Rival transformations\nObjects, identities and relations"];
  reflection [label="Reflection and comparison\nObjections and preserved differences"];
  diagnostic [label="Diagnostic alternatives\nNo preference; revise or incubate", fillcolor="#f4f4f4"];
  programme [label="Research programmes\nConsequences and new obligations"];
  support [label="Specific support task\nProof, countermodel or observation", fillcolor="#f4f4f4"];
  situation -> tension;
  tension -> ordinary [label="ordinary task"];
  tension -> rivals [label="conceptual change"];
  rivals -> reflection;
  reflection -> rivals [style=dashed, label="revise"];
  reflection -> programme [label="justified programme\nor plural set"];
  reflection -> diagnostic [label="no preference\nor revise all"];
  diagnostic -> rivals [style=dashed, label="incubate, revise"];
  reflection -> situation [style=dashed, label="reframe"];
  programme -> support [label="named question"];
  support -> tension [style=dashed, label="new constraint"];
}
