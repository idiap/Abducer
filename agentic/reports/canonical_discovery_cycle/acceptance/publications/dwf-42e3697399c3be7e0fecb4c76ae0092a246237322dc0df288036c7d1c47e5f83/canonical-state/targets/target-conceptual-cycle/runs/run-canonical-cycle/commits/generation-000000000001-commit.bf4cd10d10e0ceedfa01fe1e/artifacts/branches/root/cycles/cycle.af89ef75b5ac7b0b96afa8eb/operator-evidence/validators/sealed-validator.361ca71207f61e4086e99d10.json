{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/discovery_evaluation_receipt.schema.json",
  "title": "Independent plural-virtue discovery evaluation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "proposal_receipt_ids",
    "proposal_invocation_id",
    "proposer_identity",
    "evaluator_identity",
    "evaluator_invocation_id",
    "evaluator_version",
    "deterministic_validator",
    "blind_input_digest",
    "candidate_digest",
    "structural_novelty",
    "relevance_floor",
    "theory_quality",
    "pareto_vector",
    "risk_reward",
    "literature_novelty",
    "established_claim_gates",
    "creative_worth_decision",
    "promotion_decision",
    "proof_status",
    "evidence_status",
    "created_at",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "proposal_receipt_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "proposal_invocation_id": {"type": "string", "minLength": 1},
    "proposer_identity": {"type": "string", "minLength": 1},
    "evaluator_identity": {"type": "string", "minLength": 1},
    "evaluator_invocation_id": {"type": "string", "minLength": 1},
    "evaluator_version": {"type": "string", "minLength": 1},
    "deterministic_validator": {"type": "boolean"},
    "blind_input_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "structural_novelty": {
      "type": "object",
      "required": ["classification", "new_elements", "matched_genealogy_ids", "basis"],
      "properties": {
        "classification": {"enum": ["structurally_new", "extension", "duplicate", "undetermined"]},
        "new_elements": {"type": "array", "items": {"type": "string"}},
        "matched_genealogy_ids": {"type": "array", "items": {"type": "string"}},
        "basis": {"type": "array", "items": {"type": "string"}}
      }
    },
    "relevance_floor": {"type": "object", "required": ["passed", "target_dependencies", "root_tensions", "reason"]},
    "theory_quality": {"type": "object", "required": ["conceptual_depth", "explanatory_understanding", "unification", "preserved_difference", "generativity", "coherence", "truth_aptness"]},
    "pareto_vector": {"type": "object", "required": ["conceptual_depth", "explanatory_understanding", "unification", "preserved_difference", "generativity", "coherence", "truth_aptness"]},
    "risk_reward": {"type": "object", "required": ["truth_confidence", "value_if_right", "learning_value_if_false", "mechanism_path", "correction_conditions", "portfolio_status"]},
    "literature_novelty": {"type": "object", "required": ["claim_allowed", "snapshot_status", "target_match", "source_relation_assessments", "reason"]},
    "established_claim_gates": {"type": "array", "items": {"type": "object", "required": ["gate_id", "applicability", "status", "reason"]}},
    "creative_worth_decision": {"enum": ["prefer", "incubate", "revise", "demote", "duplicate"]},
    "promotion_decision": {"enum": ["eligible", "blocked", "not_requested"]},
    "proof_status": {"enum": ["open", "proved", "refuted", "not_applicable"]},
    "evidence_status": {"enum": ["open", "supported", "contradicted", "not_applicable"]},
    "created_at": {"type": "string", "format": "date-time"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
