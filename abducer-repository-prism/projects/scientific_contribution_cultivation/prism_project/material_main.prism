# Host-executed material graph for the complete reviewed reasoning path.
# Generated values retain the source epistemic boundary and are not native proof or experiment receipts.

from types import (
    ContributionReadinessAssessment,
    ContributionSupportAssessment,
    ContributionValueAssessment,
    EnablementAudit,
    MainProblemAlignmentAudit,
    ResultAtlasSlice,
    ScientificContributionDisposition,
    ScientificContributionHypothesis,
)
from occurrences import (
    ContributionReadinessInput,
)

from generated.material_types import (
    MaterialContributionReadinessAssessment,
)

from generated.a0_skill_1 import a0_skill_1
from generated.e0_skill_1 import e0_skill_1
from generated.r0_skill_1 import r0_skill_1

# Real model capability for source occurrence a0:AbductiveScientificContributionHypothesisFormation.
agent a0_material_agent(
    task: ResultAtlasSlice,
) -> Result[Generated[ScientificContributionHypothesis], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ResultAtlasSlice] = [a0_skill_1]

# Real model capability for source occurrence r0:RefutationalContributionSupportAssessment.
agent r0_material_agent(
    task: ScientificContributionHypothesis,
) -> Result[Generated[ContributionSupportAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ScientificContributionHypothesis] = [r0_skill_1]

# Real model capability for source occurrence e0:EvidentialContributionReadinessAssessment.
agent e0_material_agent(
    task: ContributionReadinessInput,
) -> Result[Generated[MaterialContributionReadinessAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ContributionReadinessInput] = [e0_skill_1]

workflow MaterializedScientificContributionCultivation(
    result: ResultAtlasSlice,
) -> Generated[MaterialContributionReadinessAssessment]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        # Abduction interprets the result as a candidate contribution, not a fact.
        [a0: a0_material_agent(result)]
        # Refutation tests whether the proposed contribution is actually supported.
        [r0: r0_material_agent(a0.value)]
        # Readiness joins hypothesis and support assessment and emits all three audits.
        [e0: e0_material_agent(ContributionReadinessInput(
            contribution_hypothesis = a0.value,
            support_assessment = r0.value,
        ))]

    return e0

# HANDOFF (non-executable): when e0 is paper-ready, construct the contract's
# PaperArgumentHandoff through paper_argument_to_draft and offer it to
# manuscript_result_elaboration. Transport does not inflate novelty, promote a
# support-only result, or add mechanism evidence or other epistemic warrant.
# ACCEPT (non-executable): paper_ready is a handoff condition, not a local
# terminal accept or publication decision.
# STOP (non-executable): a refuted r0 or stalled workflow stops. Step failures
# stop or quarantine as declared. Exit validation requires the value,
# main-problem alignment, and enablement audits represented in e0, while open
# obligations remain declared; an archived or quarantined result is not accept.


def main(
    result: ResultAtlasSlice,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[MaterialContributionReadinessAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve MaterializedScientificContributionCultivation(result)
