# Operating system metadata
.DS_Store

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
.venv-pmp/
venv/
env/

# Editor and temporary files
*~
*.swp
*.swo
*.tmp
*.temp
*.bak

# Local API key configuration. Keep examples tracked, never secrets.
config/api_keys.json
config/api_keys.env
config/*.local.json
config/*.local.env
config/secrets/

# Runtime process markers; keep JSON/JSONL logs for audit, not stale PIDs.
agentic/logs/discovery_marathon_jobs/*.pid

# LaTeX temporary build products
*.aux
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc
*.xdv

# Lean / Lake build products
.lake/
lake-packages/
AbducerFormal/Generated/

# Generated release archives and checksums. Keep source conversion trees tracked.
/*.zip
/*.zip.sha256
/artifacts/prism/

# Request-local execution receipts are reproducible validation outputs.
/.prism/*/evidence/

# Generated discovery-report snapshots and initialization bundles.
/agentic/reports/discovery_marathon/targets/*/exact-examples.json
/agentic/reports/discovery_marathon/targets/*/full_timeline.html
/agentic/reports/discovery_marathon/targets/*/initialization-evidence.zip
/agentic/reports/discovery_marathon/targets/*/latest.html
/agentic/reports/discovery_marathon/targets/*/latest.json
/agentic/reports/discovery_marathon/targets/*/latest.md

# Local disclosure preparation and workspace agent settings. Nested agent files
# in imported bundles and conversion fixtures are application/test inputs.
/.idiap-sd/
/DEPENDENCIES.md
/AGENTS.md
/AGENTS.md.license
/CLAUDE.md
/CLAUDE.md.license
/.claude/
/.claude-plugin/
/.codex/
/.agents/*
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json
/.opencode/
/GEMINI.md
/GEMINI.md.license
/.gemini/
/.cursor/
/.cursorrules
/.cursorrules.license
/.github/copilot-instructions.md
/.github/copilot-instructions.md.license
# Generated Prism agent onboarding tasks, retained locally.
/.vscode/tasks.json
/.vscode/tasks.json.license

# New runtime audit logs/surfaces are generated outputs. Historical tracked
# disclosure evidence remains in the index and in the attribution audit.
/artifacts/reasoning-logs/
/artifacts/reasoning-surfaces/

# Local planning and reasoning documents.
/to-do.md
/reasoning-as-typed-epistemic-composition.pdf
/reasoning-as-typed-epistemic-composition.tex
/all-reasoning-flows.md
