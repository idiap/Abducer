# Occurrence layer for evidence_to_proof_route_onramp.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.
# The occurrences retain the former ERFL roles: evidence/status calibration (E),
# abduction (A), deduction (D), and refutation/testing (R).

from workflows.evidence_to_proof_route_onramp.types import (
    ProofRouteReadinessAssessment,
    ProofRouteConsequenceAssessment,
    ProofObligationEntrypointHypothesis,
    ExpertRouteDossier,
    EntrypointFalsificationAssessment,
    ProofRouteEvidenceGround,
    HubBiasAudit,
    ProofRouteHypothesis,
    ProofRouteDerivedConsequence,
    ProofRouteDisposition,
    ProofRouteSourceBundle,
)

type ProofRouteReadinessInput:
    proof_entrypoint: ProofObligationEntrypointHypothesis
    falsification_assessment: EntrypointFalsificationAssessment

type EvidentialProofRouteGrounding = ProofRouteSourceBundle -> Generated[ProofRouteEvidenceGround]

type AbductiveProofRouteHypothesisFormation = ProofRouteEvidenceGround -> Generated[ProofRouteHypothesis]

type DeductiveProofRouteConsequenceDerivation = ProofRouteHypothesis -> Generated[ProofRouteDerivedConsequence]

type EvidentialProofRouteConsequenceAssessment = ProofRouteDerivedConsequence -> Generated[ProofRouteConsequenceAssessment]

type AbductiveProofObligationEntrypointRevision = ProofRouteConsequenceAssessment -> Generated[ProofObligationEntrypointHypothesis]

type RefutationalProofEntrypointAssessment = ProofObligationEntrypointHypothesis -> Generated[EntrypointFalsificationAssessment]

type EvidentialProofRouteReadinessAssessment = ProofRouteReadinessInput -> Generated[ProofRouteReadinessAssessment]
