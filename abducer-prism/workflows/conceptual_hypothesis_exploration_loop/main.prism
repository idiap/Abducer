# Fixture-backed typed smoke entrypoint for conceptual_hypothesis_exploration_loop.
# Routing comments and linked validators remain outside this executable boundary.
from workflows.conceptual_hypothesis_exploration_loop.materialization import converted_reasoning
from workflows.conceptual_hypothesis_exploration_loop.reasoning import ConceptualHypothesisExplorationLoop
from workflows.conceptual_hypothesis_exploration_loop.types import ConceptualFailureState, ConceptualRefinementRoutingAssessment

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[ConceptualRefinementRoutingAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    failure_state = ConceptualFailureState(
        obstruction = "fixture:conceptual_hypothesis_exploration_loop:failure_state.obstruction",
    )
    flow = converted_reasoning(failure_state)
    return solve ConceptualHypothesisExplorationLoop(failure_state) using flow
