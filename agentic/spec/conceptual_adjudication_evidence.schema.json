    "typedUnificationAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "unification_kind",
        "source_case_ids",
        "covered_source_case_ids",
        "mapping_ids",
        "difference_ids",
        "node_ids",
        "edge_ids",
        "relation_kinds",
        "unification_digest",
        "before_graph_digest",
        "after_graph_digest",
        "graph_closed",
        "valid"
      ],
      "properties": {
        "system_id": {"$ref": "#/$defs/identifier"},
        "unification_kind": {
          "enum": [
            "common_cause",
            "bridge_law",
            "regime_indexed_mediation",
            "categorical_transport",
            "limit_or_descent",
            "conflict_preserving_duality",
            "explanatory_compression"
          ]
        },
        "source_case_ids": {
          "type": "array",
          "minItems": 2,
