# Domain layer for cohere_fast_adaptive_frontier.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type DomainScopeGrounding:
    domain_id: String
    target_ref: String
    claim_ceiling: String

type BoundedDomainFrontier:
    domain_id: String
    frontier_ref: String
    claim_ceiling: String

type FrontierReadinessDisposition:
    | Accepted
    | Quarantined
