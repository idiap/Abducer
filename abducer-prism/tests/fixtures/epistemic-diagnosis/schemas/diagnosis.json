{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident diagnosis",
  "type": "object",
  "required": ["operator_reports", "telemetry", "ranked_hypotheses"],
  "properties": {
    "operator_reports": {"type": "array", "items": {"type": "string"}},
    "telemetry": {"type": "array", "items": {"type": "object"}},
    "ranked_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis", "score", "supporting_observation_ids"],
        "properties": {
          "hypothesis": {"type": "string"},
          "score": {"type": "number"},
          "supporting_observation_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
