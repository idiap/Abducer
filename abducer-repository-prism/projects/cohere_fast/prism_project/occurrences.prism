# Occurrence layer for cohere_fast.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.

from types import (
    CohereDomainTarget,
    CohereIntakeDisposition,
    CohereScopeActivation,
)

type UnresolvedCohereScopeProjection = CohereDomainTarget -> Generated[CohereScopeActivation]

type EvidentialCohereIntakeDispositionAssessment = CohereScopeActivation -> Generated[CohereIntakeDisposition]
