# Domain layer for deep_review_and_reorientation.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type ReviewEvidenceBundle:
    review_evidence_summary: String

type FormalizedReviewState:
    formalized_state: String

type ReviewDefeaterAssessment:
    bounded_findings: String

type ReorientationRepairOptions:
    proposed_repairs: String

type ReorientationDisposition:
    | RepairWorkflowAssigned
    | ConceptualReorientationRequired
    | Stalled

type ReorientationDecisionAssessment:
    disposition: ReorientationDisposition
    reorientation_decision: String
