{
  "version": 1,
  "purpose": "Secret-safe local API key configuration for provider-backed Abducer runs.",
  "required_fields": [
    "version",
    "active_provider",
    "providers"
  ],
  "provider_required_fields": [
    "env"
  ],
  "supported_env_keys": [
    "OPENAI_API_KEY",
    "OPENAI_ORG_ID",
    "OPENAI_PROJECT_ID",
    "OPENAI_BASE_URL",
    "OPENAI_MODEL",
    "OPENAI_REASONING_EFFORT",
    "OPENAI_MAX_OUTPUT_TOKENS",
    "OPENAI_API_TIMEOUT_SECONDS",
    "AZURE_OPENAI_API_KEY",
    "AZURE_OPENAI_ENDPOINT",
    "AZURE_OPENAI_RESPONSES_ENDPOINT",
    "AZURE_OPENAI_MODEL",
    "AZURE_OPENAI_REASONING_EFFORT",
    "AZURE_OPENAI_MAX_OUTPUT_TOKENS",
    "AZURE_OPENAI_API_TIMEOUT_SECONDS",
    "ANTHROPIC_API_KEY",
    "GOOGLE_API_KEY"
  ],
  "secret_policy": [
    "Secret-bearing files live under config/ and are ignored by git.",
    "Examples may contain placeholders only.",
    "Validators and logs must redact values."
  ]
}
