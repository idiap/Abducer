# Domain layer for cohere_fast_independent_audit.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type ConditionalDerivationPacket:
    domain_id: String
    derivation_ref: String
    open_obligations_ref: String
    claim_ceiling: String

type IndependentRefutationAssessment:
    | Refuted
    | NotRefutedWithinScope
    | Inconclusive

type IndependentAuditDisposition:
    | Accepted
    | Quarantined
