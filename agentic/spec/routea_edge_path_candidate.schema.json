{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteAEdgePathCandidate",
  "type": "object",
  "required": ["candidate_id", "positive_time_min", "channels"],
  "properties": {
    "candidate_id": {"type": "string"},
    "expect_valid": {"type": "boolean"},
    "positive_time_min": {"type": "number"},
    "reflection": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "axis": {"type": "integer"},
        "offset": {"type": "number"}
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "edges"],
        "properties": {
          "name": {"type": "string"},
          "reflection_partner": {"type": "string"},
          "invariant_under_reflection": {"type": "boolean"},
          "edges": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "number"}
              }
            }
          },
          "limit_edges": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2
            }
          },
          "footprint_vertices": {"type": "array"}
        }
      }
    },
    "collapse_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channels", "must_share_limit"],
        "properties": {
          "channels": {"type": "array", "items": {"type": "string"}},
          "must_share_limit": {"type": "boolean"}
        }
      }
    }
  }
}
