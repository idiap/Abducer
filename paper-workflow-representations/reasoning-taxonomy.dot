digraph taxonomy {
 graph [rankdir=LR,bgcolor="white",nodesep=.25,ranksep=.35];
 node [shape=box,style="rounded,filled",fillcolor="#eef3f8",fontname="Helvetica",fontsize=12];
 edge [style=dashed,arrowhead=none];
 expand [label="Candidate expansion"];
 expose [label="Consequence / behavior"];
 discriminate [label="Discrimination"];
 calibrate [label="Calibration"];
 a [label="A  Abduction: propose an explanation"];
 i [label="I  Induction: infer a regularity"];
 t [label="T  Transfer: map a structure"];
 d [label="D  Deduction: derive a consequence"];
 m [label="M  Modeling: expose behavior"];
 c [label="C  Contrast: distinguish alternatives"];
 r [label="R  Refutation: seek a defeater"];
 e [label="E  Calibration: assign supported status"];
 expand -> {a i t}; expose -> {d m}; discriminate -> {c r}; calibrate -> e;
}
