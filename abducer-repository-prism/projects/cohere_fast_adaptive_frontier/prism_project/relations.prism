# Relation layer for cohere_fast_adaptive_frontier.
# Owns edge/certificate contracts only; builders belong to future materialization.

type FrontierAssessmentDependency[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation DomainFrontierEnablesReadinessAssessment[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> FrontierAssessmentDependency[SourceValue, TargetValue]
