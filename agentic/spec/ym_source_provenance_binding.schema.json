{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/ym_source_provenance_binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "source_manifest_path", "source_manifest_sha256", "source_archive_path", "source_archive_sha256", "source_archive_size_bytes", "frontier_capture_path", "frontier_capture_sha256", "frontier_capture_id", "coverage_cutoff", "freshness_at_execution", "search_completed_at", "consume_before", "committed_at", "license_status", "authorship_status", "authority_boundary", "content_digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "target_id": {"const": "yang-mills-existence-and-mass-gap-target"},
    "source_manifest_path": {"type": "string", "minLength": 1},
    "source_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_archive_path": {"type": "string", "minLength": 1},
    "source_archive_sha256": {"const": "sha256:d34b5daca880bed58e2fa908d7dbaa137c55b9f1980b89dcdc26498528e7492f"},
    "source_archive_size_bytes": {"const": 55272541},
    "frontier_capture_path": {"type": "string", "minLength": 1},
    "frontier_capture_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "frontier_capture_id": {"type": "string", "minLength": 1},
    "coverage_cutoff": {"type": "string", "format": "date-time"},
    "freshness_at_execution": {"const": "active_current"},
    "search_completed_at": {"type": "string", "format": "date-time"},
    "consume_before": {"type": "string", "format": "date-time"},
    "committed_at": {"type": "string", "format": "date-time"},
    "license_status": {"const": "unknown"},
    "authorship_status": {"const": "unknown"},
    "authority_boundary": {"type": "string", "minLength": 1},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
