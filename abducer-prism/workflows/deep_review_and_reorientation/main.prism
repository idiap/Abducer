# Fixture-backed typed smoke entrypoint for deep_review_and_reorientation.
# Routing comments and linked validators remain outside this executable boundary.
from workflows.deep_review_and_reorientation.materialization import converted_reasoning
from workflows.deep_review_and_reorientation.reasoning import DeepReviewAndReorientation
from workflows.deep_review_and_reorientation.types import ReorientationDecisionAssessment, ReviewEvidenceBundle

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[ReorientationDecisionAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    evidence = ReviewEvidenceBundle(
        review_evidence_summary = "fixture:deep_review_and_reorientation:evidence.review_evidence_summary",
    )
    flow = converted_reasoning(evidence)
    return solve DeepReviewAndReorientation(evidence) using flow
