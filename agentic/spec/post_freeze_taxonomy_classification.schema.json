{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/schemas/post_freeze_taxonomy_classification.schema.json",
  "title": "Post-freeze conceptual taxonomy classification",
  "description": "Maps exact frozen inventions to a known corner or records why the known taxonomy must be extended.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "classification_id", "freeze_id",
    "freeze_digest", "known_taxonomy_commitment_digest", "known_corner_ids",
    "classifier_authority_digest", "phase_order", "decisions", "authority_nulls",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "post_freeze_taxonomy_classification"},
    "classification_id": {"$ref": "#/$defs/id"},
    "freeze_id": {"$ref": "#/$defs/id"},
    "freeze_digest": {"$ref": "#/$defs/digest"},
    "known_taxonomy_commitment_digest": {"$ref": "#/$defs/digest"},
    "known_corner_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "classifier_authority_digest": {"$ref": "#/$defs/digest"},
    "phase_order": {
      "type": "array",
      "prefixItems": [{"const": "pre_taxonomy_frozen"}, {"const": "post_freeze_classified"}],
      "items": false
    },
    "decisions": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/decision"}},
    "authority_nulls": {
      "type": "object", "additionalProperties": false,
      "required": ["classification_truth_authority", "taxonomy_exhaustiveness_authority", "creativity_authority"],
      "properties": {
        "classification_truth_authority": {"const": "unavailable"},
        "taxonomy_exhaustiveness_authority": {"const": "unavailable"},
        "creativity_authority": {"const": "unavailable"}
      }
    },
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "extension": {
      "type": "object", "additionalProperties": false,
      "required": ["proposed_corner_id", "proposed_name", "insufficiency_of_known_taxonomy", "distinguishing_relations", "admission_test", "failure_condition"],
      "properties": {
        "proposed_corner_id": {"$ref": "#/$defs/id"},
        "proposed_name": {"$ref": "#/$defs/text"},
        "insufficiency_of_known_taxonomy": {"$ref": "#/$defs/text"},
        "distinguishing_relations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "admission_test": {"$ref": "#/$defs/text"},
        "failure_condition": {"$ref": "#/$defs/text"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["invention_id", "status", "known_corner_id", "extension_warrant"],
      "properties": {
        "invention_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["mapped_known_corner", "taxonomy_extension_warranted"]},
        "known_corner_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "extension_warrant": {"oneOf": [{"$ref": "#/$defs/extension"}, {"type": "null"}]}
      }
    }
  }
}
