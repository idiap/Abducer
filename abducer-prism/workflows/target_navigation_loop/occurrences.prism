# Occurrence layer for target_navigation_loop.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.

from workflows.target_navigation_loop.types import (
    TargetDependencyFrontier,
    UnscopedResearchTarget,
    TargetNavigationDisposition,
)

type UnresolvedTargetDependencyProjection = UnscopedResearchTarget -> Generated[TargetDependencyFrontier]

type EvidentialTargetNavigationDispositionAssessment = TargetDependencyFrontier -> Generated[TargetNavigationDisposition]
