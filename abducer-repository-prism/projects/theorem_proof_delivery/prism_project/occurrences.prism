# Occurrence layer for theorem_proof_delivery.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.
# The occurrences retain the former ERFL roles: deduction (D),
# refutation/testing (R), and evidence/status calibration (E).

from types import (
    TheoremProofDispositionAssessment,
    ExactTheoremClaim,
    ExplicitPremises,
    FormalProofObligations,
    TheoremProofDisposition,
    ProofFailureCertificate,
    FormalProofGateDecision,
    ProofQueueItem,
    ExactClaimRefutationAssessment,
)

type TheoremProofDispositionInput:
    theorem_claim: ExactTheoremClaim
    refutation_assessment: ExactClaimRefutationAssessment

type DeductiveExactTheoremClaimDerivation = ExplicitPremises -> Generated[ExactTheoremClaim]

type RefutationalExactTheoremClaimAssessment = ExactTheoremClaim -> Generated[ExactClaimRefutationAssessment]

type EvidentialTheoremProofDispositionAssessment = TheoremProofDispositionInput -> Generated[TheoremProofDispositionAssessment]
