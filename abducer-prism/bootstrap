set -eu
TO_PRISM_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
PYTHON_BIN=${PYTHON_BIN:-python3}

if [ ! -f "$TO_PRISM_ROOT/dependency.lock" ] || [ ! -d "$TO_PRISM_ROOT/vendor/wheels" ]; then
  echo "bundled dependency.lock or vendor/wheels is missing" >&2
  exit 4
fi

"$PYTHON_BIN" - "$TO_PRISM_ROOT" <<'PY'
import hashlib
import json
import platform
import sys
from pathlib import Path

root = Path(sys.argv[1])
manifest = json.loads((root / "vendor" / "manifest.json").read_text())
expected_python = f"{sys.version_info.major}.{sys.version_info.minor}"
expected_platform = f"{sys.platform}-{platform.machine()}"
if manifest.get("python") != expected_python:
    raise SystemExit(
        f"bundled toolchain requires Python {manifest.get('python')}; "
        f"current interpreter is {expected_python}"
    )
if manifest.get("platform") != expected_platform:
    raise SystemExit(
        f"bundled toolchain targets {manifest.get('platform')}; "
        f"current platform is {expected_platform}"
    )
for artifact in manifest.get("artifacts", []):
    wheel = root / "vendor" / "wheels" / artifact["filename"]
    if not wheel.is_file():
        raise SystemExit(f"bundled wheel is missing: {wheel.name}")
    digest = hashlib.sha256(wheel.read_bytes()).hexdigest()
    if digest != artifact["sha256"]:
        raise SystemExit(f"bundled wheel hash mismatch: {wheel.name}")
PY

"$PYTHON_BIN" -m venv "$TO_PRISM_ROOT/.venv"
"$TO_PRISM_ROOT/.venv/bin/python" -m pip install \
  --no-index \
  --require-hashes \
  --find-links "$TO_PRISM_ROOT/vendor/wheels" \
  -r "$TO_PRISM_ROOT/dependency.lock"

"$TO_PRISM_ROOT/to-prism" doctor --require-prism
