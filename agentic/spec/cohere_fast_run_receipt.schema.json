{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/cohere_fast_run_receipt.schema.json",
  "type": "object",
  "required": ["schema_version", "receipt_type", "receipt_id", "run_id", "workflow_id", "domain_id", "subworkflow_id", "parent_run_id", "step_id", "attempt", "state", "input_digest", "artifact_digests"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "receipt_type": {"enum": ["run", "step", "validation"]},
    "receipt_id": {"type": "string", "pattern": "^cfr-[a-f0-9]{32}$"}, "run_id": {"type": "string"},
    "workflow_id": {"const": "cohere_fast"}, "domain_id": {"type": "string"}, "subworkflow_id": {"type": ["string", "null"]},
    "parent_run_id": {"type": ["string", "null"]}, "step_id": {"type": ["string", "null"]},
    "attempt": {"type": "integer", "minimum": 1}, "state": {"enum": ["created", "running", "accepted", "failed", "quarantined", "stopped"]},
    "input_digest": {"type": "string"}, "artifact_digests": {"type": "object", "additionalProperties": {"type": "string"}}
  }, "additionalProperties": false
}
