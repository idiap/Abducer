# Relation layer for cohere_fast.
# Owns edge/certificate contracts only; builders belong to future materialization.

type CohereIntakeDependency[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation ScopeActivationEnablesCohereIntake[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> CohereIntakeDependency[SourceValue, TargetValue]
