{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/dynamic_experiment_receipt_v3.schema.json",
  "title": "Closed portable dynamic experiment execution receipt v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "receipt_id", "receipt_content_digest", "spec_id", "execution_id", "experiment_id", "branch_id", "target_id", "run_id", "state_version", "theory_programme_id", "source_theory_programme_digest", "source_reflection_packet_digest", "conceptual_system_ids", "theoretical_question_id", "adapter", "status", "epistemic_outcome", "result_variant", "spec_digest", "authority_digest", "code_digest", "environment_digest", "started_at", "completed_at", "resource_usage", "resource_authority_boundary", "resource_provenance_digest", "result", "certificate", "uncertainty_analysis", "completeness", "validator", "output_digest", "transfer_boundary", "theory_effect_contract_digest", "theory_effect", "reflective_assimilation", "failure"],
  "properties": {
    "schema_version": {"const": 3},
    "contract_version": {"const": "dynamic-experiment-runtime/3.1.0"},
    "receipt_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "receipt_content_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "spec_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "execution_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "experiment_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "branch_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "target_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "run_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "state_version": {"type": "integer", "minimum": 0},
    "theory_programme_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "source_theory_programme_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "source_reflection_packet_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "conceptual_system_ids": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/stringArray"},
    "theoretical_question_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "adapter": {"enum": ["exact", "sympy", "finite_model", "numeric", "sweep", "lean", "hybrid"]},
    "status": {"enum": ["succeeded", "counterexample", "capability_unavailable", "deadline_exhausted", "resource_exhausted", "solver_failure", "invalid_spec", "operational_failure"]},
    "epistemic_outcome": {"enum": ["supports_within_scope", "falsifies_claim", "maps_boundary", "inconclusive", "not_evaluated"]},
    "result_variant": {"enum": ["exact_rational_support", "exact_rational_counterexample", "exact_integer_support", "exact_integer_counterexample", "sympy_support", "sympy_counterexample", "finite_model_support", "finite_model_counterexample", "finite_model_inconclusive", "numeric_deterministic_support", "numeric_deterministic_counterexample", "sweep_deterministic_support", "sweep_deterministic_counterexample", "numeric_stochastic_support", "numeric_stochastic_counterexample", "sweep_stochastic_support", "sweep_stochastic_counterexample", "lean_support", "hybrid_support", "hybrid_counterexample", "operational_capability_unavailable", "operational_deadline_exhausted", "operational_resource_exhausted", "operational_solver_failure", "operational_invalid_spec", "operational_failure"]},
    "spec_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "authority_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "code_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "environment_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "resource_usage": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/resourceUsage"},
    "resource_authority_boundary": {"const": "validated_current_v2_local_process_protocol_and_recorded_aggregate_telemetry_with_no_epistemic_scientific_truth_experiment_value_or_physics_authority"},
    "resource_provenance_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "result": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/result"},
    "certificate": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/certificate"},
    "uncertainty_analysis": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/uncertainty"},
    "completeness": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/completeness"},
    "validator": {
      "type": "object", "additionalProperties": false,
      "required": ["validator_id", "version", "status", "checked_digest"],
      "properties": {"validator_id": {"const": "dynamic-experiment-independent-validator"}, "version": {"const": "3.1.0"}, "status": {"const": "valid"}, "checked_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"}}
    },
    "output_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "transfer_boundary": {"type": "string", "minLength": 1},
    "theory_effect_contract_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "theory_effect": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/theoryEffect"},
    "reflective_assimilation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/reflectiveRecommendation"}},
    "failure": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/failure"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]}, "then": {"properties": {"epistemic_outcome": {"enum": ["supports_within_scope", "maps_boundary"]}, "certificate": {"not": {"type": "null"}}, "failure": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "counterexample"}}, "required": ["status"]}, "then": {"properties": {"epistemic_outcome": {"const": "falsifies_claim"}, "certificate": {"not": {"type": "null"}}, "failure": {"type": "null"}}}},
    {"if": {"properties": {"status": {"enum": ["capability_unavailable", "deadline_exhausted", "solver_failure", "invalid_spec", "operational_failure"]}}, "required": ["status"]}, "then": {"properties": {"epistemic_outcome": {"const": "not_evaluated"}, "certificate": {"type": "null"}, "failure": {"not": {"type": "null"}}}}},
    {"if": {"properties": {"status": {"const": "resource_exhausted"}}, "required": ["status"]}, "then": {"properties": {"epistemic_outcome": {"enum": ["inconclusive", "not_evaluated"]}, "certificate": {"type": "null"}, "failure": {"not": {"type": "null"}}}}},
    {"if": {"properties": {"epistemic_outcome": {"const": "supports_within_scope"}}, "required": ["epistemic_outcome"]}, "then": {"properties": {"theory_effect": {"properties": {"effect_kind": {"enum": ["bounded_consistency_signal_only", "no_theory_effect_preregistered"]}}}}}},
    {"if": {"properties": {"epistemic_outcome": {"const": "falsifies_claim"}}, "required": ["epistemic_outcome"]}, "then": {"properties": {"theory_effect": {"properties": {"effect_kind": {"enum": ["registered_premise_revision_requested", "scoped_counterexample_only", "no_theory_effect_preregistered"]}}}}}},
    {"if": {"properties": {"epistemic_outcome": {"const": "maps_boundary"}}, "required": ["epistemic_outcome"]}, "then": {"properties": {"theory_effect": {"properties": {"effect_kind": {"const": "scoped_boundary_map_only"}}}}}},
    {"if": {"properties": {"epistemic_outcome": {"const": "inconclusive"}}, "required": ["epistemic_outcome"]}, "then": {"properties": {"theory_effect": {"properties": {"effect_kind": {"const": "no_theory_effect_inconclusive"}}}}}},
    {"if": {"properties": {"epistemic_outcome": {"const": "not_evaluated"}}, "required": ["epistemic_outcome"]}, "then": {"properties": {"theory_effect": {"properties": {"effect_kind": {"const": "no_theory_effect_operational"}}}}}},
    {"if": {"properties": {"theory_effect": {"properties": {"effect_kind": {"const": "registered_premise_revision_requested"}}, "required": ["effect_kind"]}}, "required": ["theory_effect"]}, "then": {"properties": {"epistemic_outcome": {"const": "falsifies_claim"}, "theory_effect": {"properties": {"tested_claim_kind": {"const": "theory_premise"}, "premise_revision_status": {"const": "requires_reflective_review"}}}}}, "else": {"properties": {"theory_effect": {"properties": {"premise_revision_status": {"const": "not_authorized"}}}}}}
  ]
}
