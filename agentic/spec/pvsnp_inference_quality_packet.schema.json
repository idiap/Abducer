{
  "version": 1,
  "schema_id": "pvsnp_inference_quality_packet",
  "description": "Schema contract for P vs NP inference-quality packets produced before branch promotion, proof-queue insertion, report claims, or paper-facing conclusions.",
  "required_fields": [
    "packet_id",
    "target_id",
    "branch_id",
    "inference_id",
    "source_statement",
    "target_statement",
    "inference_rule",
    "model_context",
    "quantifier_context",
    "parameter_map",
    "side_conditions",
    "barrier_status",
    "derivation_status",
    "correctness_criteria",
    "failure_modes",
    "reviewer_findings",
    "decision",
    "validation_handoff"
  ],
  "allowed_target_id": "p-vs-np-target",
  "allowed_inference_rules": [
    "transfer_inequality",
    "reduction",
    "contradiction",
    "impossibility_theorem",
    "barrier_diagnosis",
    "proof_complexity_transfer",
    "meta_complexity_carrier",
    "paper_contribution_claim",
    "heuristic_pressure"
  ],
  "allowed_reduction_types": [
    "many_one",
    "turing",
    "oracle",
    "projection",
    "padding",
    "black_box_substitution",
    "nonblackbox_compilation",
    "proof_system_simulation",
    "carrier_decoding",
    "none",
    "unknown"
  ],
  "allowed_uniformity": [
    "uniform_algorithm",
    "nonuniform_circuit_family",
    "p_poly_advice",
    "advice_free_uniform",
    "oracle_algorithm",
    "unknown"
  ],
  "allowed_advice_status": [
    "advice_free",
    "explicit_advice",
    "hidden_advice_risk",
    "advice_leak_detected",
    "unknown"
  ],
  "allowed_length_regimes": [
    "all_lengths",
    "all_sufficiently_large_lengths",
    "infinitely_often",
    "sparse_valid_lengths",
    "promise_domain",
    "finite_toy",
    "unknown"
  ],
  "allowed_exponent_regimes": [
    "all_constants",
    "fixed_constant",
    "bounded_window",
    "subpolynomial",
    "quasipolynomial",
    "unknown"
  ],
  "allowed_barrier_families": [
    "relativization",
    "algebrization",
    "natural_proofs",
    "black_box",
    "diagonalization",
    "proof_complexity",
    "none_identified",
    "unknown"
  ],
  "allowed_derivation_status": [
    "proved",
    "conditional_theorem",
    "proof_sketch",
    "derivation_needed",
    "blocked_at_named_lemma",
    "heuristic_only",
    "invalid"
  ],
  "allowed_decisions": [
    "accept_for_derivation",
    "needs_repair",
    "review_only",
    "quarantine",
    "reject_overclaim"
  ]
}
