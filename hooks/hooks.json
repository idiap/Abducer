{
  "version": 1,
  "policy": "Hooks are transparent deterministic checks only. Core target navigation and proof-search behavior lives in explicit skills and agentic scripts.",
  "hooks": [
    {
      "event": "UserPromptSubmit",
      "script": "hooks/scripts/user_prompt_submit_intake.py"
    },
    {
      "event": "PreSkillUse",
      "script": "hooks/scripts/pre_skill_use_policy.py"
    },
    {
      "event": "PostSkillUse",
      "script": "hooks/scripts/post_skill_use_review.py"
    },
    {
      "event": "PreToolUse",
      "script": "hooks/scripts/pre_tool_use_policy.py"
    },
    {
      "event": "Stop",
      "script": "hooks/scripts/stop_artifact_check.py"
    }
  ]
}
