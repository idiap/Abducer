def derived_claim_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ProofRouteClaimAssumption[SourceValue, TargetValue]:
    return ProofRouteClaimAssumption(source = source, target = target)

def refutation_assessment_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ProofRouteClaimTest[SourceValue, TargetValue]:
    return ProofRouteClaimTest(source = source, target = target)

def work_routing_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ProofWorkRoutingCalibration[SourceValue, TargetValue]:
    return ProofWorkRoutingCalibration(source = source, target = target)

# AbductiveProofRouteHypothesisFormation performs the reviewed abduct boundary.
# Granularity: The source exposes AbductiveProofRouteFormation as a separately consumed typed result in the abducer_work_loop occurrence graph.
# Linked source skill: skills/reasoning/kb-abduce/SKILL.md (sha256:3c0985794a9e14c75a8edc7a3ecccfa4ef28a51cd1b096985359d6cdab534a03).
agent route_hypothesis_reasoning_agent(
    task: ActiveProofGap,
) -> Result[Generated[ProofRouteHypothesis], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ActiveProofGap] = [route_hypothesis_reasoning_skill_1]

# DeductiveProofRouteClaimDerivation performs the reviewed derive boundary.
# Granularity: The source exposes DeductiveClaimDerivation as a separately consumed typed result in the abducer_work_loop occurrence graph.
