    "preferenceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "preferred_candidate_aliases",
        "preferred_system_ids",
        "nondominated_candidate_aliases",
        "nondominated_system_ids",
        "preference_set_digest"
      ],
      "properties": {
        "decision": {
          "enum": ["prefer_unique", "retain_plural_nondominated", "revise_all"]
        },
        "preferred_candidate_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "preferred_system_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "nondominated_candidate_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "nondominated_system_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "preference_set_digest": {"$ref": "#/$defs/digest"}
      }
    }
