{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/discovery_proof_prelaunch_capability_v3.schema.json",
  "title": "Inert projection of one live unclaimed proof prelaunch capability v3",
  "description": "Offline evidence binding an exact proof-attempt reservation before the durable execution-claim CAS. This JSON is never execution authority and intentionally contains no claim digest or claim commit reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_kind",
    "capability_id",
    "content_digest",
    "projection_phase",
    "target_id",
    "run_id",
    "cycle_id",
    "branch_id",
    "source_commit_generation",
    "source_commit_id",
    "source_manifest_digest",
    "source_state_file_digest",
    "source_state_semantic_digest",
    "theory_authorization_digest",
    "theory_authorization_basis_digest",
    "literature_authority_basis_digest",
    "schedule_id",
    "schedule_digest",
    "action_id",
    "action_digest",
    "handoff_id",
    "handoff_digest",
    "formal_claim_authority_id",
    "formal_claim_authority_digest",
    "producer_receipt_id",
    "producer_receipt_digest",
    "hypothesis_id",
    "conceptual_system_ids",
    "conjecture_id",
    "obligation_id",
    "proof_adapter",
    "execution_plan_digest",
    "attempt_number",
    "attempt_id",
    "reservation_id",
    "reservation_digest",
    "execution_claim_id",
    "reservation_commit_reference",
    "reservation_commit_reference_digest",
    "source_theory_head_digest",
    "proof_runtime_ref",
    "resource_budget_digest",
    "literature_consume_before",
    "durable_claim_present_in_projection",
    "projection_only",
    "authoritative_for_execution",
    "live_capability_required",
    "one_shot",
    "serialized_reconstruction_allowed",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "capability_kind": {"const": "one_shot_unclaimed_postcommit_proof_prelaunch"},
    "capability_id": {"$ref": "#/$defs/identifier"},
    "content_digest": {"$ref": "#/$defs/digest"},
    "projection_phase": {"const": "before_durable_execution_claim"},
    "target_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "cycle_id": {"$ref": "#/$defs/identifier"},
    "branch_id": {"$ref": "#/$defs/identifier"},
    "source_commit_generation": {"type": "integer", "minimum": 1},
    "source_commit_id": {"$ref": "#/$defs/identifier"},
    "source_manifest_digest": {"$ref": "#/$defs/digest"},
    "source_state_file_digest": {"$ref": "#/$defs/digest"},
    "source_state_semantic_digest": {"$ref": "#/$defs/digest"},
    "theory_authorization_digest": {"$ref": "#/$defs/digest"},
    "theory_authorization_basis_digest": {"$ref": "#/$defs/digest"},
    "literature_authority_basis_digest": {"$ref": "#/$defs/digest"},
    "schedule_id": {"$ref": "#/$defs/identifier"},
    "schedule_digest": {"$ref": "#/$defs/digest"},
    "action_id": {"$ref": "#/$defs/identifier"},
    "action_digest": {"$ref": "#/$defs/digest"},
    "handoff_id": {"$ref": "#/$defs/identifier"},
    "handoff_digest": {"$ref": "#/$defs/digest"},
    "formal_claim_authority_id": {"$ref": "#/$defs/identifier"},
    "formal_claim_authority_digest": {"$ref": "#/$defs/digest"},
    "producer_receipt_id": {"$ref": "#/$defs/identifier"},
    "producer_receipt_digest": {"$ref": "#/$defs/digest"},
    "hypothesis_id": {"$ref": "#/$defs/identifier"},
    "conceptual_system_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "conjecture_id": {"$ref": "#/$defs/identifier"},
    "obligation_id": {"$ref": "#/$defs/identifier"},
    "proof_adapter": {"enum": ["exact", "finite_model", "lean", "command"]},
    "execution_plan_digest": {"$ref": "#/$defs/digest"},
    "attempt_number": {"type": "integer", "minimum": 1},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "reservation_id": {"$ref": "#/$defs/identifier"},
    "reservation_digest": {"$ref": "#/$defs/digest"},
    "execution_claim_id": {"$ref": "#/$defs/identifier"},
    "reservation_commit_reference": {"$ref": "#/$defs/ledgerCommitReference"},
    "reservation_commit_reference_digest": {"$ref": "#/$defs/digest"},
    "source_theory_head_digest": {"$ref": "#/$defs/digest"},
    "proof_runtime_ref": {"$ref": "#/$defs/safePath"},
    "resource_budget_digest": {"$ref": "#/$defs/digest"},
    "literature_consume_before": {"type": "string", "format": "date-time"},
    "durable_claim_present_in_projection": {"const": false},
    "projection_only": {"const": true},
    "authoritative_for_execution": {"const": false},
    "live_capability_required": {"const": true},
    "one_shot": {"const": true},
    "serialized_reconstruction_allowed": {"const": false},
    "authority_boundary": {
      "const": "one_shot_live_unclaimed_postcommit_proof_prelaunch_capability_with_durable_claim_cas_only_at_consumption_and_inert_serialized_projection_no_rehydration_retry_truth_theory_selection_or_physics_authority"
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)latest(?:/|$)).+$"
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "ledgerCommitReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reference_kind",
        "ledger_kind",
        "target_id",
        "run_id",
        "generation",
        "prior_generation",
        "commit_id",
        "manifest_digest",
        "state_file_digest",
        "state_semantic_digest",
        "record_artifact",
        "reference_digest"
      ],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "reference_kind": {"const": "portable_coordination_ledger_commit"},
        "ledger_kind": {"const": "independent_action_coordination_ledger"},
        "target_id": {"$ref": "#/$defs/identifier"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "generation": {"type": "integer", "minimum": 1},
        "prior_generation": {"type": "integer", "minimum": 0},
        "commit_id": {"$ref": "#/$defs/identifier"},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "state_file_digest": {"$ref": "#/$defs/digest"},
        "state_semantic_digest": {"$ref": "#/$defs/digest"},
        "record_artifact": {"$ref": "#/$defs/artifactReference"},
        "reference_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
