digraph interfaces {
 graph [rankdir=TB,bgcolor="white",nodesep=.3,ranksep=.28];
 node [shape=box,fontname="Helvetica",fontsize=12,style="rounded,filled",fillcolor="#eef3f8"];
 edge [fontname="Helvetica",fontsize=10];
 g [label="Gap G"];
 a [label="A : G -> Generated[H]"];
 d [label="D : H -> Generated[C]"];
 r [label="R : C -> Generated[V]"];
 j [label="Routing input J\n{derived_claim: C, refutation_assessment: V}"];
 e [label="E : J -> Generated[S]"];
 g -> a; a -> d [label="successful .value : H"];
 d -> r [label="successful .value : C"];
 d -> j [label="retain the same C",color="#245a81"];
 r -> j [label="successful .value : V"];
 j -> e;
}
