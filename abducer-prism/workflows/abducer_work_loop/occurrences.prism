# Occurrence layer for abducer_work_loop.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.

from workflows.abducer_work_loop.types import (
    ActiveProofGap,
    ProofRouteHypothesis,
    ProofRouteRefutationAssessment,
    ProofRouteDerivedClaim,
    ProofWorkDisposition,
    ProofWorkRoutingAssessment,
)

type ProofWorkRoutingInput:
    derived_claim: ProofRouteDerivedClaim
    refutation_assessment: ProofRouteRefutationAssessment

type AbductiveProofRouteHypothesisFormation = ActiveProofGap -> Generated[ProofRouteHypothesis]

type DeductiveProofRouteClaimDerivation = ProofRouteHypothesis -> Generated[ProofRouteDerivedClaim]

type RefutationalProofRouteClaimAssessment = ProofRouteDerivedClaim -> Generated[ProofRouteRefutationAssessment]

type EvidentialProofWorkRoutingAssessment = ProofWorkRoutingInput -> Generated[ProofWorkRoutingAssessment]
