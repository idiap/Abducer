# Domain layer for conceptual_frontier_deepening.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type FrozenConceptualContext:
    frozen_context: String

type BoundedConceptualFrontier:
    bounded_frontier: String

type DiscriminatingConceptualHypothesis:
    conceptual_hypothesis: String

type ConceptualHypothesisRefutationAssessment:
    scoped_refutation: String

type ConceptualHypothesisSelection:
    selection_basis: String

type RevisedConceptualBridge:
    correspondence: String

type BridgeDerivedFormalClaim:
    formal_claim: String

type FormalizationDisposition:
    | FormalReady
    | NotFormalReadyOrNonDominated
    | Refuted

type FormalizationReadinessAssessment:
    disposition: FormalizationDisposition
    readiness_basis: String
