{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/discovery_formal_claim_producer_input_v2.schema.json",
  "title": "Registered formal-claim producer input v2",
  "description": "A request to compile one exact formalization seed from a previously sealed conceptual producer output. The claim body is not accepted as a direct input field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_kind",
    "target_id",
    "run_id",
    "source_prior_state_version",
    "source_theory_generation",
    "branch_id",
    "hypothesis_id",
    "concept_id",
    "conceptual_system_ids",
    "conjecture_id",
    "source_producer_request",
    "source_producer_receipt",
    "finalized_reflection",
    "finalized_reflection_digest",
    "conceptual_authority",
    "conceptual_authority_digest",
    "source_semantic_kind",
    "source_semantic_row_id",
    "source_theory_programme_id",
    "source_theory_programme_digest",
    "literature_authority",
    "theory_ancestry",
    "producer_generation_mode",
    "no_same_cycle_experiment_ancestry",
    "authority_nulls"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "input_kind": {"const": "registered_formal_claim_compilation"},
    "target_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "source_prior_state_version": {"type": "integer", "minimum": 0},
    "source_theory_generation": {"type": "integer", "minimum": 1},
    "branch_id": {"$ref": "#/$defs/identifier"},
    "hypothesis_id": {"$ref": "#/$defs/identifier"},
    "concept_id": {"$ref": "#/$defs/identifier"},
    "conceptual_system_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "conjecture_id": {"$ref": "#/$defs/identifier"},
    "source_producer_request": {
      "$ref": "./discovery_operator_request.schema.json"
    },
    "source_producer_receipt": {
      "$ref": "./discovery_operator_receipt.schema.json"
    },
    "finalized_reflection": {
      "$ref": "./reflective_conceptual_discovery_packet.schema.json"
    },
    "finalized_reflection_digest": {"$ref": "#/$defs/digest"},
    "conceptual_authority": {
      "$ref": "./canonical_discovery_cycle.schema.json#/$defs/conceptualAuthority"
    },
    "conceptual_authority_digest": {"$ref": "#/$defs/digest"},
    "source_semantic_kind": {"const": "formalization_seed"},
    "source_semantic_row_id": {"$ref": "#/$defs/identifier"},
    "source_theory_programme_id": {"$ref": "#/$defs/identifier"},
    "source_theory_programme_digest": {"$ref": "#/$defs/digest"},
    "literature_authority": {
      "$ref": "./discovery_proof_handoff.schema.json#/$defs/literatureAuthority"
    },
    "theory_ancestry": {
      "$ref": "#/$defs/precommitTheoryAncestry"
    },
    "producer_generation_mode": {
      "const": "registered_deterministic_compiler"
    },
    "no_same_cycle_experiment_ancestry": {"const": true},
    "authority_nulls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_truth",
        "checker_soundness",
        "theorem_status",
        "theory_selection",
        "same_cycle_theory_mutation",
        "independent_semantic_authorship",
        "physics_value"
      ],
      "properties": {
        "claim_truth": {"const": false},
        "checker_soundness": {"const": false},
        "theorem_status": {"const": false},
        "theory_selection": {"const": false},
        "same_cycle_theory_mutation": {"const": false},
        "independent_semantic_authorship": {"const": false},
        "physics_value": {"const": false}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1},
    "precommitTheoryAncestry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conceptual_authority_digest",
        "parent_adjudication_evidence_digest",
        "synthesis_adjudication_evidence_digest",
        "preferred_system_ids"
      ],
      "properties": {
        "conceptual_authority_digest": {"$ref": "#/$defs/digest"},
        "parent_adjudication_evidence_digest": {"$ref": "#/$defs/digest"},
        "synthesis_adjudication_evidence_digest": {"$ref": "#/$defs/digest"},
        "preferred_system_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    }
  }
}
