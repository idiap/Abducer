# Occurrence layer for release_promotion_loop.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.

from workflows.release_promotion_loop.types import (
    ClaimBoundedReleaseProposal,
    ReleasePromotionDisposition,
    PromotionEvidencePacket,
)

type UnresolvedReleaseProposalProjection = PromotionEvidencePacket -> Generated[ClaimBoundedReleaseProposal]

type EvidentialReleasePromotionDispositionAssessment = ClaimBoundedReleaseProposal -> Generated[ReleasePromotionDisposition]
