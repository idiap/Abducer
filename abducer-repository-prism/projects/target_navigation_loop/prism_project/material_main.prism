# Host-executed material graph for the complete reviewed reasoning path.
# Generated values retain the source epistemic boundary and are not native proof or experiment receipts.

from types import (
    TargetDependencyFrontier,
    TargetNavigationDisposition,
    UnscopedResearchTarget,
)

from generated.dependency_frontier_skill_1 import dependency_frontier_skill_1
from generated.target_disposition_skill_1 import target_disposition_skill_1

# Real model capability for source occurrence dependency_frontier:UnresolvedTargetDependencyProjection.
agent dependency_frontier_material_agent(
    task: UnscopedResearchTarget,
) -> Result[Generated[TargetDependencyFrontier], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[UnscopedResearchTarget] = [dependency_frontier_skill_1]

# Real model capability for source occurrence target_disposition:EvidentialTargetNavigationDispositionAssessment.
agent target_disposition_material_agent(
    task: TargetDependencyFrontier,
) -> Result[Generated[String], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[TargetDependencyFrontier] = [target_disposition_skill_1]

workflow MaterializedTargetNavigationLoop(
    unscoped_target: UnscopedResearchTarget,
) -> Generated[String]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        # The unresolved projection maps dependencies but adds no warrant to the target.
        [dependency_frontier: dependency_frontier_material_agent(unscoped_target)]
        # Disposition assessment turns the mapped frontier into the next workflow route.
        [target_disposition: target_disposition_material_agent(dependency_frontier.value)]

    return target_disposition


def main(
    unscoped_target: UnscopedResearchTarget,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[String], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve MaterializedTargetNavigationLoop(unscoped_target)
