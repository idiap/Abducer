{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/formal_conditioned_concept_sequence_v1.schema.json",
  "title": "Intermediate-conditioned one-order conceptual sequence v1",
  "description": "Exact replay of one ordered pair whose second plan is valid only on the first plan's validated after-core. No reverse order is fabricated without a separately authored reverse-intermediate plan. The artifact grants no truth, merit, physics, theorem, proof, or experiment-selection authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence_kind",
    "sequence_id",
    "base_core",
    "first_step",
    "second_step",
    "order",
    "conditioned_path",
    "finite_handback",
    "authority_boundary",
    "content_digest"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "core": {
      "$ref": "formal_conceptual_delta_v2.schema.json#/$defs/core"
    },
    "delta": {"$ref": "formal_conceptual_delta_v2.schema.json"},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transformation_id",
        "relation_hypothesis",
        "witness",
        "consequence_contract"
      ],
      "properties": {
        "transformation_id": {"$ref": "#/$defs/id"},
        "relation_hypothesis": {
          "$ref": "formal_conceptual_delta_v2.schema.json#/$defs/relationHypothesis"
        },
        "witness": {
          "$ref": "formal_conceptual_delta_v2.schema.json#/$defs/witness"
        },
        "consequence_contract": {
          "$ref": "formal_conceptual_delta_v2.schema.json#/$defs/consequenceContract"
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "input_core_digest",
        "delta_id",
        "delta_digest",
        "before_core_digest",
        "after_core_digest",
        "exact_input_boundary",
        "semantic_delta_replayed",
        "after_core_validated",
        "replay_digest"
      ],
      "properties": {
        "status": {"const": "valid"},
        "input_core_digest": {"$ref": "#/$defs/digest"},
        "delta_id": {"$ref": "#/$defs/id"},
        "delta_digest": {"$ref": "#/$defs/digest"},
        "before_core_digest": {"$ref": "#/$defs/digest"},
        "after_core_digest": {"$ref": "#/$defs/digest"},
        "exact_input_boundary": {"const": true},
        "semantic_delta_replayed": {"const": true},
        "after_core_validated": {"const": true},
        "replay_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "step_ordinal",
        "plan",
        "plan_authored_from_core_digest",
        "delta",
        "replay",
        "step_digest"
      ],
      "properties": {
        "step_id": {"$ref": "#/$defs/id"},
        "step_ordinal": {"enum": [1, 2]},
        "plan": {"$ref": "#/$defs/plan"},
        "plan_authored_from_core_digest": {"$ref": "#/$defs/digest"},
        "delta": {"$ref": "#/$defs/delta"},
        "replay": {"$ref": "#/$defs/replay"},
        "step_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "witnessDifferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delta_ids",
        "witness_digests",
        "burden_statements",
        "corrections",
        "falsifiers",
        "loss_ledger_digests",
        "difference_digest"
      ],
      "properties": {
        "delta_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/id"}
        },
        "witness_digests": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/digest"}
        },
        "burden_statements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "corrections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "falsifiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "loss_ledger_digests": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/digest"}
        },
        "difference_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "conditionedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditioned_path_id",
        "status",
        "order",
        "base_core_digest",
        "intermediate_core_digest",
        "final_core_digest",
        "exact_first_boundary",
        "exact_intermediate_boundary",
        "protected_distinctions_preserved",
        "free_completion_detected",
        "reverse_order_status",
        "witness_differences",
        "quarantine_reasons",
        "path_digest"
      ],
      "properties": {
        "conditioned_path_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["completed", "quarantined"]},
        "order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/id"}
        },
        "base_core_digest": {"$ref": "#/$defs/digest"},
        "intermediate_core_digest": {"$ref": "#/$defs/digest"},
        "final_core_digest": {"$ref": "#/$defs/digest"},
        "exact_first_boundary": {"const": true},
        "exact_intermediate_boundary": {"const": true},
        "protected_distinctions_preserved": {"type": "boolean"},
        "free_completion_detected": {"type": "boolean"},
        "reverse_order_status": {
          "const": "not_constructed_without_reverse_conditioned_authorship"
        },
        "witness_differences": {"$ref": "#/$defs/witnessDifferences"},
        "quarantine_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "path_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "handback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handback_status",
        "candidate_core_digest",
        "relation_witness_digests",
        "burden_statements",
        "corrections",
        "falsifiers",
        "eligible_for_precommitted_rule_replay",
        "decision_change_authorized",
        "truth_authority",
        "conceptual_merit_authority",
        "physics_authority",
        "theorem_authority",
        "physical_equivalence_authorized",
        "continuum_authorized",
        "proof_authorized",
        "investment_authorized",
        "experiment_selection_authorized",
        "handback_digest"
      ],
      "properties": {
        "handback_status": {
          "enum": ["conditioned_candidate", "conditioned_path_quarantined"]
        },
        "candidate_core_digest": {"$ref": "#/$defs/digest"},
        "relation_witness_digests": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/digest"}
        },
        "burden_statements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/text"}
        },
        "corrections": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/text"}
        },
        "falsifiers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/text"}
        },
        "eligible_for_precommitted_rule_replay": {"type": "boolean"},
        "decision_change_authorized": {"const": false},
        "truth_authority": {"type": "null"},
        "conceptual_merit_authority": {"type": "null"},
        "physics_authority": {"type": "null"},
        "theorem_authority": {"type": "null"},
        "physical_equivalence_authorized": {"const": false},
        "continuum_authorized": {"const": false},
        "proof_authorized": {"const": false},
        "investment_authorized": {"const": false},
        "experiment_selection_authorized": {"const": false},
        "handback_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finite_local_replay_only",
        "truth_authority",
        "conceptual_merit_authority",
        "physics_authority",
        "theorem_authority",
        "physical_equivalence_authorized",
        "continuum_authorized",
        "proof_authorized",
        "investment_authorized",
        "experiment_selection_authorized"
      ],
      "properties": {
        "finite_local_replay_only": {"const": true},
        "truth_authority": {"type": "null"},
        "conceptual_merit_authority": {"type": "null"},
        "physics_authority": {"type": "null"},
        "theorem_authority": {"type": "null"},
        "physical_equivalence_authorized": {"const": false},
        "continuum_authorized": {"const": false},
        "proof_authorized": {"const": false},
        "investment_authorized": {"const": false},
        "experiment_selection_authorized": {"const": false}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "sequence_kind": {"const": "intermediate_conditioned_one_order"},
    "sequence_id": {"$ref": "#/$defs/id"},
    "base_core": {"$ref": "#/$defs/core"},
    "first_step": {"$ref": "#/$defs/step"},
    "second_step": {"$ref": "#/$defs/step"},
    "order": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/id"}
    },
    "conditioned_path": {"$ref": "#/$defs/conditionedPath"},
    "finite_handback": {"$ref": "#/$defs/handback"},
    "authority_boundary": {"$ref": "#/$defs/authorityBoundary"},
    "content_digest": {"$ref": "#/$defs/digest"}
  }
}
