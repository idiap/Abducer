{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:abducer:framework-paper:functional-capability-model:1",
  "title": "FunctionalCapabilityModel", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "model_id", "input_digest", "capabilities", "limitations", "model_digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "model_id": {"type": "string", "minLength": 1}, "input_digest": {"$ref": "#/$defs/digest"},
    "capabilities": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["capability_id", "name", "purpose", "inputs", "outputs", "preconditions", "invariants", "components", "dependencies", "validators", "limitations", "evidence_ids"], "properties": {
      "capability_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1},
      "inputs": {"$ref": "#/$defs/strings"}, "outputs": {"$ref": "#/$defs/strings"}, "preconditions": {"$ref": "#/$defs/strings"}, "invariants": {"$ref": "#/$defs/strings"}, "components": {"$ref": "#/$defs/strings"}, "dependencies": {"$ref": "#/$defs/strings"}, "validators": {"$ref": "#/$defs/strings"}, "limitations": {"$ref": "#/$defs/strings"}, "evidence_ids": {"$ref": "#/$defs/nonemptyStrings"}
    }}},
    "limitations": {"$ref": "#/$defs/strings"}, "model_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "nonemptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}
}
