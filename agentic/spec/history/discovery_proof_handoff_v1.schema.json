{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/history/discovery_proof_handoff_v1.schema.json",
  "title": "Historical decode-only discovery proof handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "target_id", "run_id", "branch_id", "state_version", "concept_id", "hypothesis_id", "conjecture_id", "obligation_id", "statement", "statement_digest", "literature_snapshot_id", "literature_basis_status", "proof_adapter", "proof_payload", "origin_receipt_ids", "return_to_theory_programme_id", "resource_budget"],
  "properties": {
    "schema_version": {"const": 1},
    "handoff_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": "string", "minLength": 1},
    "state_version": {"type": "integer", "minimum": 0},
    "concept_id": {"type": "string", "minLength": 1},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "conjecture_id": {"type": "string", "minLength": 1},
    "obligation_id": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "statement_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "literature_snapshot_id": {"type": "string", "minLength": 1},
    "literature_basis_status": {"enum": ["current", "superseded", "missing"]},
    "proof_adapter": {"enum": ["exact", "finite_model", "lean", "command"]},
    "proof_payload": {"type": "object"},
    "origin_receipt_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "return_to_theory_programme_id": {"type": "string", "minLength": 1},
    "resource_budget": {"type": "object", "minProperties": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
