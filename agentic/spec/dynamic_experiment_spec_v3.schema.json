{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/dynamic_experiment_spec_v3.schema.json",
  "title": "Closed portable theory-requested dynamic experiment specification v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "spec_id", "execution_id", "precommitted_receipt_id", "experiment_id", "branch_id", "target_id", "run_id", "state_version", "theory_programme_id", "source_theory_programme_digest", "source_reflection_packet_digest", "conceptual_system_ids", "theoretical_question_id", "tested_theory_claim", "probe_role", "expected_conceptual_change", "triage_digest", "adapter", "model", "preregistration", "controls", "seed_policy", "resource_budget", "transfer_boundary", "theory_effect_contract", "code_version", "execution_authority", "authority_digest", "code_digest", "observed_environment", "environment_digest", "created_at", "spec_digest"],
  "properties": {
    "schema_version": {"const": 3},
    "contract_version": {"const": "dynamic-experiment-runtime/3.1.0"},
    "spec_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "execution_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "precommitted_receipt_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "experiment_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "branch_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "target_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "run_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "state_version": {"type": "integer", "minimum": 0},
    "theory_programme_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "source_theory_programme_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "source_reflection_packet_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "conceptual_system_ids": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/stringArray"},
    "theoretical_question_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "tested_theory_claim": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/testedTheoryClaim"},
    "probe_role": {"enum": ["discriminator", "falsifier", "mechanism_support", "boundary_mapper", "proof_support"]},
    "expected_conceptual_change": {"type": "string", "minLength": 1},
    "triage_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "adapter": {"enum": ["exact", "sympy", "finite_model", "numeric", "sweep", "lean", "hybrid"]},
    "model": {"type": "object"},
    "preregistration": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/preregistration"},
    "controls": {"type": "array", "minItems": 1, "items": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/control"}},
    "seed_policy": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/seedPolicy"},
    "resource_budget": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/resourceBudget"},
    "transfer_boundary": {"type": "string", "minLength": 1},
    "theory_effect_contract": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/theoryEffectContract"},
    "code_version": {"const": "dynamic-experiment-adapters/1.1.0"},
    "execution_authority": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/executionAuthority"},
    "authority_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "code_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "observed_environment": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/observedEnvironment"},
    "environment_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "created_at": {"type": "string", "format": "date-time"},
    "spec_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"}
  },
  "allOf": [
    {"if": {"properties": {"adapter": {"const": "exact"}}, "required": ["adapter"]}, "then": {"properties": {"model": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/exactModel"}}}},
    {"if": {"properties": {"adapter": {"const": "sympy"}}, "required": ["adapter"]}, "then": {"properties": {"model": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/sympyModel"}}}},
    {"if": {"properties": {"adapter": {"const": "finite_model"}}, "required": ["adapter"]}, "then": {"properties": {"model": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/finiteModel"}}}},
    {"if": {"properties": {"adapter": {"enum": ["numeric", "sweep"]}}, "required": ["adapter"]}, "then": {"properties": {"model": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/numericModel"}}}},
    {"if": {"properties": {"adapter": {"const": "lean"}}, "required": ["adapter"]}, "then": {"properties": {"model": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/leanModel"}}}},
    {"if": {"properties": {"adapter": {"const": "hybrid"}}, "required": ["adapter"]}, "then": {"properties": {"model": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/hybridModel"}}}},
    {"if": {"properties": {"seed_policy": {"properties": {"stochastic": {"const": true}}, "required": ["stochastic"]}}, "required": ["seed_policy"]}, "then": {"properties": {"preregistration": {"required": ["estimand", "sample_size", "uncertainty_method"]}}}}
  ]
}
