# Host-executed material graph for the complete reviewed reasoning path.
# Generated values retain the source epistemic boundary and are not native proof or experiment receipts.

from types import (
    FormalizedReviewState,
    ReorientationDecisionAssessment,
    ReorientationDisposition,
    ReorientationRepairOptions,
    ReviewDefeaterAssessment,
    ReviewEvidenceBundle,
)
from occurrences import (
    ReorientationDecisionInput,
)

from generated.material_types import (
    MaterialReorientationDecisionAssessment,
)

from generated.defeater_assessment_skill_1 import defeater_assessment_skill_1
from generated.reorientation_decision_skill_1 import reorientation_decision_skill_1
from generated.repair_options_skill_1 import repair_options_skill_1
from generated.review_state_skill_1 import review_state_skill_1

# Real model capability for source occurrence review_state:EvidentialReviewStateGrounding.
agent review_state_material_agent(
    task: ReviewEvidenceBundle,
) -> Result[Generated[FormalizedReviewState], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ReviewEvidenceBundle] = [review_state_skill_1]

# Real model capability for source occurrence defeater_assessment:RefutationalReviewDefeaterAssessment.
agent defeater_assessment_material_agent(
    task: FormalizedReviewState,
) -> Result[Generated[ReviewDefeaterAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[FormalizedReviewState] = [defeater_assessment_skill_1]

# Real model capability for source occurrence repair_options:AbductiveReorientationRepairFormation.
agent repair_options_material_agent(
    task: FormalizedReviewState,
) -> Result[Generated[ReorientationRepairOptions], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[FormalizedReviewState] = [repair_options_skill_1]

# Real model capability for source occurrence reorientation_decision:EvidentialReorientationDecisionAssessment.
agent reorientation_decision_material_agent(
    task: ReorientationDecisionInput,
) -> Result[Generated[MaterialReorientationDecisionAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ReorientationDecisionInput] = [reorientation_decision_skill_1]

workflow MaterializedDeepReviewAndReorientation(
    evidence: ReviewEvidenceBundle,
) -> Generated[MaterialReorientationDecisionAssessment]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        # One formalized state prevents the challenge and repair branches from
        # silently reviewing different evidence bases.
        [review_state: review_state_material_agent(evidence)]
        parallel:
            # These branches are complementary: one attacks, the other repairs.
            [defeater_assessment: defeater_assessment_material_agent(review_state.value)]
            [repair_options: repair_options_material_agent(review_state.value)]
        # The final calibration must consider both bounded findings and repair options.
        [reorientation_decision: reorientation_decision_material_agent(ReorientationDecisionInput(
            defeater_assessment = defeater_assessment.value,
            repair_options = repair_options.value,
        ))]

    return reorientation_decision


def main(
    evidence: ReviewEvidenceBundle,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[MaterialReorientationDecisionAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve MaterializedDeepReviewAndReorientation(evidence)
