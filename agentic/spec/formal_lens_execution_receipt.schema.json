{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/formal_lens_execution_receipt.schema.json",
  "title": "Theory-atlas-bound finite category/HoTT execution receipt",
  "description": "A closed receipt for replaying one finite formal lens validation. It binds exact atlas, executable, dependency, literature, evaluation, model, witness, and handback identities while denying theorem, continuum, value, investment, production-evidence, automatic-promotion, and cognitive-independence authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_version", "receipt_id", "validator_id", "execution_mode", "status",
    "authority_scope", "target_id", "packet_id", "packet_schema_version", "packet_digest",
    "lens", "model_digest", "witness_certificate_digest", "physics_handback_digest",
    "theory_atlas_packet_id", "theory_atlas_packet_digest",
    "theory_atlas_validation_receipt_id", "theory_atlas_validation_receipt_digest",
    "theory_atlas_crosswalk_digest", "theory_atlas_authority_class",
    "theory_atlas_automatic_promotion_authorized",
    "dependency_authority_version", "dependency_authority_digest",
    "validator_module_digest", "formal_reasoning_module_digest", "evaluation_runtime_module_digest",
    "evaluation_schema_version", "evaluation_id", "evaluation_digest",
    "literature_snapshot_id", "literature_snapshot_digest", "assimilation_packet_id",
    "assimilation_digest", "literature_projection_digest", "production_evidence_status",
    "authority_distinct_evaluation_status", "theorem_authorized", "continuum_authorized",
    "physics_value_authorized", "investment_authorized", "cognitive_independence_authorized",
    "content_digest"
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "properties": {
    "authority_version": {"const": "2.0.0"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "validator_id": {"enum": ["finite-categorical-forge-validator.v5", "finite-hott-forge-validator.v5"]},
    "execution_mode": {"const": "in_process_deterministic_validation"},
    "status": {"const": "passed"},
    "authority_scope": {"const": "sealed_finite_formal_lens_execution_only"},
    "target_id": {"$ref": "#/$defs/id"},
    "packet_id": {"$ref": "#/$defs/id"},
    "packet_schema_version": {"const": "5.0.0"},
    "packet_digest": {"$ref": "#/$defs/digest"},
    "lens": {"enum": ["categorical", "hott"]},
    "model_digest": {"$ref": "#/$defs/digest"},
    "witness_certificate_digest": {"$ref": "#/$defs/digest"},
    "physics_handback_digest": {"$ref": "#/$defs/digest"},
    "theory_atlas_packet_id": {"$ref": "#/$defs/id"},
    "theory_atlas_packet_digest": {"$ref": "#/$defs/digest"},
    "theory_atlas_validation_receipt_id": {"$ref": "#/$defs/id"},
    "theory_atlas_validation_receipt_digest": {"$ref": "#/$defs/digest"},
    "theory_atlas_crosswalk_digest": {"$ref": "#/$defs/digest"},
    "theory_atlas_authority_class": {"const": "finite_pre_forge_structural_pressure_only"},
    "theory_atlas_automatic_promotion_authorized": {"const": false},
    "dependency_authority_version": {"const": "2.0.0"},
    "dependency_authority_digest": {"$ref": "#/$defs/digest"},
    "validator_module_digest": {"$ref": "#/$defs/digest"},
    "formal_reasoning_module_digest": {"$ref": "#/$defs/digest"},
    "evaluation_runtime_module_digest": {"$ref": "#/$defs/digest"},
    "evaluation_schema_version": {"const": "4.0.0"},
    "evaluation_id": {"$ref": "#/$defs/id"},
    "evaluation_digest": {"$ref": "#/$defs/digest"},
    "literature_snapshot_id": {"$ref": "#/$defs/id"},
    "literature_snapshot_digest": {"$ref": "#/$defs/digest"},
    "assimilation_packet_id": {"$ref": "#/$defs/id"},
    "assimilation_digest": {"$ref": "#/$defs/digest"},
    "literature_projection_digest": {"$ref": "#/$defs/digest"},
    "production_evidence_status": {"const": "not_attested"},
    "authority_distinct_evaluation_status": {"const": "unavailable"},
    "theorem_authorized": {"const": false},
    "continuum_authorized": {"const": false},
    "physics_value_authorized": {"const": false},
    "investment_authorized": {"const": false},
    "cognitive_independence_authorized": {"const": false},
    "content_digest": {"$ref": "#/$defs/digest"}
  }
}
