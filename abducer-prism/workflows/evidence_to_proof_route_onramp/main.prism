# Fixture-backed typed smoke entrypoint for evidence_to_proof_route_onramp.
# Routing comments and linked validators remain outside this executable boundary.
from workflows.evidence_to_proof_route_onramp.materialization import converted_reasoning
from workflows.evidence_to_proof_route_onramp.reasoning import EvidenceToProofRouteOnramp
from workflows.evidence_to_proof_route_onramp.types import ProofRouteReadinessAssessment, ProofRouteSourceBundle

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[ProofRouteReadinessAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    source = ProofRouteSourceBundle(
        source_id = "fixture:evidence_to_proof_route_onramp:source.source_id",
    )
    flow = converted_reasoning(source)
    return solve EvidenceToProofRouteOnramp(source) using flow
