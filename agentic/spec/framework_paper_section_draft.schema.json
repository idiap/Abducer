{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:abducer:framework-paper:section-draft:1",
  "title": "PaperSectionDraft", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "section_id", "section_owner", "title", "input_digest", "consumed_claim_ids", "citations", "figure_ids", "table_ids", "notation_ids", "unresolved_todos", "warnings", "tex_fragment", "section_digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "section_id": {"type": "string", "minLength": 1}, "section_owner": {"type": "string", "pattern": "^framework-paper-[a-z0-9-]+$"}, "title": {"type": "string", "minLength": 1}, "input_digest": {"$ref": "#/$defs/digest", "description": "Frozen source snapshot digest copied from PaperBlueprint.input_digest; section_digest binds the local derivation."},
    "consumed_claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "citations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "figure_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "table_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "notation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "unresolved_todos": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}, "tex_fragment": {"type": "string"}, "section_digest": {"$ref": "#/$defs/digest"}
  }, "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
