    skills: Skills[ManuscriptExtensionHypothesis] = [r0_reasoning_skill_1]

# EvidentialManuscriptReadinessAssessment performs the reviewed calibrate boundary.
# Granularity: The source exposes CalibrateManuscript as a separately consumed typed result in the manuscript_result_elaboration occurrence graph.
# Linked source skill: skills/evaluation/epistemic-status-ledger/SKILL.md (sha256:980ad92b1f190316a941b8124eaffc6c414680666d2960ebcc8bd21444b4d454).
agent e1_reasoning_agent(
