# Occurrence layer for ym-representational-dynamics-overlay.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.

from workflows.ym_representational_dynamics_overlay.types import (
    ContinuumBoundaryAuditInput,
    YangMillsOverlayDisposition,
    YangMillsTargetContext,
)

type UnresolvedContinuumAuditInputProjection = YangMillsTargetContext -> Generated[ContinuumBoundaryAuditInput]

type EvidentialYangMillsOverlayDispositionAssessment = ContinuumBoundaryAuditInput -> Generated[YangMillsOverlayDisposition]
