{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/domain-skill-bundle.schema.json",
  "type": "object",
  "required": ["schema_version", "bundles"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "domain_id", "workflow_id", "root", "owner", "allowed_skills", "artifact_prefix", "claim_ceiling", "discovery"],
        "properties": {
          "id": {"pattern": "^[a-z][a-z0-9_]*$"},
          "domain_id": {"pattern": "^[a-z][a-z0-9_]*$"},
          "workflow_id": {"const": "cohere_fast"},
          "root": {"pattern": "^skills/domain_specific/[a-z0-9_]+$"},
          "owner": {"type": "string", "minLength": 1},
          "allowed_skills": {"type": "array", "uniqueItems": true, "items": {"pattern": "^[a-z0-9-]+$"}},
          "schemas": {"type": "array", "items": {"type": "string"}},
          "subworkflows": {"type": "array", "items": {"type": "string"}},
          "artifact_prefix": {"type": "string", "minLength": 1},
          "claim_ceiling": {"enum": ["exploratory", "candidate", "independently_supported"]},
          "discovery": {"const": "bundle-private-explicit-allowlist"},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
