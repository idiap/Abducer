# Relation layer for discovery_marathon_loop.
# Owns edge/certificate contracts only; builders belong to future materialization.

type DiscoveryFormationScope[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

type DiscoveryProbeBasis[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

type DiscoveryRefutationBasis[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

type DiscoveryRoutingCalibration[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation ScopesDiscoveryFormation[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> DiscoveryFormationScope[SourceValue, TargetValue]

relation GroundsDiscoveryProbe[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> DiscoveryProbeBasis[SourceValue, TargetValue]

relation GroundsDiscoveryRefutation[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> DiscoveryRefutationBasis[SourceValue, TargetValue]

relation CalibratesDiscoveryRouting[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> DiscoveryRoutingCalibration[SourceValue, TargetValue]
