{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "default_agent": "audit",
  "permission": {
    "edit": "deny",
    "bash": {"*": "ask", "git diff *": "allow"}
  },
  "mcp": {
    "catalog": {
      "type": "local",
      "command": ["python", "-m", "fixture_catalog"],
      "environment": {"CATALOG_TOKEN": "{env:CATALOG_TOKEN}"}
    }
  }
}
