converted_reasoning = ManuscriptResultElaboration(
    e0 = e0_reasoning_agent,
    a0 = a0_reasoning_agent,
    a0_by = a0_reasoning_relation_builder,
    r0 = r0_reasoning_agent,
    r0_by = r0_reasoning_relation_builder,
