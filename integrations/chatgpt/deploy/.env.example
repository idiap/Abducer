# Operator values; no credentials or working deployment are included.
ABDUCER_IMAGE_TAG=local
ABDUCER_PUBLIC_URL=https://abducer.example.org
ABDUCER_OIDC_ISSUER=https://identity.example.org/
ABDUCER_OIDC_JWKS_URL=https://identity.example.org/.well-known/jwks.json
ABDUCER_REQUIRED_SCOPE=abducer
ABDUCER_WORKER_ENABLED=false
ABDUCER_PORT=8000
# Configure separately before enabling the research profile.
ABDUCER_MODEL_PROVIDER=api
ABDUCER_NATIVE_HOOKS_ENABLED=false
# The hooked ChatGPT route requires both MODEL_PROVIDER=chatgpt and
# NATIVE_HOOKS_ENABLED=true, plus a signed bridge sharing the worker database.
# This Compose recipe exposes the standalone OAuth service, not that bridge.
# API credentials below are required only for MODEL_PROVIDER=api.
ABDUCER_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
