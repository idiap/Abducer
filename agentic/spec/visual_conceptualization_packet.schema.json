{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Abducer Visual Conceptualization Packet",
  "type": "object",
  "required": [
    "schema",
    "generated_utc",
    "generated_by_skills",
    "target_id",
    "run_id",
    "source_context",
    "summary",
    "visual_conceptualizations",
    "workflow_caps",
    "evidence_paths",
    "validation_handoff"
  ],
  "properties": {
    "schema": {
      "const": "abducer.visual_conceptualization_packet.v1"
    },
    "generated_utc": {
      "type": "string"
    },
    "generated_by_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "visual-theorem-conceptualizer"
      }
    },
    "target_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "source_context": {
      "type": "object",
      "required": [
        "cycle_ids",
        "trigger",
        "window_policy"
      ],
      "properties": {
        "cycle_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "cycle_indices": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "source_report": {
          "type": "string"
        },
        "trigger": {
          "const": "deep_reflection_visual_conceptualization"
        },
        "window_policy": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "concept_count",
        "hypothesis_output_count",
        "quarantined_or_rejected_count",
        "route_consequences",
        "core_diagnosis"
      ],
      "properties": {
        "concept_count": {
          "type": "integer",
          "minimum": 1
        },
        "hypothesis_output_count": {
          "type": "integer",
          "minimum": 1
        },
        "quarantined_or_rejected_count": {
          "type": "integer",
          "minimum": 0
        },
        "route_consequences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "core_diagnosis": {
          "type": "string"
        }
      }
    },
    "visual_conceptualizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "concept_id",
          "formal_focus",
          "main_concepts",
          "key_properties",
          "visual_metaphor",
          "property_preservation_table",
          "distortion_ledger",
          "hypothesis_inspiration",
          "non_claim_boundary",
          "audit",
          "status"
        ],
        "properties": {
          "concept_id": {
            "type": "string"
          },
          "formal_focus": {
            "type": "object"
          },
          "main_concepts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "key_properties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visual_metaphor": {
            "type": "object"
          },
          "property_preservation_table": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 6
          },
          "distortion_ledger": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hypothesis_inspiration": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 1
          },
          "non_claim_boundary": {
            "type": "string"
          },
          "audit": {
            "type": "object"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "workflow_caps": {
      "type": "object"
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_handoff": {
      "const": "agentic/scripts/validate_visual_conceptualization_packet.py"
    }
  }
}
