{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://abducer.local/spec/cohere_fast_hook_receipt.schema.json",
  "type": "object", "required": ["schema_version", "receipt_id", "decision", "workflow_id", "domain_id", "run_id", "subworkflow_id", "parent_run_id", "parent_event_id", "artifact_prefix", "reason"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "receipt_id": {"type": "string"}, "decision": {"enum": ["accept", "block"]},
    "workflow_id": {"const": "cohere_fast"}, "domain_id": {"type": "string"}, "run_id": {"type": "string"},
    "subworkflow_id": {"type": ["string", "null"]}, "parent_run_id": {"type": ["string", "null"]}, "parent_event_id": {"type": ["string", "null"]},
    "artifact_prefix": {"type": "string"}, "reason": {"type": "string"}
  }, "additionalProperties": false
}
