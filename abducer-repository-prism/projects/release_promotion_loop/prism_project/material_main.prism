# Host-executed material graph for the complete reviewed reasoning path.
# Generated values retain the source epistemic boundary and are not native proof or experiment receipts.

from types import (
    ClaimBoundedReleaseProposal,
    PromotionEvidencePacket,
    ReleasePromotionDisposition,
)

from generated.promotion_disposition_skill_1 import promotion_disposition_skill_1
from generated.release_proposal_skill_1 import release_proposal_skill_1

# Real model capability for source occurrence release_proposal:UnresolvedReleaseProposalProjection.
agent release_proposal_material_agent(
    task: PromotionEvidencePacket,
) -> Result[Generated[ClaimBoundedReleaseProposal], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[PromotionEvidencePacket] = [release_proposal_skill_1]

# Real model capability for source occurrence promotion_disposition:EvidentialReleasePromotionDispositionAssessment.
agent promotion_disposition_material_agent(
    task: ClaimBoundedReleaseProposal,
) -> Result[Generated[String], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ClaimBoundedReleaseProposal] = [promotion_disposition_skill_1]

workflow MaterializedReleasePromotionLoop(
    promotion_evidence: PromotionEvidencePacket,
) -> Generated[String]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        # Proposal formation is claim-conserving and adds no epistemic warrant.
        [release_proposal: release_proposal_material_agent(promotion_evidence)]
        # The gate evaluates the bounded proposal and emits the cross-workflow route.
        [promotion_disposition: promotion_disposition_material_agent(release_proposal.value)]

    return promotion_disposition


def main(
    promotion_evidence: PromotionEvidencePacket,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[String], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve MaterializedReleasePromotionLoop(promotion_evidence)
