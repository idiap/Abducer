# Domain layer for ym-representational-dynamics-overlay.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type YangMillsTargetContext:
    target_id: String
    continuum_boundary_ref: String

type ContinuumBoundaryAuditInput:
    target_id: String
    representation_candidate_ref: String
    continuum_boundary_ref: String

type YangMillsOverlayDisposition:
    | Accepted
    | Quarantined
    | Stalled
