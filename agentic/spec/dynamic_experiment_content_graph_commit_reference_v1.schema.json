{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/dynamic_experiment_content_graph_commit_reference_v1.schema.json",
  "title": "Portable verified dynamic-experiment content-graph commit reference",
  "description": "Identifies one exact content-object graph artifact inside one exact verified discovery commit. The reference carries no experiment-transition semantics: graph_artifact is always the commit's canonical dynamic-experiment content-object graph, and runtime replay must verify the complete commit identity, exact manifest descriptor, graph bytes, and graph-local ownership before resolving an imported object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference_kind",
    "programme_id",
    "target_id",
    "run_id",
    "generation",
    "prior_generation",
    "commit_id",
    "manifest_digest",
    "state_file_digest",
    "state_semantic_digest",
    "frozen_theory_state_projection_digest",
    "graph_artifact",
    "reference_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "reference_kind": {
      "const": "portable_verified_content_graph_commit"
    },
    "programme_id": {
      "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"
    },
    "target_id": {
      "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "prior_generation": {
      "type": "integer",
      "minimum": 0
    },
    "commit_id": {
      "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"
    },
    "manifest_digest": {
      "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"
    },
    "state_file_digest": {
      "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"
    },
    "state_semantic_digest": {
      "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"
    },
    "frozen_theory_state_projection_digest": {
      "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"
    },
    "graph_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "artifact_kind": {
          "const": "dynamic_experiment_content_object_graph"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "reference_digest": {
      "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"
    }
  }
}
