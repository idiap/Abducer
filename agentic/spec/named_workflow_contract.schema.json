{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/named_workflow_contract.schema.json",
  "title": "Abducer named workflow contract",
  "type": "object",
  "required": ["id", "version", "visible_name", "aliases", "activation", "owner_skill", "target_scope", "trigger", "input_artifact", "steps", "hooks", "exit_gate", "handoffs", "prohibitions", "cost_profile"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "visible_name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "activation": {"enum": ["default", "opt_in", "conditional"]},
    "owner_skill": {"type": "string", "minLength": 1},
    "target_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "trigger": {
      "type": "object",
      "required": ["all_of", "any_of", "none_of"],
      "properties": {
        "all_of": {"type": "array", "items": {"type": "string"}},
        "any_of": {"type": "array", "items": {"type": "string"}},
        "none_of": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "input_artifact": {"$ref": "named_workflow_artifacts.schema.json#/$defs/artifactReference"},
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "skill", "mode", "when", "consumes", "produces", "on_failure"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "order": {"type": "integer", "minimum": 1},
          "skill": {"type": "string", "minLength": 1},
          "mode": {"enum": ["required", "conditional", "advisory", "validator_only"]},
          "when": {"type": ["string", "null"]},
          "consumes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "produces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "on_failure": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "hooks": {
      "type": "array", "minItems": 5,
      "items": {
        "type": "object",
        "required": ["hook_id", "event", "phase", "condition", "required_inputs", "decision", "emitted_artifact"],
        "properties": {
          "hook_id": {"type": "string", "minLength": 1},
          "event": {"enum": ["UserPromptSubmit", "PreSkillUse", "PostSkillUse", "PreToolUse", "Stop"]},
          "phase": {"type": "string", "minLength": 1},
          "condition": {"type": "string", "minLength": 1},
          "required_inputs": {"type": "array", "items": {"type": "string"}},
          "decision": {"enum": ["recommend", "accept", "warn", "block"]},
          "emitted_artifact": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "exit_gate": {
      "type": "object", "required": ["validator", "consumes", "allowed", "required_artifacts", "open_obligations_policy"],
      "properties": {
        "validator": {"type": "string", "minLength": 1},
        "consumes": {"type": "string", "minLength": 1},
        "allowed": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "required_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "open_obligations_policy": {"enum": ["forbid", "allow_declared", "archive_only"]}
      }, "additionalProperties": false
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object", "required": ["when", "workflow", "artifact_type"],
        "properties": {"when": {"type": "string"}, "workflow": {"type": "string"}, "artifact_type": {"type": "string"}, "adapter": {"type": ["string", "null"]}},
        "additionalProperties": false
      }
    },
    "prohibitions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cost_profile": {"enum": ["lightweight", "bounded", "expensive"]},
    "profiles": {"type": "array", "items": {"type": "object"}},
    "domain_binding": {"type": ["string", "null"]},
    "parent_workflow": {"type": ["string", "null"]},
    "subworkflows": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "artifact_namespace": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
