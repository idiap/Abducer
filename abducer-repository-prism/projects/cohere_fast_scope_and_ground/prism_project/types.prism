# Domain layer for cohere_fast_scope_and_ground.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type DomainScopeGroundingRequest:
    domain_id: String
    target_ref: String
    sources_ref: String

type DomainScopeGrounding:
    domain_id: String
    target_ref: String
    sources_ref: String
    claim_ceiling: String

type ScopeGroundingDisposition:
    | Accepted
    | Blocked
