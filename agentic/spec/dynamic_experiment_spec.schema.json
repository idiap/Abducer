{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/dynamic_experiment_spec.schema.json",
  "title": "Theory-requested dynamic experiment specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "branch_id",
    "target_id",
    "run_id",
    "state_version",
    "theory_programme_id",
    "source_theory_programme_digest",
    "source_reflection_packet_digest",
    "conceptual_system_ids",
    "theoretical_question_id",
    "tested_theory_claim",
    "probe_role",
    "expected_conceptual_change",
    "triage_digest",
    "adapter",
    "model",
    "preregistration",
    "controls",
    "seed_policy",
    "resource_budget",
    "transfer_boundary",
    "theory_effect_contract",
    "code_version",
    "environment",
    "spec_digest"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "experiment_id": {"type": "string", "minLength": 1},
    "branch_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "state_version": {"type": "integer", "minimum": 0},
    "theory_programme_id": {"type": "string", "minLength": 1},
    "source_theory_programme_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_reflection_packet_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "conceptual_system_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "theoretical_question_id": {"type": "string", "minLength": 1},
    "tested_theory_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id", "claim_kind", "target_relation", "statement",
        "theory_programme_id", "conceptual_system_ids",
        "source_theory_programme_digest", "source_reflection_packet_digest",
        "claim_digest"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "claim_kind": {"enum": ["theory_premise", "model_consequence", "calibration", "boundary_condition"]},
        "target_relation": {"enum": ["exact_target_consequence", "necessary_not_sufficient", "toy_or_proxy", "calibration_only"]},
        "statement": {"type": "string", "minLength": 1},
        "theory_programme_id": {"type": "string", "minLength": 1},
        "conceptual_system_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_theory_programme_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_reflection_packet_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "claim_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "probe_role": {"enum": ["discriminator", "falsifier", "mechanism_support", "boundary_mapper", "proof_support"]},
    "expected_conceptual_change": {"type": "string", "minLength": 1},
    "triage_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "adapter": {"enum": ["exact", "sympy", "finite_model", "numeric", "sweep", "lean", "hybrid"]},
    "model": {"type": "object"},
    "preregistration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "decision_rule", "stopping_rule", "analysis_plan", "registered_at"],
      "properties": {
        "hypothesis": {"type": "string", "minLength": 1},
        "decision_rule": {"type": "object", "minProperties": 1},
        "stopping_rule": {"type": "string", "minLength": 1},
        "analysis_plan": {"type": "string", "minLength": 1},
        "registered_at": {"type": "string", "format": "date-time"},
        "estimand": {"type": "string"},
        "sample_size": {"type": "integer", "minimum": 1},
        "uncertainty_method": {"type": "string"}
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "variable", "value", "role"],
        "properties": {
          "control_id": {"type": "string", "minLength": 1},
          "variable": {"type": "string", "minLength": 1},
          "value": {},
          "role": {"enum": ["held_fixed", "negative", "positive", "baseline", "calibration"]}
        }
      }
    },
    "seed_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stochastic", "policy"],
      "properties": {
        "stochastic": {"type": "boolean"},
        "policy": {"enum": ["not_applicable", "fixed_master_seed", "enumerated_seeds"]},
        "master_seed": {"type": "integer"},
        "seeds": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true}
      }
    },
    "resource_budget": {"type": "object", "minProperties": 1},
    "transfer_boundary": {"type": "string", "minLength": 1},
    "theory_effect_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tested_claim_id", "tested_claim_kind", "target_relation", "if_supported", "if_falsified", "theory_identity_locked", "automatic_theory_selection", "automatic_proof"],
      "properties": {
        "tested_claim_id": {"type": "string", "minLength": 1},
        "tested_claim_kind": {"enum": ["theory_premise", "model_consequence", "calibration", "boundary_condition"]},
        "target_relation": {"enum": ["exact_target_consequence", "necessary_not_sufficient", "toy_or_proxy", "calibration_only"]},
        "if_supported": {"enum": ["record_scoped_consistency_only", "no_change"]},
        "if_falsified": {"enum": ["request_registered_premise_revision", "record_scoped_counterexample_only", "no_change"]},
        "theory_identity_locked": {"const": true},
        "automatic_theory_selection": {"const": false},
        "automatic_proof": {"const": false}
      }
    },
    "code_version": {"type": "string", "minLength": 1},
    "environment": {"type": "object", "minProperties": 1},
    "spec_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"seed_policy": {"properties": {"stochastic": {"const": true}}}}},
      "then": {
        "properties": {
          "preregistration": {
            "required": ["estimand", "sample_size", "uncertainty_method"],
            "properties": {
              "estimand": {"minLength": 1},
              "uncertainty_method": {"minLength": 1}
            }
          },
          "seed_policy": {
            "properties": {"policy": {"enum": ["fixed_master_seed", "enumerated_seeds"]}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "seed_policy": {
            "properties": {"stochastic": {"const": false}},
            "required": ["stochastic"]
          }
        },
        "required": ["seed_policy"]
      },
      "then": {
        "properties": {
          "seed_policy": {
            "properties": {"policy": {"const": "not_applicable"}},
            "not": {
              "anyOf": [
                {"required": ["master_seed"]},
                {"required": ["seeds"]}
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "seed_policy": {
            "properties": {
              "stochastic": {"const": true},
              "policy": {"const": "fixed_master_seed"}
            },
            "required": ["stochastic", "policy"]
          }
        },
        "required": ["seed_policy"]
      },
      "then": {
        "properties": {
          "seed_policy": {
            "required": ["master_seed"],
            "not": {"required": ["seeds"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "seed_policy": {
            "properties": {
              "stochastic": {"const": true},
              "policy": {"const": "enumerated_seeds"}
            },
            "required": ["stochastic", "policy"]
          }
        },
        "required": ["seed_policy"]
      },
      "then": {
        "properties": {
          "seed_policy": {
            "required": ["seeds"],
            "properties": {"seeds": {"minItems": 1}},
            "not": {"required": ["master_seed"]}
          }
        }
      }
    }
  ]
}
