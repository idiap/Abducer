# Real model capability for source occurrence bounded_frontier:UnresolvedDomainFrontierProjection.
agent bounded_frontier_material_agent(
    task: DomainScopeGrounding,
) -> Result[Generated[BoundedDomainFrontier], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[DomainScopeGrounding] = [bounded_frontier_skill_1, bounded_frontier_skill_2, bounded_frontier_skill_3, bounded_frontier_skill_4]

# Real model capability for source occurrence frontier_readiness:EvidentialFrontierReadinessAssessment.
agent frontier_readiness_material_agent(
    task: BoundedDomainFrontier,
) -> Result[Generated[String], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[BoundedDomainFrontier] = [frontier_readiness_skill_1]

workflow MaterializedCohereFastAdaptiveFrontier(
    scope_grounding: DomainScopeGrounding,
) -> Generated[String]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        # Frontier construction must preserve the grounding's domain and claim ceiling.
        [bounded_frontier: bounded_frontier_material_agent(scope_grounding)]
        # Readiness gates use of the bounded frontier; they do not promote its claims.
        [frontier_readiness: frontier_readiness_material_agent(bounded_frontier.value)]

    return frontier_readiness


