# Copy to config/api_keys.env and fill locally. This file is an example only.
OPENAI_API_KEY=replace-with-local-key
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=high
OPENAI_MAX_CONCURRENT_BRANCHES=1
OPENAI_BRANCH_REQUEST_SPACING_SECONDS=0

# Azure OpenAI / Azure AI Foundry OpenAI-compatible v1.
AZURE_OPENAI_API_KEY=replace-with-local-key
AZURE_OPENAI_ENDPOINT=https://example-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_RESPONSES_ENDPOINT=https://example-resource.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_MODEL=deployment-or-model-name
AZURE_OPENAI_REASONING_EFFORT=high
AZURE_OPENAI_MAX_CONCURRENT_BRANCHES=1
AZURE_OPENAI_BRANCH_REQUEST_SPACING_SECONDS=0
