# Domain layer for timeline-paper-independent-workflow.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type TimelineReasoningOutputs:
    timeline_ref: String

type BoundedManuscriptClaimSet:
    source_ref: String
    claim_ledger_ref: String

type TimelinePaperDisposition:
    | PaperReady
    | ClaimBoundaryFailure
    | Stalled
