set -eu
TO_PRISM_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
export TO_PRISM_TOOLCHAIN_ROOT="$TO_PRISM_ROOT"
if [ -x "$TO_PRISM_ROOT/.venv/bin/to-prism" ]; then
  PATH="$TO_PRISM_ROOT/.venv/bin:$PATH"
  export PATH
  exec "$TO_PRISM_ROOT/.venv/bin/to-prism" "$@"
fi
exec "$TO_PRISM_ROOT/bin/to-prism" "$@"
