# Host-executed material graph for the complete reviewed reasoning path.
# Generated values retain the source epistemic boundary and are not native proof or experiment receipts.

from types import (
    BoundedManuscriptClaimSet,
    TimelinePaperDisposition,
    TimelineReasoningOutputs,
)

from generated.bounded_claim_set_skill_1 import bounded_claim_set_skill_1
from generated.paper_disposition_skill_1 import paper_disposition_skill_1

# Real model capability for source occurrence bounded_claim_set:UnresolvedManuscriptClaimSetProjection.
agent bounded_claim_set_material_agent(
    task: TimelineReasoningOutputs,
) -> Result[Generated[BoundedManuscriptClaimSet], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[TimelineReasoningOutputs] = [bounded_claim_set_skill_1]

# Real model capability for source occurrence paper_disposition:EvidentialTimelinePaperDispositionAssessment.
agent paper_disposition_material_agent(
    task: BoundedManuscriptClaimSet,
) -> Result[Generated[String], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[BoundedManuscriptClaimSet] = [paper_disposition_skill_1]

workflow MaterializedTimelinePaperIndependentWorkflow(
    timeline_outputs: TimelineReasoningOutputs,
) -> Generated[String]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        # Projection creates presentation input but no new claim or evidence.
        [bounded_claim_set: bounded_claim_set_material_agent(timeline_outputs)]
        # The paper gate evaluates whether the bounded set supports assembly.
        [paper_disposition: paper_disposition_material_agent(bounded_claim_set.value)]

    return paper_disposition


def main(
    timeline_outputs: TimelineReasoningOutputs,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[String], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve MaterializedTimelinePaperIndependentWorkflow(timeline_outputs)
