# Relation layer for cohere_fast_scope_and_ground.
# Owns edge/certificate contracts only; builders belong to future materialization.

type ScopeGroundingDependency[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation DomainScopeGroundingEnablesDisposition[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ScopeGroundingDependency[SourceValue, TargetValue]
