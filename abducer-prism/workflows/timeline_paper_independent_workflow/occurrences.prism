# Occurrence layer for timeline-paper-independent-workflow.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.

from workflows.timeline_paper_independent_workflow.types import (
    BoundedManuscriptClaimSet,
    TimelinePaperDisposition,
    TimelineReasoningOutputs,
)

type UnresolvedManuscriptClaimSetProjection = TimelineReasoningOutputs -> Generated[BoundedManuscriptClaimSet]

type EvidentialTimelinePaperDispositionAssessment = BoundedManuscriptClaimSet -> Generated[TimelinePaperDisposition]
