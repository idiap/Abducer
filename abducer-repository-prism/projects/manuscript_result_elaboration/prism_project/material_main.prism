# lunar-runtime: {"declaration":"MaterializedManuscriptResultElaboration","entry_argument":"paper","execute_hook":"abducer-workflow-execute","id":"manuscript_result_elaboration","input_schema":{"additionalProperties":false,"default":{"draft_id":"mk-fixed-point-method-note"},"properties":{"draft_id":{"default":"mk-fixed-point-method-note","maxLength":16000,"minLength":1,"type":"string"}},"required":["draft_id"],"type":"object"},"metadata":{"completion_contract":{"allowed_final_statuses":["passed","completed"],"forbid_blockers":true,"reasoning_complete":true,"reasoning_events_min":8,"terminal_state":"completed"},"description":"extend a result into a scope-safe and evidence-aligned manuscript","model_required":true,"network_required":false,"provenance_contract":{"agent_invocations":[{"activated_skill_ids":["epistemic-status-ledger"],"agent_name":"e0_material_agent","workflow_occurrence":"e0"},{"activated_skill_ids":["kb-abduce"],"agent_name":"a0_material_agent","workflow_occurrence":"a0"},{"activated_skill_ids":["counterexample-hunter"],"agent_name":"r0_material_agent","workflow_occurrence":"r0"},{"activated_skill_ids":["epistemic-status-ledger"],"agent_name":"e1_material_agent","workflow_occurrence":"e1"}],"required_source_reads":[]},"reasoning_contract":{"steps":["e0","a0","r0","e1"],"workflow":"ManuscriptResultElaboration"},"reasoning_required":true,"required_host_capabilities":["model","prism-engine","reasoning-events"],"scientific_truth_verified":false,"semantic_mode":"operational-model-generated","source_materialization_status":"linked_fake_handler_smoke","timeout_seconds":1800},"output_schema":{"additionalProperties":false,"properties":{"analysis_results":{"type":"object"},"compact_prism_input":{"type":"object"},"markdown":{"minLength":1,"type":"string"},"narrative_slots":{"type":"array"},"report_verification":{"properties":{"reasoning_complete":{"const":true},"status":{"const":"passed"}},"required":["status","reasoning_complete"],"type":"object"},"structured_va