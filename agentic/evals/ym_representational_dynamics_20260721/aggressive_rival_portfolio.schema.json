{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YM21 aggressive structurally external rival portfolio",
  "type": "object",
  "required": [
    "schema_version",
    "portfolio_id",
    "target_id",
    "source_version",
    "incumbent_portfolio_ref",
    "incumbent_overlap_evaluation",
    "literature_snapshot",
    "canonical_literature_interop",
    "generation_charter",
    "hypotheses",
    "protected_wildcard_ids",
    "conservative_control_ids",
    "parallel_maturation_plan",
    "explicit_unknowns",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "portfolio_id": {"type": "string", "minLength": 1},
    "target_id": {"const": "yang-mills-existence-and-mass-gap-target"},
    "source_version": {"const": "2026-07-21"},
    "incumbent_portfolio_ref": {"type": "string", "minLength": 1},
    "incumbent_overlap_evaluation": {
      "type": "object",
      "required": ["path", "evaluation_id", "generator_identity", "evaluator_identity", "candidate_set_digest", "content_digest", "binding_status", "truth_authority"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "evaluation_id": {"type": "string", "minLength": 1},
        "generator_identity": {"const": "ym21-aggressive-rival-generator-v2"},
        "evaluator_identity": {"type": "string", "not": {"const": "ym21-aggressive-rival-generator-v2"}},
        "candidate_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "binding_status": {"const": "independent_post_generation_overlap_evaluation"},
        "truth_authority": {"const": "none"}
      },
      "additionalProperties": false
    },
    "literature_snapshot": {
      "type": "object",
      "required": ["snapshot_kind", "provider_backed", "live_recency_claim", "exhaustive_coverage_claim", "peer_validation_claim", "retrieved_at", "snapshot_digest", "coverage_cutoff", "coverage_limits"],
      "properties": {
        "snapshot_kind": {"const": "provider_backed_web_capture"},
        "provider_backed": {"const": true},
        "live_recency_claim": {"const": true},
        "exhaustive_coverage_claim": {"const": false},
        "peer_validation_claim": {"const": false},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_cutoff": {"type": "string", "format": "date"},
        "coverage_limits": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "canonical_literature_interop": {
      "type": "object",
      "required": ["snapshot_path", "snapshot_id", "snapshot_content_digest", "assimilation_path", "assimilation_packet_id", "assimilation_content_digest", "theory_state_digest", "provenance_mode", "hypothesis_rebase_status", "active_investment_gate", "projection_mode", "projection_omissions", "authority_boundary"],
      "properties": {
        "snapshot_path": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "minLength": 1},
        "snapshot_content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "assimilation_path": {"type": "string", "minLength": 1},
        "assimilation_packet_id": {"type": "string", "minLength": 1},
        "assimilation_content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "theory_state_digest": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
        "provenance_mode": {"const": "local_only"},
        "hypothesis_rebase_status": {"const": "provisional_local_only"},
        "active_investment_gate": {"const": "blocked_local_only"},
        "projection_mode": {"const": "conservative_closed_vocabulary_projection"},
        "projection_omissions": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 20}},
        "registered_runtime_upgrade": {
          "type": "object",
          "required": ["binding_id", "status", "target_id", "run_id", "snapshot", "assimilation", "canonical_cycle", "acceptance", "operator_receipts", "projection_relationship", "authority_boundary"],
          "properties": {
            "binding_id": {"const": "ym21-registered-active-current-runtime-20260721"},
            "status": {"const": "active_current"},
            "target_id": {"const": "yang-mills-existence-and-mass-gap-target"},
            "run_id": {"const": "ym21-canonical-parent-20260721"}
          },
          "additionalProperties": true
        },
        "authority_boundary": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "generation_charter": {
      "type": "object",
      "required": ["generator_identity", "theory_first", "structurally_external_minimum", "wildcard_minimum", "control_minimum", "experiments_role"],
      "properties": {
        "generator_identity": {"const": "ym21-aggressive-rival-generator-v2"},
        "theory_first": {"const": true},
        "structurally_external_minimum": {"type": "integer", "minimum": 8},
        "wildcard_minimum": {"type": "integer", "minimum": 2},
        "control_minimum": {"type": "integer", "minimum": 1},
        "experiments_role": {"const": "secondary_support"}
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "hypothesis_id",
          "title",
          "corner_family",
          "portfolio_role",
          "pre_targeted_repair_intuition",
          "mechanism",
          "structural_externality",
          "target_relevance",
          "risk_reward",
          "value_if_right",
          "learning_value_if_false",
          "maturation_question",
          "correction_conditions",
          "literature_rebase",
          "selection_status",
          "parallel_seed",
          "non_claim_boundary"
        ],
        "properties": {
          "hypothesis_id": {"type": "string", "pattern": "^YM21-R[0-9]{2}$"},
          "portfolio_role": {"enum": ["structurally_external_rival", "conservative_control"]},
          "pre_targeted_repair_intuition": {
            "type": "object",
            "required": ["text", "origin", "captured_at", "capture_basis", "preserved_verbatim_before_source_mapping", "full_frontier_search_precedence", "temporal_boundary"],
            "properties": {
              "text": {"type": "string", "minLength": 20},
              "origin": {"type": "string", "minLength": 1},
              "captured_at": {"type": "string", "format": "date-time"},
              "capture_basis": {"type": "string", "minLength": 20},
              "preserved_verbatim_before_source_mapping": {"const": true},
              "full_frontier_search_precedence": {"const": "unknown"},
              "temporal_boundary": {"type": "string", "minLength": 10}
            }
          },
          "structural_externality": {
            "type": "object",
            "required": ["external_to_incumbent", "abandons_incumbent_primitives", "new_primitives"],
            "properties": {
              "external_to_incumbent": {"type": "boolean"},
              "abandons_incumbent_primitives": {"type": "array", "items": {"type": "string"}},
              "new_primitives": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          },
          "risk_reward": {
            "type": "object",
            "required": ["probability_of_truth", "value_if_right", "learning_value_if_false", "maturation_cost"],
            "properties": {
              "probability_of_truth": {"type": "number", "minimum": 0, "maximum": 1},
              "value_if_right": {"type": "number", "minimum": 0, "maximum": 1},
              "learning_value_if_false": {"type": "number", "minimum": 0, "maximum": 1},
              "maturation_cost": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "literature_rebase": {
            "type": "object",
            "required": ["mapping_phase", "mapped_at", "snapshot_digest", "source_ids", "causal_effects", "priority_effect", "required_revisions", "post_targeted_repair_state", "novelty_claim", "authority_boundary"],
            "properties": {
              "mapping_phase": {"const": "targeted_repair_after_bounded_search"},
              "mapped_at": {"type": "string", "format": "date-time"},
              "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
              "causal_effects": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["source_id", "effect_type", "effect", "source_domain", "transfer_boundary", "claim_status"],
                  "properties": {
                    "source_id": {"type": "string", "minLength": 1},
                    "effect_type": {"enum": ["spawn", "merge", "split", "reframe", "demote", "retire", "reprioritize", "unchanged"]},
                    "effect": {"type": "string", "minLength": 20},
                    "source_domain": {"type": "string", "minLength": 20},
                    "transfer_boundary": {"type": "string", "minLength": 20},
                    "claim_status": {"type": "string", "minLength": 1}
                  }
                }
              },
              "priority_effect": {
                "type": "object",
                "required": ["tier", "changed_by_source_ids", "rationale"],
                "properties": {
                  "tier": {"type": "string", "minLength": 1},
                  "changed_by_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
                  "rationale": {"type": "string", "minLength": 20}
                }
              },
              "required_revisions": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 20}},
              "post_targeted_repair_state": {"type": "string", "minLength": 1},
              "novelty_claim": {"const": "unassessed"},
              "authority_boundary": {"type": "string", "minLength": 20}
            }
          },
          "selection_status": {"enum": ["parallel_seed", "protected_wildcard", "control"]}
        },
        "additionalProperties": true
      }
    },
    "protected_wildcard_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "conservative_control_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "parallel_maturation_plan": {
      "type": "object",
      "required": ["max_workers", "isolation", "frozen_inputs", "branches", "merge_policy", "partial_success_policy"],
      "properties": {
        "max_workers": {"type": "integer", "minimum": 2},
        "branches": {"type": "array", "minItems": 10},
        "partial_success_policy": {"const": "preserve_valid_siblings"}
      }
    },
    "explicit_unknowns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
