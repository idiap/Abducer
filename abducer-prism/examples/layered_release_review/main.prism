from examples.layered_release_review.materialization import release_readiness
from examples.layered_release_review.reasoning import ReleaseReadiness
from examples.layered_release_review.types import ReadyToDeploy, ReleaseCandidate

candidate = ReleaseCandidate(
    name = "release-example",
    tests_passed = True,
    approved = True,
    rollback_ready = True,
)

def main() -> Supported[ReadyToDeploy()]:
    flow = release_readiness(candidate)
    return solve ReleaseReadiness(candidate) using flow
