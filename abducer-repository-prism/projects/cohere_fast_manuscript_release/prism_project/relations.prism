# Relation layer for cohere_fast_manuscript_release.
# Owns edge/certificate contracts only; builders belong to future materialization.

type ManuscriptReleaseDependency[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation ClaimBoundedPresentationEnablesRelease[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ManuscriptReleaseDependency[SourceValue, TargetValue]
