{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/discovery_proof_next_cycle_reflection_request_v2.schema.json",
  "title": "Proof result request for blind reflective assimilation in a later theory cycle v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_kind",
    "request_id",
    "content_digest",
    "receipt_index_id",
    "receipt_index_digest",
    "receipt_index_ref",
    "receipt_id",
    "receipt_digest",
    "certificate_digest",
    "artifact_digest",
    "terminal_record_id",
    "terminal_record_digest",
    "target_id",
    "run_id",
    "source_cycle_id",
    "source_branch_id",
    "source_theory_generation",
    "source_commit_id",
    "handoff_id",
    "handoff_digest",
    "formal_claim_digest",
    "obligation_id",
    "action_id",
    "action_digest",
    "reservation_id",
    "reservation_digest",
    "attempt_id",
    "attempt_number",
    "verdict_class",
    "scoped_certificate_authority",
    "earliest_consumer_prior_state_version",
    "earliest_effective_theory_generation",
    "consumption_status",
    "consumed_by_cycle_id",
    "same_cycle_theory_mutation_authorized",
    "authority_nulls",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "request_kind": {"const": "proof_result_next_cycle_reflection"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "content_digest": {"$ref": "#/$defs/digest"},
    "receipt_index_id": {"$ref": "#/$defs/identifier"},
    "receipt_index_digest": {"$ref": "#/$defs/digest"},
    "receipt_index_ref": {"$ref": "#/$defs/safePath"},
    "receipt_id": {"$ref": "#/$defs/identifier"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "certificate_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "artifact_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "terminal_record_id": {"$ref": "#/$defs/identifier"},
    "terminal_record_digest": {"$ref": "#/$defs/digest"},
    "target_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "source_cycle_id": {"$ref": "#/$defs/identifier"},
    "source_branch_id": {"$ref": "#/$defs/identifier"},
    "source_theory_generation": {"type": "integer", "minimum": 1},
    "source_commit_id": {"$ref": "#/$defs/identifier"},
    "handoff_id": {"$ref": "#/$defs/identifier"},
    "handoff_digest": {"$ref": "#/$defs/digest"},
    "formal_claim_digest": {"$ref": "#/$defs/digest"},
    "obligation_id": {"$ref": "#/$defs/identifier"},
    "action_id": {"$ref": "#/$defs/identifier"},
    "action_digest": {"$ref": "#/$defs/digest"},
    "reservation_id": {"$ref": "#/$defs/identifier"},
    "reservation_digest": {"$ref": "#/$defs/digest"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "attempt_number": {"type": "integer", "minimum": 1},
    "verdict_class": {"enum": ["proof_validated", "counterexample_validated", "failed_premise_validated", "inconclusive", "not_evaluated"]},
    "scoped_certificate_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "claim_bound", "checker_soundness_established", "truth_authority", "physics_authority"],
      "properties": {
        "present": {"type": "boolean"},
        "claim_bound": {"type": "boolean"},
        "checker_soundness_established": {"const": false},
        "truth_authority": {"const": false},
        "physics_authority": {"const": false}
      }
    },
    "earliest_consumer_prior_state_version": {"type": "integer", "minimum": 1},
    "earliest_effective_theory_generation": {"type": "integer", "minimum": 2},
    "consumption_status": {"const": "pending"},
    "consumed_by_cycle_id": {"type": "null"},
    "same_cycle_theory_mutation_authorized": {"const": false},
    "authority_nulls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_theory_selection", "direct_hypothesis_promotion", "direct_hypothesis_refutation", "proof_authority", "physics_authority", "evidence_relation_authority"],
      "properties": {
        "direct_theory_selection": {"const": false},
        "direct_hypothesis_promotion": {"const": false},
        "direct_hypothesis_refutation": {"const": false},
        "proof_authority": {"const": false},
        "physics_authority": {"const": false},
        "evidence_relation_authority": {"const": false}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)latest(?:/|$)).+$"}
  }
}
