{
  "version": 1,
  "purpose": "Schema-backed request packets for empirical, lattice, numerical, simulation, or phenomenological evidence that is closely related to a theoretical proof obligation.",
  "required_fields": [
    "request_id",
    "linked_packet_id",
    "linked_theoretical_step",
    "evidence_mode",
    "empirical_question",
    "observable_or_quantity",
    "proximity_class",
    "search_plan",
    "acceptable_sources",
    "support_criteria",
    "refutation_criteria",
    "transfer_gap",
    "proof_boundary",
    "integration_action",
    "demotion_triggers",
    "skill_triggers"
  ],
  "list_fields": [
    "search_plan",
    "acceptable_sources",
    "support_criteria",
    "refutation_criteria",
    "demotion_triggers",
    "skill_triggers"
  ],
  "allowed_evidence_modes": [
    "empirical_probe",
    "negative_evidence",
    "source_import",
    "transfer_gap"
  ],
  "allowed_proximity_classes": [
    "same-theory",
    "regulated-approximation",
    "continuum-extrapolated-regulated-evidence",
    "analogy",
    "toy-model",
    "unrelated"
  ],
  "required_yang_mills_markers": [
    "yang-mills",
    "gauge",
    "lattice",
    "continuum",
    "wilson",
    "glueball",
    "correlator",
    "string tension",
    "reflection positivity",
    "schwinger",
    "monte carlo",
    "cutoff"
  ],
  "validation_policy": "Empirical evidence can support search prioritization, identify witnesses, calibrate assumptions, or trigger demotion. It cannot certify a theorem unless a same-theory transfer theorem is stated as a separate proof obligation."
}
