) -> Result[Generated[ProofRouteRefutationAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ProofRouteDerivedClaim] = [refutation_assessment_reasoning_skill_1]

# EvidentialProofWorkRoutingAssessment performs the reviewed calibrate boundary.
# Granularity: The source exposes EvidentialWorkCalibration as a separately consumed typed result in the abducer_work_loop occurrence graph.
# Linked source skill: skills/evaluation/epistemic-status-ledger/SKILL.md (sha256:980ad92b1f190316a941b8124eaffc6c414680666d2960ebcc8bd21444b4d454).
agent work_routing_reasoning_agent(
    task: ProofWorkRoutingInput,
) -> Result[Generated[ProofWorkRoutingAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ProofWorkRoutingInput] = [work_routing_reasoning_skill_1]

converted_reasoning = AbducerWorkLoop(
    route_hypothesis = route_hypothesis_reasoning_agent,
    derived_claim = derived_claim_reasoning_agent,
    derived_claim_by = derived_claim_reasoning_relation_builder,
    refutation_assessment = refutation_assessment_reasoning_agent,
    refutation_assessment_by = refutation_assessment_reasoning_relation_builder,
    work_routing = work_routing_reasoning_agent,
    work_routing_by = work_routing_reasoning_relation_builder,
)
