{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Failure archaeology packet for a failed or stalled major discovery-marathon cycle set.",
  "properties": {
    "anticipation_heuristics": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "detected": {
            "type": "boolean"
          },
          "pre_cycle_gate": {
            "type": "string"
          },
          "prompt_heuristic": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          }
        },
        "required": [
          "signature",
          "detected",
          "why_it_matters",
          "prompt_heuristic",
          "pre_cycle_gate"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "cycle_set": {
      "additionalProperties": true,
      "properties": {
        "branch_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cycle_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cycle_set_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "window_policy": {
          "type": "string"
        }
      },
      "required": [
        "cycle_set_id",
        "target_id",
        "run_id",
        "cycle_ids",
        "branch_ids",
        "window_policy"
      ],
      "type": "object"
    },
    "failure_detected": {
      "type": "boolean"
    },
    "hard_problem_diagnosis": {
      "additionalProperties": true,
      "properties": {
        "mathematical_hardness": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "physics_hardness": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "representation_hardness": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "physics_hardness",
        "mathematical_hardness",
        "representation_hardness"
      ],
      "type": "object"
    },
    "route_disposition": {
      "enum": [
        "persist_with_new_artifact_gate",
        "reframe_before_investment",
        "demote_to_support_only",
        "falsifier_or_negative_result",
        "quarantine_until_new_evidence",
        "stop",
        "persist_with_explicit_premortem"
      ],
      "type": "string"
    },
    "schema": {
      "const": "abducer.cycle_failure_archaeology.v1"
    }
  },
  "required": [
    "schema",
    "generated_utc",
    "generated_by_skills",
    "cycle_set",
    "failure_detected",
    "failure_summary",
    "smallest_honest_failed_hypothesis",
    "hard_problem_diagnosis",
    "why_failed",
    "why_not_anticipated",
    "anticipation_heuristics",
    "learning_for_future_cycles",
    "required_workflow_change",
    "route_disposition",
    "evidence_paths",
    "validation_handoff"
  ],
  "title": "CycleFailureArchaeology",
  "type": "object"
}
