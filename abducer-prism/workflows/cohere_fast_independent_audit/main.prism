# Fixture-backed typed smoke entrypoint for cohere_fast_independent_audit.
# Routing comments and linked validators remain outside this executable boundary.
from workflows.cohere_fast_independent_audit.materialization import converted_reasoning
from workflows.cohere_fast_independent_audit.reasoning import CohereFastIndependentAudit
from workflows.cohere_fast_independent_audit.types import ConditionalDerivationPacket, IndependentAuditDisposition

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[IndependentAuditDisposition], ModelFailure] ! {AI.Generate, Context.Disclose}:
    conditional_derivation = ConditionalDerivationPacket(
        domain_id = "fixture:cohere_fast_independent_audit:conditional_derivation.domain_id",
        derivation_ref = "fixture:cohere_fast_independent_audit:conditional_derivation.derivation_ref",
        open_obligations_ref = "fixture:cohere_fast_independent_audit:conditional_derivation.open_obligations_ref",
        claim_ceiling = "fixture:cohere_fast_independent_audit:conditional_derivation.claim_ceiling",
    )
    flow = converted_reasoning(conditional_derivation)
    return solve CohereFastIndependentAudit(conditional_derivation) using flow
