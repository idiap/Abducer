# Host-executed material graph for the complete reviewed reasoning path.
# Generated values retain the source epistemic boundary and are not native proof or experiment receipts.

from types import (
    ActiveProofGap,
    ProofRouteDerivedClaim,
    ProofRouteHypothesis,
    ProofRouteRefutationAssessment,
    ProofWorkDisposition,
    ProofWorkRoutingAssessment,
)
from occurrences import (
    ProofWorkRoutingInput,
)

from generated.material_types import (
    MaterialProofWorkRoutingAssessment,
)

from generated.derived_claim_skill_1 import derived_claim_skill_1
from generated.refutation_assessment_skill_1 import refutation_assessment_skill_1
from generated.route_hypothesis_skill_1 import route_hypothesis_skill_1
from generated.work_routing_skill_1 import work_routing_skill_1

# Real model capability for source occurrence route_hypothesis:AbductiveProofRouteHypothesisFormation.
agent route_hypothesis_material_agent(
    task: ActiveProofGap,
) -> Result[Generated[ProofRouteHypothesis], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ActiveProofGap] = [route_hypothesis_skill_1]

# Real model capability for source occurrence derived_claim:DeductiveProofRouteClaimDerivation.
agent derived_claim_material_agent(
    task: ProofRouteHypothesis,
) -> Result[Generated[ProofRouteDerivedClaim], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ProofRouteHypothesis] = [derived_claim_skill_1]

# Real model capability for source occurrence refutation_assessment:RefutationalProofRouteClaimAssessment.
agent refutation_assessment_material_agent(
    task: ProofRouteDerivedClaim,
) -> Result[Generated[ProofRouteRefutationAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ProofRouteDerivedClaim] = [refutation_assessment_skill_1]

# Real model capability for source occurrence work_routing:EvidentialProofWorkRoutingAssessment.
agent work_routing_material_agent(
    task: ProofWorkRoutingInput,
) -> Result[Generated[MaterialProofWorkRoutingAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ProofWorkRoutingInput] = [work_routing_skill_1]

workflow MaterializedAbducerWorkLoop(
    proof_gap: ActiveProofGap,
) -> Generated[MaterialProofWorkRoutingAssessment]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        # Formation and deduction turn the gap into a concrete claim that can fail.
        [route_hypothesis: route_hypothesis_material_agent(proof_gap)]
        [derived_claim: derived_claim_material_agent(route_hypothesis.value)]
        # Refutation tests the claim; calibration uses claim and test, not either alone.
        [refutation_assessment: refutation_assessment_material_agent(derived_claim.value)]
        [work_routing: work_routing_material_agent(ProofWorkRoutingInput(
            derived_claim = derived_claim.value,
            refutation_assessment = refutation_assessment.value,
        ))]

    return work_routing


def main(
    proof_gap: ActiveProofGap,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[MaterialProofWorkRoutingAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve MaterializedAbducerWorkLoop(proof_gap)
