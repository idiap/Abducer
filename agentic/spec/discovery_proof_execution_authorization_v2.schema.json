{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/discovery_proof_execution_authorization_v2.schema.json",
  "title": "Projection of a live reserved canonical proof-execution capability v2",
  "description": "Offline evidence about one non-rehydratable in-process capability. This object is never executable authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_kind",
    "authorization_id",
    "source_authorization_digest",
    "source_authorization_basis_digest",
    "reservation_id",
    "reservation_digest",
    "reservation_record_ref",
    "reserved_commit_id",
    "reserved_manifest_digest",
    "reserved_state_generation",
    "source_commit_id",
    "source_manifest_digest",
    "source_state_generation",
    "schedule_id",
    "schedule_digest",
    "action_id",
    "action_digest",
    "target_id",
    "run_id",
    "cycle_id",
    "branch_id",
    "hypothesis_id",
    "conceptual_system_ids",
    "conjecture_id",
    "obligation_id",
    "handoff_id",
    "handoff_digest",
    "formal_claim_digest",
    "proof_adapter",
    "execution_plan_digest",
    "attempt_number",
    "attempt_id",
    "proof_runtime_root",
    "literature_consume_before",
    "projection_only",
    "authoritative_for_execution",
    "live_capability_required",
    "authority_boundary",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "authorization_kind": {"const": "reserved_canonical_proof_execution"},
    "authorization_id": {"$ref": "#/$defs/identifier"},
    "source_authorization_digest": {"$ref": "#/$defs/digest"},
    "source_authorization_basis_digest": {"$ref": "#/$defs/digest"},
    "reservation_id": {"$ref": "#/$defs/identifier"},
    "reservation_digest": {"$ref": "#/$defs/digest"},
    "reservation_record_ref": {"$ref": "#/$defs/safePath"},
    "reserved_commit_id": {"$ref": "#/$defs/identifier"},
    "reserved_manifest_digest": {"$ref": "#/$defs/digest"},
    "reserved_state_generation": {"type": "integer", "minimum": 1},
    "source_commit_id": {"$ref": "#/$defs/identifier"},
    "source_manifest_digest": {"$ref": "#/$defs/digest"},
    "source_state_generation": {"type": "integer", "minimum": 1},
    "schedule_id": {"$ref": "#/$defs/identifier"},
    "schedule_digest": {"$ref": "#/$defs/digest"},
    "action_id": {"$ref": "#/$defs/identifier"},
    "action_digest": {"$ref": "#/$defs/digest"},
    "target_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "cycle_id": {"$ref": "#/$defs/identifier"},
    "branch_id": {"$ref": "#/$defs/identifier"},
    "hypothesis_id": {"$ref": "#/$defs/identifier"},
    "conceptual_system_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "conjecture_id": {"$ref": "#/$defs/identifier"},
    "obligation_id": {"$ref": "#/$defs/identifier"},
    "handoff_id": {"$ref": "#/$defs/identifier"},
    "handoff_digest": {"$ref": "#/$defs/digest"},
    "formal_claim_digest": {"$ref": "#/$defs/digest"},
    "proof_adapter": {"enum": ["exact", "finite_model", "lean", "command"]},
    "execution_plan_digest": {"$ref": "#/$defs/digest"},
    "attempt_number": {"type": "integer", "minimum": 1},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "proof_runtime_root": {"type": "string", "minLength": 1},
    "literature_consume_before": {"type": "string", "format": "date-time"},
    "projection_only": {"const": true},
    "authoritative_for_execution": {"const": false},
    "live_capability_required": {"const": true},
    "authority_boundary": {"const": "live_reserved_theory_capability_reopened_action_handoff_and_runtime_root_required_no_serialized_reconstruction_truth_theory_selection_or_physics_authority"},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)latest(?:/|$)).+$"}
  }
}
