) -> Result[Generated[String], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ConditionalDerivationPacket] = [refutation_assessment_skill_1]

# Real model capability for source occurrence audit_disposition:EvidentialIndependentAuditDispositionAssessment.
agent audit_disposition_material_agent(
    task: MaterialIndependentAuditDispositionInput,
) -> Result[Generated[String], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[MaterialIndependentAuditDispositionInput] = [audit_disposition_skill_1]

workflow MaterializedCohereFastIndependentAudit(
    conditional_derivation: ConditionalDerivationPacket,
) -> Generated[String]
    fails ModelFailure
