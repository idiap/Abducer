{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/tdr/skill-result.schema.json",
  "title": "SkillResult",
  "type": "object",
  "required": ["status", "artifacts", "claims", "uncertainties", "next", "provenance"],
  "properties": {
    "status": {"enum": ["completed", "partial", "blocked", "invalid"]},
    "artifacts": {"type": "array", "items": {}},
    "claims": {"type": "array", "items": {"type": "object"}},
    "uncertainties": {"type": "array", "items": {"type": "object"}},
    "next": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "object"},
    "messages": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

