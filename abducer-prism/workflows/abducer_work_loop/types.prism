# Domain layer for abducer_work_loop.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type ActiveProofGap:
    obligation: String

type ProofRouteHypothesis:
    route_hypothesis: String

type ProofRouteDerivedClaim:
    derived_claim: String

type ProofRouteRefutationAssessment:
    scoped_refutation: String

type ProofWorkDisposition:
    | ReadyForReleasePromotion
    | Reframe
    | Retarget
    | Refuted

type ProofWorkRoutingAssessment:
    disposition: ProofWorkDisposition
    routing_basis: String
