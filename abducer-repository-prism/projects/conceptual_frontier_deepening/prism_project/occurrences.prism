# Occurrence layer for conceptual_frontier_deepening.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.

from types import (
    FormalizationReadinessAssessment,
    FormalizationDisposition,
    BridgeDerivedFormalClaim,
    BoundedConceptualFrontier,
    DiscriminatingConceptualHypothesis,
    ConceptualHypothesisSelection,
    FrozenConceptualContext,
    ConceptualHypothesisRefutationAssessment,
    RevisedConceptualBridge,
)

type ConceptualHypothesisSelectionInput:
    conceptual_hypothesis: DiscriminatingConceptualHypothesis
    refutation_assessment: ConceptualHypothesisRefutationAssessment

type EvidentialConceptualFrontierGrounding = FrozenConceptualContext -> Generated[BoundedConceptualFrontier]

type AbductiveConceptualHypothesisFormation = BoundedConceptualFrontier -> Generated[DiscriminatingConceptualHypothesis]

type RefutationalConceptualHypothesisAssessment = DiscriminatingConceptualHypothesis -> Generated[ConceptualHypothesisRefutationAssessment]

type EvidentialConceptualHypothesisSelection = ConceptualHypothesisSelectionInput -> Generated[ConceptualHypothesisSelection]

type AnalogicalConceptualBridgeRevision = ConceptualHypothesisSelection -> Generated[RevisedConceptualBridge]

type DeductiveFormalClaimDerivation = RevisedConceptualBridge -> Generated[BridgeDerivedFormalClaim]

type EvidentialFormalizationReadinessAssessment = BridgeDerivedFormalClaim -> Generated[FormalizationReadinessAssessment]
