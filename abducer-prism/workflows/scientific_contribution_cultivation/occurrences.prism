# Occurrence layer for scientific_contribution_cultivation.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.
# The occurrences retain the former ERFL roles: abduction (A),
# refutation/testing (R), and evidence/status calibration (E).

from workflows.scientific_contribution_cultivation.types import (
    ContributionReadinessAssessment,
    ScientificContributionHypothesis,
    ScientificContributionDisposition,
    ContributionValueAssessment,
    ContributionSupportAssessment,
    EnablementAudit,
    MainProblemAlignmentAudit,
    ResultAtlasSlice,
)

type ContributionReadinessInput:
    contribution_hypothesis: ScientificContributionHypothesis
    support_assessment: ContributionSupportAssessment

type AbductiveScientificContributionHypothesisFormation = ResultAtlasSlice -> Generated[ScientificContributionHypothesis]

type RefutationalContributionSupportAssessment = ScientificContributionHypothesis -> Generated[ContributionSupportAssessment]

type EvidentialContributionReadinessAssessment = ContributionReadinessInput -> Generated[ContributionReadinessAssessment]
