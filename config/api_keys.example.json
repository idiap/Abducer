{
  "version": 1,
  "active_provider": "openai",
  "providers": {
    "openai": {
      "description": "OpenAI-compatible API credentials for Codex/API-backed branch execution.",
      "env": {
        "OPENAI_API_KEY": "replace-with-local-key",
        "OPENAI_ORG_ID": "",
        "OPENAI_PROJECT_ID": "",
        "OPENAI_BASE_URL": "",
        "OPENAI_MODEL": "",
        "OPENAI_MAX_OUTPUT_TOKENS": "6000",
        "OPENAI_API_TIMEOUT_SECONDS": "900",
        "OPENAI_MAX_CONCURRENT_BRANCHES": "1",
        "OPENAI_BRANCH_REQUEST_SPACING_SECONDS": "0"
      }
    },
    "azure_openai": {
      "description": "Azure OpenAI or Azure AI Foundry OpenAI-compatible v1 credentials. AZURE_OPENAI_ENDPOINT is the base endpoint; AZURE_OPENAI_RESPONSES_ENDPOINT keeps the full Responses URL for audit clarity.",
      "env": {
        "AZURE_OPENAI_API_KEY": "replace-with-local-key",
        "AZURE_OPENAI_ENDPOINT": "https://example-resource.services.ai.azure.com/openai/v1",
        "AZURE_OPENAI_RESPONSES_ENDPOINT": "https://example-resource.services.ai.azure.com/openai/v1/responses",
        "AZURE_OPENAI_MODEL": "deployment-or-model-name",
        "OPENAI_API_KEY": "replace-with-local-key",
        "OPENAI_BASE_URL": "https://example-resource.services.ai.azure.com/openai/v1",
        "OPENAI_MODEL": "deployment-or-model-name",
        "OPENAI_REASONING_EFFORT": "high",
        "AZURE_OPENAI_REASONING_EFFORT": "high",
        "AZURE_OPENAI_MAX_OUTPUT_TOKENS": "6000",
        "AZURE_OPENAI_API_TIMEOUT_SECONDS": "900",
        "AZURE_OPENAI_MAX_CONCURRENT_BRANCHES": "1",
        "AZURE_OPENAI_BRANCH_REQUEST_SPACING_SECONDS": "0"
      }
    }
  }
}
