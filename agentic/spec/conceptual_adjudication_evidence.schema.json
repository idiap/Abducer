            "transformation_operations": {"$ref": "#/$defs/digest"},
            "primitives": {"$ref": "#/$defs/digest"},
            "ontology": {"$ref": "#/$defs/digest"},
            "ontological_commitments": {"$ref": "#/$defs/digest"},
            "relations_operations_and_dynamics": {"$ref": "#/$defs/digest"},
            "explanatory_ideal": {"$ref": "#/$defs/digest"},
            "mechanism_or_principle": {"$ref": "#/$defs/digest"},
            "protected_successes": {"$ref": "#/$defs/digest"},
            "target_pressures_addressed": {"$ref": "#/$defs/digest"},
            "relevance": {"$ref": "#/$defs/digest"},
            "identities_and_differences": {"$ref": "#/$defs/digest"},
            "formerly_inexpressible_now_visible": {"$ref": "#/$defs/digest"},
            "unification_claims": {"$ref": "#/$defs/digest"},
            "unification_map": {"$ref": "#/$defs/digest"},
            "explanatory_dependencies": {"$ref": "#/$defs/digest"},
            "dependencies": {"$ref": "#/$defs/digest"},
            "implications_and_new_questions": {"$ref": "#/$defs/digest"},
