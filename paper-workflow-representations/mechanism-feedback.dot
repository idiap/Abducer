digraph mechanism {
 graph [rankdir=TB,bgcolor="white",nodesep=.3,ranksep=.35];
 node [shape=box,style="rounded,filled",fillcolor="#eef3f8",fontname="Helvetica",fontsize=12];
 edge [fontname="Helvetica",fontsize=10];
 t [label="Target pressure + protected successes\nWhat must a replacement still explain?"];
 c [label="Construct materially distinct rivals\nChange a primitive, relation or mechanism"];
 r [label="Opposed reflection and correction\nRevise content; preserve surviving successes"];
 s [label="Compare complete candidates\nRetain a plural set or require further revision"];
 q [label="Choose the remaining question\nRefine, derive, prove or commission a support probe"];
 t -> c; c -> r; r -> s; s -> q [label="when sufficiently articulated"];
 s -> c [label="revise all",color="#245a81"];
 q -> r [label="new objection or evidence",color="#245a81"];
}
