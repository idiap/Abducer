# Domain layer for target_navigation_loop.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type UnscopedResearchTarget:
    target_id: String

type TargetDependencyFrontier:
    target_id: String
    frontier_ref: String

type TargetNavigationDisposition:
    | WorkReady
    | ReadyForReleasePromotion
    | Stalled
