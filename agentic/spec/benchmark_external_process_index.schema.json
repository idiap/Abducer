{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/benchmark_external_process_index.schema.json",
  "title": "Immutable governed benchmark process index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "index_id", "benchmark_id", "benchmark_run_id", "role", "run_directory", "receipt_count", "receipts", "aggregate_usage", "accounting_boundary", "content_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "index_id": {"type": "string", "pattern": "^benchmark-process-index\\.[a-f0-9]{24}$"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "benchmark_run_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["benchmark_runner", "human_evidence_verifier"]},
    "run_directory": {"type": "string", "minLength": 1},
    "receipt_count": {"type": "integer", "minimum": 0},
    "receipts": {"type": "array", "items": {"$ref": "#/$defs/summary"}},
    "aggregate_usage": {"$ref": "#/$defs/usage"},
    "accounting_boundary": {"$ref": "#/$defs/accountingBoundary"},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "processStatus": {"enum": ["succeeded", "deadline_exhausted", "cpu_exhausted", "out_of_memory", "disk_exhausted", "network_exhausted", "token_exhausted", "request_exhausted", "spend_exhausted", "input_exhausted", "output_exhausted", "worker_failed", "report_failed", "cancelled"]},
    "protocolStatus": {"enum": ["accepted", "process_failed", "input_exhausted", "output_exhausted", "invalid_utf8", "invalid_json", "non_object", "reserved_field_spoofed", "reported_usage_exhausted", "authority_mismatch", "authority_or_launch_failed", "request_encoding_failed"]},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "receipt_id", "receipt_ref", "receipt_digest", "receipt_file_sha256", "receipt_byte_length", "index_ref", "run_directory", "benchmark_id", "benchmark_run_id", "role", "invocation_id", "request_digest", "command_authority_digest", "command_authority_status", "command_authority_observation_digest", "isolation_assurance_digest", "isolation_status", "external_efficacy_eligible", "workspace_ref", "workspace_digest", "budget_digest", "resource_receipt_digest", "response_digest", "process_status", "protocol_status", "outcome_status", "epistemic_effect"],
      "properties": {
        "schema_version": {"const": 1},
        "receipt_id": {"type": "string", "pattern": "^benchmark-process-receipt\\.[a-f0-9]{24}$"},
        "receipt_ref": {"type": "string", "pattern": "^receipts/(benchmark_runner|human_evidence_verifier)/benchmark-process-receipt\\.[a-f0-9]{24}\\.json$"},
        "receipt_digest": {"$ref": "#/$defs/digest"},
        "receipt_file_sha256": {"$ref": "#/$defs/digest"},
        "receipt_byte_length": {"type": "integer", "minimum": 1},
        "index_ref": {"type": "string", "pattern": "^indices/(benchmark_runner|human_evidence_verifier)\\.json$"},
        "run_directory": {"type": "string", "minLength": 1},
        "benchmark_id": {"type": "string", "minLength": 1},
        "benchmark_run_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["benchmark_runner", "human_evidence_verifier"]},
        "invocation_id": {"type": "string", "pattern": "^benchmark-invocation\\.[a-f0-9]{24}$"},
        "request_digest": {"$ref": "#/$defs/digest"},
        "command_authority_digest": {"$ref": "#/$defs/digest"},
        "command_authority_status": {"enum": ["exact_match", "mismatch"]},
        "command_authority_observation_digest": {"$ref": "#/$defs/digest"},
        "isolation_assurance_digest": {"$ref": "#/$defs/digest"},
        "isolation_status": {"const": "unisolated_protocol_only"},
        "external_efficacy_eligible": {"const": false},
        "workspace_ref": {"type": "string", "pattern": "^workspaces/(benchmark_runner|human_evidence_verifier)/benchmark-invocation\\.[a-f0-9]{24}$"},
        "workspace_digest": {"$ref": "#/$defs/digest"},
        "budget_digest": {"$ref": "#/$defs/digest"},
        "resource_receipt_digest": {"$ref": "#/$defs/digest"},
        "response_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "process_status": {"$ref": "#/$defs/processStatus"},
        "protocol_status": {"$ref": "#/$defs/protocolStatus"},
        "outcome_status": {"enum": ["accepted", "operational_failure", "protocol_failure"]},
        "epistemic_effect": {"const": "none_process_execution_has_no_epistemic_authority"}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_time_seconds", "cpu_seconds", "peak_memory_bytes", "disk_bytes", "network_bytes", "token_count", "request_count", "cost_usd"],
      "properties": {
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "cpu_seconds": {"type": "number", "minimum": 0},
        "peak_memory_bytes": {"type": "integer", "minimum": 0},
        "disk_bytes": {"type": "integer", "minimum": 0},
        "network_bytes": {"type": "integer", "minimum": 0},
        "token_count": {"type": "integer", "minimum": 0},
        "request_count": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "accountingBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace_policy", "network", "cost_units", "cost_usd", "isolation", "epistemic_effect"],
      "properties": {
        "workspace_policy": {"const": "one_attempt_local_accounting_root_per_invocation"},
        "network": {"const": "unavailable_without_adapter_measurement"},
        "cost_units": {"const": "benchmark_payload_units_not_relabelled_as_cost_usd"},
        "cost_usd": {"const": "unavailable_without_adapter_measurement"},
        "isolation": {"const": "local_subprocess_protocol_only_no_hiddenness_or_external_efficacy"},
        "epistemic_effect": {"const": "none_operational_accounting_only"}
      }
    }
  }
}
