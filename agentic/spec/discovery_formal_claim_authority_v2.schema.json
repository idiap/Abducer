{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/discovery_formal_claim_authority_v2.schema.json",
  "title": "Committed registered formal-claim authority v2",
  "description": "A deterministic post-commit join over one registered producer request, successful receipt, immutable output-history artifact, semantic row, and verified theory commit. It is provenance for a proof handoff, not proof or truth authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_kind",
    "authority_id",
    "content_digest",
    "producer_registry_id",
    "producer_registry_digest",
    "producer_registry_row_digest",
    "producer_registry_path",
    "producer_registry_file_digest",
    "producer_operator_id",
    "producer_operator_version",
    "producer_request_id",
    "producer_request_digest",
    "producer_receipt_id",
    "producer_receipt_digest",
    "theory_authorization_digest",
    "theory_authorization_basis_digest",
    "literature_authority_basis_digest",
    "source_commit_generation",
    "source_commit_id",
    "source_manifest_digest",
    "source_state_file_digest",
    "source_state_semantic_digest",
    "operator_evidence_path",
    "operator_evidence_file_digest",
    "operator_evidence_digest",
    "producer_request_binding_digest",
    "producer_receipt_binding_digest",
    "producer_input_artifacts",
    "producer_input_path",
    "producer_input_file_digest",
    "producer_input_content_digest",
    "producer_input_binding_digest",
    "output_path",
    "output_file_digest",
    "producer_output_id",
    "producer_output_binding_digest",
    "output_content_digest",
    "feedback_edge_path",
    "feedback_edge_file_digest",
    "feedback_edge_id",
    "feedback_edge_digest",
    "semantic_consumer_event_id",
    "semantic_consumer_event_hash",
    "semantic_row_id",
    "semantic_row_digest",
    "target_id",
    "run_id",
    "source_cycle_id",
    "source_prior_state_version",
    "source_theory_generation",
    "branch_id",
    "hypothesis_id",
    "concept_id",
    "conceptual_system_ids",
    "conjecture_id",
    "source_operator_id",
    "source_operator_request_id",
    "source_operator_receipt_id",
    "source_operator_receipt_digest",
    "source_output_path",
    "source_output_digest",
    "source_finalized_reflection_id",
    "source_finalized_reflection_digest",
    "source_conceptual_authority_digest",
    "source_semantic_kind",
    "source_semantic_row_id",
    "source_semantic_row_digest",
    "source_theory_programme_id",
    "source_theory_programme_digest",
    "literature_authority",
    "literature_authority_digest",
    "literature_consume_before",
    "theory_ancestry",
    "theory_ancestry_digest",
    "producer_generation_mode",
    "display_statement",
    "formal_claim",
    "formal_claim_digest",
    "proof_adapter",
    "execution_plan",
    "execution_plan_digest",
    "ready_status",
    "no_same_cycle_experiment_ancestry",
    "committed_reopen_required",
    "authority_nulls"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "authority_kind": {"const": "committed_registered_formal_claim"},
    "authority_id": {"$ref": "#/$defs/identifier"},
    "content_digest": {"$ref": "#/$defs/digest"},
    "producer_registry_id": {"const": "reflective-discovery-operators"},
    "producer_registry_digest": {"$ref": "#/$defs/digest"},
    "producer_registry_row_digest": {"$ref": "#/$defs/digest"},
    "producer_registry_path": {"$ref": "#/$defs/safePath"},
    "producer_registry_file_digest": {"$ref": "#/$defs/digest"},
    "producer_operator_id": {"const": "formal-claim-producer"},
    "producer_operator_version": {"const": "2.0.0"},
    "producer_request_id": {"$ref": "#/$defs/identifier"},
    "producer_request_digest": {"$ref": "#/$defs/digest"},
    "producer_receipt_id": {"$ref": "#/$defs/identifier"},
    "producer_receipt_digest": {"$ref": "#/$defs/digest"},
    "theory_authorization_digest": {"$ref": "#/$defs/digest"},
    "theory_authorization_basis_digest": {"$ref": "#/$defs/digest"},
    "literature_authority_basis_digest": {"$ref": "#/$defs/digest"},
    "source_commit_generation": {"type": "integer", "minimum": 1},
    "source_commit_id": {"$ref": "#/$defs/identifier"},
    "source_manifest_digest": {"$ref": "#/$defs/digest"},
    "source_state_file_digest": {"$ref": "#/$defs/digest"},
    "source_state_semantic_digest": {"$ref": "#/$defs/digest"},
    "operator_evidence_path": {"$ref": "#/$defs/safePath"},
    "operator_evidence_file_digest": {"$ref": "#/$defs/digest"},
    "operator_evidence_digest": {"$ref": "#/$defs/digest"},
    "producer_request_binding_digest": {"$ref": "#/$defs/digest"},
    "producer_receipt_binding_digest": {"$ref": "#/$defs/digest"},
    "producer_input_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./discovery_operator_request.schema.json#/$defs/artifact"
      }
    },
    "producer_input_path": {"$ref": "#/$defs/safePath"},
    "producer_input_file_digest": {"$ref": "#/$defs/digest"},
    "producer_input_content_digest": {"$ref": "#/$defs/digest"},
    "producer_input_binding_digest": {"$ref": "#/$defs/digest"},
    "output_path": {"$ref": "#/$defs/safePath"},
    "output_file_digest": {"$ref": "#/$defs/digest"},
    "producer_output_id": {"$ref": "#/$defs/identifier"},
    "producer_output_binding_digest": {"$ref": "#/$defs/digest"},
    "output_content_digest": {"$ref": "#/$defs/digest"},
    "feedback_edge_path": {"$ref": "#/$defs/safePath"},
    "feedback_edge_file_digest": {"$ref": "#/$defs/digest"},
    "feedback_edge_id": {"$ref": "#/$defs/identifier"},
    "feedback_edge_digest": {"$ref": "#/$defs/digest"},
    "semantic_consumer_event_id": {"$ref": "#/$defs/identifier"},
    "semantic_consumer_event_hash": {"$ref": "#/$defs/digest"},
    "semantic_row_id": {"$ref": "#/$defs/identifier"},
    "semantic_row_digest": {"$ref": "#/$defs/digest"},
    "target_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "source_cycle_id": {"$ref": "#/$defs/identifier"},
    "source_prior_state_version": {"type": "integer", "minimum": 0},
    "source_theory_generation": {"type": "integer", "minimum": 1},
    "branch_id": {"$ref": "#/$defs/identifier"},
    "hypothesis_id": {"$ref": "#/$defs/identifier"},
    "concept_id": {"$ref": "#/$defs/identifier"},
    "conceptual_system_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "conjecture_id": {"$ref": "#/$defs/identifier"},
    "source_operator_id": {"const": "reflective-theory-synthesizer"},
    "source_operator_request_id": {"$ref": "#/$defs/identifier"},
    "source_operator_receipt_id": {"$ref": "#/$defs/identifier"},
    "source_operator_receipt_digest": {"$ref": "#/$defs/digest"},
    "source_output_path": {"$ref": "#/$defs/safePath"},
    "source_output_digest": {"$ref": "#/$defs/digest"},
    "source_finalized_reflection_id": {"$ref": "#/$defs/identifier"},
    "source_finalized_reflection_digest": {"$ref": "#/$defs/digest"},
    "source_conceptual_authority_digest": {"$ref": "#/$defs/digest"},
    "source_semantic_kind": {"const": "formalization_seed"},
    "source_semantic_row_id": {"$ref": "#/$defs/identifier"},
    "source_semantic_row_digest": {"$ref": "#/$defs/digest"},
    "source_theory_programme_id": {"$ref": "#/$defs/identifier"},
    "source_theory_programme_digest": {"$ref": "#/$defs/digest"},
    "literature_authority": {
      "$ref": "./discovery_proof_handoff.schema.json#/$defs/literatureAuthority"
    },
    "literature_authority_digest": {"$ref": "#/$defs/digest"},
    "literature_consume_before": {"type": "string", "format": "date-time"},
    "theory_ancestry": {
      "$ref": "./discovery_proof_handoff.schema.json#/$defs/theoryAncestry"
    },
    "theory_ancestry_digest": {"$ref": "#/$defs/digest"},
    "producer_generation_mode": {
      "const": "registered_deterministic_compiler"
    },
    "display_statement": {"type": "string", "minLength": 1},
    "formal_claim": {
      "$ref": "./discovery_proof_handoff.schema.json#/$defs/formalClaim"
    },
    "formal_claim_digest": {"$ref": "#/$defs/digest"},
    "proof_adapter": {"enum": ["exact", "finite_model", "lean", "command"]},
    "execution_plan": {
      "$ref": "./discovery_proof_handoff.schema.json#/$defs/executionPlan"
    },
    "execution_plan_digest": {"$ref": "#/$defs/digest"},
    "ready_status": {"const": "ready"},
    "no_same_cycle_experiment_ancestry": {"const": true},
    "committed_reopen_required": {"const": true},
    "authority_nulls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_truth",
        "proof_success",
        "checker_soundness",
        "theorem_status",
        "theory_selection",
        "same_cycle_theory_mutation",
        "independent_semantic_authorship",
        "physics_value"
      ],
      "properties": {
        "claim_truth": {"const": false},
        "proof_success": {"const": false},
        "checker_soundness": {"const": false},
        "theorem_status": {"const": false},
        "theory_selection": {"const": false},
        "same_cycle_theory_mutation": {"const": false},
        "independent_semantic_authorship": {"const": false},
        "physics_value": {"const": false}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)latest(?:/|$)).+$"
    }
  }
}
