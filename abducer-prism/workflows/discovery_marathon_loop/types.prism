# Domain layer for discovery_marathon_loop.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type DiscoveryRunContext:
    context_summary: String

type BoundedDiscoveryScope:
    bounded_scope: String

type DiscriminatingDiscoveryHypothesis:
    hypothesis: String

type ProvisionalDiscoveryPattern:
    provisional_pattern: String

type HypothesisModelImplications:
    bounded_model_implications: String

type HypothesisContrastAssessment:
    controlled_contrast: String

type HypothesisRefutationAssessment:
    scoped_refutation: String

type DiscoveryDisposition:
    | Promotable
    | Reorient
    | TargetReset
    | Stalled

type DiscoveryRoutingAssessment:
    disposition: DiscoveryDisposition
    routing_basis: String
