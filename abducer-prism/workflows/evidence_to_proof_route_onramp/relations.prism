# Relation layer for evidence_to_proof_route_onramp.
# Owns edge/certificate contracts only; builders belong to future materialization.

type ProofRouteEvidenceConstraint[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

type ProofRouteConsequenceAssumption[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

type ProofRouteConsequenceCalibration[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

type ProofEntrypointRevision[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

type ProofEntrypointFalsificationTest[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation GroundsProofRouteSearch[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ProofRouteEvidenceConstraint[SourceValue, TargetValue]

relation TreatsRouteAsConsequencePremise[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ProofRouteConsequenceAssumption[SourceValue, TargetValue]

relation CalibratesProofRouteAssessment[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ProofRouteConsequenceCalibration[SourceValue, TargetValue]

relation RevisesProofObligationEntrypoint[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ProofEntrypointRevision[SourceValue, TargetValue]

relation TestsProofEntrypoint[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ProofEntrypointFalsificationTest[SourceValue, TargetValue]
