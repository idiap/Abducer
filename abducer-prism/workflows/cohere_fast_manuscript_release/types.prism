# Domain layer for cohere_fast_manuscript_release.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type IndependentAuditPacket:
    domain_id: String
    audit_ref: String
    claim_ceiling: String

type ClaimBoundedPresentation:
    domain_id: String
    presentation_ref: String
    source_audit_ref: String
    claim_ceiling: String

type ManuscriptReleaseDisposition:
    | Accepted
    | Stopped
