{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/benchmark_external_process_receipt.schema.json",
  "title": "Governed external benchmark process receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "receipt_ref", "index_ref", "benchmark_id", "benchmark_run_id", "role", "invocation_id", "request_digest", "command_authority", "command_authority_observation", "isolation_assurance", "workspace", "budget_digest", "process_status", "protocol_status", "outcome_status", "process_event", "resource_receipt", "resource_receipt_digest", "response_payload", "response_digest", "failure", "epistemic_effect", "content_digest"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "receipt_id": {"type": "string", "pattern": "^benchmark-process-receipt\\.[a-f0-9]{24}$"},
    "receipt_ref": {"type": "string", "pattern": "^receipts/(benchmark_runner|human_evidence_verifier)/benchmark-process-receipt\\.[a-f0-9]{24}\\.json$"},
    "index_ref": {"type": "string", "pattern": "^indices/(benchmark_runner|human_evidence_verifier)\\.json$"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "benchmark_run_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["benchmark_runner", "human_evidence_verifier"]},
    "invocation_id": {"type": "string", "pattern": "^benchmark-invocation\\.[a-f0-9]{24}$"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "command_authority": {"$ref": "#/$defs/commandAuthority"},
    "command_authority_observation": {"$ref": "#/$defs/commandAuthorityObservation"},
    "isolation_assurance": {"$ref": "#/$defs/isolationAssurance"},
    "workspace": {"$ref": "#/$defs/workspace"},
    "budget_digest": {"$ref": "#/$defs/digest"},
    "process_status": {"$ref": "#/$defs/processStatus"},
    "protocol_status": {"$ref": "#/$defs/protocolStatus"},
    "outcome_status": {"enum": ["accepted", "operational_failure", "protocol_failure"]},
    "process_event": {"$ref": "#/$defs/processEvent"},
    "resource_receipt": {"$ref": "#/$defs/resourceReceipt"},
    "resource_receipt_digest": {"$ref": "#/$defs/digest"},
    "response_payload": {"oneOf": [{"type": "object"}, {"type": "null"}]},
    "response_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "failure": {"oneOf": [{"$ref": "#/$defs/failure"}, {"type": "null"}]},
    "epistemic_effect": {"const": "none_process_execution_has_no_epistemic_authority"},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "oneOf": [
    {
      "required": ["schema_version", "process_event", "resource_receipt"],
      "properties": {
        "schema_version": {"const": 1},
        "process_event": {"$ref": "#/$defs/processEventV1"},
        "resource_receipt": {"$ref": "#/$defs/resourceReceiptV1"}
      }
    },
    {
      "required": ["schema_version", "process_event", "resource_receipt"],
      "properties": {
        "schema_version": {"const": 2},
        "process_event": {"$ref": "#/$defs/processEventV2"},
        "resource_receipt": {"$ref": "#/$defs/resourceReceiptV2"}
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {"outcome_status": {"const": "accepted"}},
        "required": ["outcome_status"]
      },
      "then": {
        "properties": {
          "process_status": {"const": "succeeded"},
          "protocol_status": {"const": "accepted"},
          "response_payload": {"type": "object"},
          "response_digest": {"$ref": "#/$defs/digest"},
          "failure": {"type": "null"},
          "process_event": {"properties": {"status": {"const": "succeeded"}}}
        }
      },
      "else": {
        "properties": {
          "response_payload": {"type": "null"},
          "response_digest": {"type": "null"},
          "failure": {"$ref": "#/$defs/failure"}
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 2}, "outcome_status": {"const": "accepted"}},
        "required": ["schema_version", "outcome_status"]
      },
      "then": {
        "properties": {
          "process_event": {
            "properties": {
              "supervision_attempt": {"properties": {"status": {"const": "succeeded"}}},
              "resource_limit_execution": {"properties": {"supervised_transport_exact": {"const": true}, "replacement_environment_used": {"const": true}, "observation_status": {"const": "exact_match"}}},
              "post_supervision_acceptance": {"properties": {"status": {"const": "accepted"}}}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "processStatus": {"enum": ["succeeded", "deadline_exhausted", "cpu_exhausted", "out_of_memory", "disk_exhausted", "network_exhausted", "token_exhausted", "request_exhausted", "spend_exhausted", "input_exhausted", "output_exhausted", "worker_failed", "report_failed", "cancelled"]},
    "protocolStatus": {"enum": ["accepted", "process_failed", "input_exhausted", "output_exhausted", "invalid_utf8", "invalid_json", "non_object", "reserved_field_spoofed", "reported_usage_exhausted", "authority_mismatch", "authority_or_launch_failed", "request_encoding_failed"]},
    "fileDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_path", "sha256", "byte_length", "source", "argv_indexes", "executable"],
      "properties": {
        "canonical_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "byte_length": {"type": "integer", "minimum": 1},
        "source": {"enum": ["executable", "argv", "approved", "argv+approved"]},
        "argv_indexes": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "executable": {"type": "boolean"}
      }
    },
    "commandAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "argv", "argv_digest", "executable", "dependencies", "trust_boundary", "content_digest"],
      "properties": {
        "schema_version": {"const": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "argv_digest": {"$ref": "#/$defs/digest"},
        "executable": {"$ref": "#/$defs/fileDescriptor"},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/fileDescriptor"}, "uniqueItems": true},
        "trust_boundary": {"const": "local_exact_dependency_identity_not_external_human_authority"},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "commandAuthorityObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "expected_authority_digest", "entries", "content_digest"],
      "properties": {
        "schema_version": {"const": 1},
        "status": {"enum": ["exact_match", "mismatch"]},
        "expected_authority_digest": {"$ref": "#/$defs/digest"},
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/authorityObservationEntry"}},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "isolationAssurance": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "deny_by_construction", "external_efficacy_eligible", "channels", "boundary", "content_digest"],
      "properties": {
        "schema_version": {"const": 1},
        "status": {"const": "unisolated_protocol_only"},
        "deny_by_construction": {"const": false},
        "external_efficacy_eligible": {"const": false},
        "channels": {
          "type": "object", "additionalProperties": false,
          "required": ["declared_input_only", "filesystem", "environment", "process", "network", "symlink_and_absolute_path", "undeclared_access_audit"],
          "properties": {
            "declared_input_only": {"const": "unavailable_process_can_read_host_inputs"},
            "filesystem": {"const": "unavailable_no_mount_or_namespace_confinement"},
            "environment": {"const": "exact_replacement_allowlist_plus_typed_budget_fields"},
            "process": {"const": "unavailable_process_group_controls_lifecycle_not_access"},
            "network": {"const": "unavailable_no_network_namespace_or_deny_policy"},
            "symlink_and_absolute_path": {"const": "unavailable_no_kernel_path_confinement"},
            "undeclared_access_audit": {"const": "unavailable_no_observed_access_trace"}
          }
        },
        "boundary": {"type": "string", "minLength": 1},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "authorityObservationEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_path", "expected_sha256", "expected_byte_length", "expected_executable", "observed_status", "observed_canonical_path", "observed_sha256", "observed_byte_length", "observed_executable"],
      "properties": {
        "canonical_path": {"type": "string", "minLength": 1},
        "expected_sha256": {"$ref": "#/$defs/digest"},
        "expected_byte_length": {"type": "integer", "minimum": 1},
        "expected_executable": {"type": "boolean"},
        "observed_status": {"enum": ["matched", "missing", "symlink", "not_regular", "path_mismatch", "bytes_mismatch", "permission_mismatch", "unavailable"]},
        "observed_canonical_path": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "observed_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "observed_byte_length": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "observed_executable": {"oneOf": [{"type": "boolean"}, {"type": "null"}]}
      }
    },
    "workspace": {
      "type": "object", "additionalProperties": false,
      "required": ["run_directory", "workspace_ref", "resolved_path", "invocation_id", "workspace_digest"],
      "properties": {
        "run_directory": {"type": "string", "minLength": 1},
        "workspace_ref": {"type": "string", "pattern": "^workspaces/(benchmark_runner|human_evidence_verifier)/benchmark-invocation\\.[a-f0-9]{24}$"},
        "resolved_path": {"type": "string", "minLength": 1},
        "invocation_id": {"type": "string", "pattern": "^benchmark-invocation\\.[a-f0-9]{24}$"},
        "workspace_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "measuredDimensionV1": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "enforced"],
      "properties": {"status": {"const": "measured"}, "enforced": {"const": true}}
    },
    "reportedDimension": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "enforced", "reason"],
      "properties": {
        "status": {"enum": ["externally_reported", "unavailable"]},
        "enforced": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "diskDimensionV1": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "enforced", "accounting_root", "sample_interval_seconds", "limitation"],
      "properties": {
        "status": {"enum": ["sampled_high_water", "unavailable"]},
        "enforced": {"type": "boolean"},
        "accounting_root": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "sample_interval_seconds": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "null"}]},
        "limitation": {"type": "string", "minLength": 1}
      }
    },
    "measurementV1": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_time_seconds", "cpu_seconds", "peak_memory_bytes", "disk_bytes", "network_bytes", "token_count", "request_count", "cost_usd"],
      "properties": {
        "wall_time_seconds": {"$ref": "#/$defs/measuredDimensionV1"},
        "cpu_seconds": {"$ref": "#/$defs/measuredDimensionV1"},
        "peak_memory_bytes": {"$ref": "#/$defs/measuredDimensionV1"},
        "disk_bytes": {"$ref": "#/$defs/diskDimensionV1"},
        "network_bytes": {"$ref": "#/$defs/reportedDimension"},
        "token_count": {"$ref": "#/$defs/reportedDimension"},
        "request_count": {"$ref": "#/$defs/reportedDimension"},
        "cost_usd": {"$ref": "#/$defs/reportedDimension"}
      }
    },
    "wallDimensionV2": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "enforced", "scope", "hard_kernel_preemption", "blocking_call_overrun_detected_after_return"],
      "properties": {
        "status": {"const": "parent_monotonic_deadline"},
        "enforced": {"const": true},
        "scope": {"const": "execution_deadline_plus_bounded_cleanup_and_acceptance"},
        "hard_kernel_preemption": {"const": false},
        "blocking_call_overrun_detected_after_return": {"const": true}
      }
    },
    "cpuDimensionV2": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "enforced", "kernel_limit", "post_exit_acceptance", "full_process_group_coverage"],
      "properties": {
        "status": {"const": "target_pid_wait4_accounting"},
        "enforced": {"const": true},
        "kernel_limit": {"const": "inherited_per_process_integer_second_rlimit_cpu"},
        "post_exit_acceptance": {"const": "exact_nanosecond_wait4_threshold"},
        "full_process_group_coverage": {"const": false}
      }
    },
    "memoryDimensionV2": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "enforced", "kernel_limit", "hard_group_rss_limit", "sampling_misses_between_observations"],
      "properties": {
        "status": {"const": "wait4_maxrss_plus_sampled_original_group_rss"},
        "enforced": {"const": true},
        "kernel_limit": {"enum": ["linux_inherited_per_process_virtual_address_space_rlimit", "unavailable_on_darwin"]},
        "hard_group_rss_limit": {"const": false},
        "sampling_misses_between_observations": {"const": true}
      }
    },
    "diskDimensionV2": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "enforced", "kernel_limit", "hard_aggregate_workspace_quota", "accounting_root", "sample_interval_seconds", "limitation"],
      "properties": {
        "status": {"enum": ["post_exit_positive_growth_high_water", "unavailable"]},
        "enforced": {"type": "boolean"},
        "kernel_limit": {"enum": ["inherited_per_file_rlimit_fsize", "unavailable"]},
        "hard_aggregate_workspace_quota": {"const": false},
        "accounting_root": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "sample_interval_seconds": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "null"}]},
        "limitation": {"type": "string", "minLength": 1}
      }
    },
    "measurementV2": {
      "type": "object", "additionalProperties": false,
      "required": ["measurement_schema_version", "wall_time_seconds", "cpu_seconds", "peak_memory_bytes", "disk_bytes", "network_bytes", "token_count", "request_count", "cost_usd"],
      "properties": {
        "measurement_schema_version": {"const": 2},
        "wall_time_seconds": {"$ref": "#/$defs/wallDimensionV2"},
        "cpu_seconds": {"$ref": "#/$defs/cpuDimensionV2"},
        "peak_memory_bytes": {"$ref": "#/$defs/memoryDimensionV2"},
        "disk_bytes": {"$ref": "#/$defs/diskDimensionV2"},
        "network_bytes": {"$ref": "#/$defs/reportedDimension"},
        "token_count": {"$ref": "#/$defs/reportedDimension"},
        "request_count": {"$ref": "#/$defs/reportedDimension"},
        "cost_usd": {"$ref": "#/$defs/reportedDimension"}
      }
    },
    "measurement": {
      "oneOf": [
        {"$ref": "#/$defs/measurementV1"},
        {"$ref": "#/$defs/measurementV2"}
      ]
    },
    "supervisionAttemptV2": {"$ref": "process_supervision_attempt.schema.json#/$defs/supervisionAttemptV2"},
    "resourceExecPlanV2": {"$ref": "process_supervision_attempt.schema.json#/$defs/resourceExecPlanV2"},
    "sealedFileObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "device", "inode", "mode", "mtime_ns", "ctime_ns", "executable_required", "executable_observed"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 0},
        "mode": {"type": "integer", "minimum": 0},
        "mtime_ns": {"type": "integer"},
        "ctime_ns": {"type": "integer"},
        "executable_required": {"type": "boolean"},
        "executable_observed": {"type": "boolean"}
      }
    },
    "resourceExecObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["python_executable", "resource_exec_launcher"],
      "properties": {
        "python_executable": {"allOf": [{"$ref": "#/$defs/sealedFileObservation"}, {"properties": {"executable_required": {"const": true}, "executable_observed": {"const": true}}}]},
        "resource_exec_launcher": {"$ref": "#/$defs/sealedFileObservation"}
      }
    },
    "resourceLimitExecutionV2": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "authority_kind", "logical_argv_digest", "transport_argv_digest", "supervised_request_digest", "supervised_transport_exact", "replacement_environment_used", "environment_digest", "capture_limit_bytes", "resource_exec_plan", "resource_exec_plan_digest", "pre_execution_observation", "post_execution_observation", "observation_status", "observation_error", "cryptographic_authenticity", "authority_boundary"],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "authority_kind": {"const": "trusted_local_resource_limit_execution"},
        "logical_argv_digest": {"$ref": "#/$defs/digest"},
        "transport_argv_digest": {"$ref": "#/$defs/digest"},
        "supervised_request_digest": {"$ref": "#/$defs/digest"},
        "supervised_transport_exact": {"type": "boolean"},
        "replacement_environment_used": {"const": true},
        "environment_digest": {"$ref": "#/$defs/digest"},
        "capture_limit_bytes": {"type": "integer", "minimum": 1},
        "resource_exec_plan": {"$ref": "#/$defs/resourceExecPlanV2"},
        "resource_exec_plan_digest": {"$ref": "#/$defs/digest"},
        "pre_execution_observation": {"$ref": "#/$defs/resourceExecObservation"},
        "post_execution_observation": {"oneOf": [{"$ref": "#/$defs/resourceExecObservation"}, {"type": "null"}]},
        "observation_status": {"enum": ["exact_match", "mismatch"]},
        "observation_error": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "cryptographic_authenticity": {"const": false},
        "authority_boundary": {"const": "exact_local_bytes_and_request_binding_only_no_semantic_scientific_truth_experiment_value_or_physics_authority"}
      },
      "allOf": [
        {
          "if": {"properties": {"observation_status": {"const": "exact_match"}}, "required": ["observation_status"]},
          "then": {"properties": {"post_execution_observation": {"$ref": "#/$defs/resourceExecObservation"}, "observation_error": {"type": "null"}}}
        },
        {
          "if": {"properties": {"post_execution_observation": {"type": "null"}}, "required": ["post_execution_observation"]},
          "then": {"properties": {"observation_status": {"const": "mismatch"}, "observation_error": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "postSupervisionAcceptanceV2": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "disk_snapshot_bytes", "disk_limit_bytes", "disk_limit_exceeded", "continuous_disk_observation", "snapshot_error", "acceptance_deadline_overrun"],
      "properties": {
        "status": {"enum": ["not_run", "accepted", "rejected", "snapshot_failed", "deadline_overrun"]},
        "disk_snapshot_bytes": {"type": "integer", "minimum": 0},
        "disk_limit_bytes": {"type": "integer", "minimum": 0},
        "disk_limit_exceeded": {"type": "boolean"},
        "continuous_disk_observation": {"const": false},
        "snapshot_error": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "acceptance_deadline_overrun": {"type": "boolean"}
      },
      "oneOf": [
        {"properties": {"status": {"const": "not_run"}, "snapshot_error": {"type": "null"}, "acceptance_deadline_overrun": {"const": false}}},
        {"properties": {"status": {"const": "accepted"}, "disk_limit_exceeded": {"const": false}, "snapshot_error": {"type": "null"}, "acceptance_deadline_overrun": {"const": false}}},
        {"properties": {"status": {"const": "rejected"}, "disk_limit_exceeded": {"const": true}, "snapshot_error": {"type": "null"}, "acceptance_deadline_overrun": {"const": false}}},
        {"properties": {"status": {"const": "deadline_overrun"}, "snapshot_error": {"type": "null"}, "acceptance_deadline_overrun": {"const": true}}},
        {"properties": {"status": {"const": "snapshot_failed"}, "snapshot_error": {"type": "string", "minLength": 1}}}
      ]
    },
    "processEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event", "role", "command", "pid", "started_at", "completed_at", "elapsed_seconds", "returncode", "status", "terminal_dimension", "terminal_used", "terminal_limit", "termination", "stdin_bytes", "stdin_sha256", "stdin_limit_bytes", "stdin_written_bytes", "stdin_write_incomplete", "stdin_write_error", "stdout", "stderr", "stdout_bytes", "stderr_bytes", "stdout_retained_bytes", "stderr_retained_bytes", "stdout_sha256", "stderr_sha256", "stdout_utf8_valid", "stderr_utf8_valid", "stdout_truncated", "stderr_truncated", "stdout_drain_incomplete", "stderr_drain_incomplete", "stdout_limit_bytes", "stderr_limit_bytes", "descendant_leak_detected", "capture_limit_bytes", "resource_measurement", "epistemic_effect"],
      "properties": {
        "event_schema_version": {"const": 2},
        "event": {"const": "process_terminal"},
        "role": {"enum": ["benchmark_runner", "human_evidence_verifier"]},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "pid": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "started_at": {"type": "string", "minLength": 1},
        "completed_at": {"type": "string", "minLength": 1},
        "elapsed_seconds": {"type": "number", "minimum": 0},
        "returncode": {"oneOf": [{"type": "integer"}, {"type": "null"}]},
        "status": {"$ref": "#/$defs/processStatus"},
        "terminal_dimension": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "terminal_used": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "terminal_limit": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "termination": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "stdin_bytes": {"type": "integer", "minimum": 0},
        "stdin_sha256": {"$ref": "#/$defs/digest"},
        "stdin_limit_bytes": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "stdin_written_bytes": {"type": "integer", "minimum": 0},
        "stdin_write_incomplete": {"type": "boolean"},
        "stdin_write_error": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "stdout_bytes": {"type": "integer", "minimum": 0},
        "stderr_bytes": {"type": "integer", "minimum": 0},
        "stdout_retained_bytes": {"type": "integer", "minimum": 0},
        "stderr_retained_bytes": {"type": "integer", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/digest"},
        "stderr_sha256": {"$ref": "#/$defs/digest"},
        "stdout_utf8_valid": {"type": "boolean"},
        "stderr_utf8_valid": {"type": "boolean"},
        "stdout_truncated": {"type": "boolean"},
        "stderr_truncated": {"type": "boolean"},
        "stdout_drain_incomplete": {"type": "boolean"},
        "stderr_drain_incomplete": {"type": "boolean"},
        "stdout_limit_bytes": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "stderr_limit_bytes": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "descendant_leak_detected": {"type": "boolean"},
        "capture_limit_bytes": {"type": "integer", "minimum": 1},
        "resource_measurement": {"$ref": "#/$defs/measurement"},
        "supervision_attempt": {"oneOf": [{"$ref": "#/$defs/supervisionAttemptV2"}, {"type": "null"}]},
        "resource_limit_execution": {"oneOf": [{"$ref": "#/$defs/resourceLimitExecutionV2"}, {"type": "null"}]},
        "post_supervision_acceptance": {"$ref": "#/$defs/postSupervisionAcceptanceV2"},
        "epistemic_effect": {"enum": ["awaiting_output_validation", "none_operational_outcome_only"]}
      },
      "allOf": [
        {
          "if": {"required": ["event_schema_version"]},
          "then": {"required": ["event_schema_version", "supervision_attempt", "resource_limit_execution", "post_supervision_acceptance"]},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["supervision_attempt"]},
                {"required": ["resource_limit_execution"]},
                {"required": ["post_supervision_acceptance"]}
              ]
            }
          }
        }
      ]
    },
    "processEventV1": {
      "allOf": [
        {"$ref": "#/$defs/processEvent"},
        {"not": {"required": ["event_schema_version"]}},
        {
          "properties": {
            "resource_measurement": {"$ref": "#/$defs/measurementV1"}
          }
        }
      ]
    },
    "processEventV2": {
      "allOf": [
        {"$ref": "#/$defs/processEvent"},
        {"required": ["event_schema_version", "supervision_attempt", "resource_limit_execution", "post_supervision_acceptance"]},
        {
          "properties": {
            "event_schema_version": {"const": 2},
            "stdin_limit_bytes": {"type": "integer", "minimum": 1},
            "resource_measurement": {"$ref": "#/$defs/measurementV2"}
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "pid": {"type": "null"},
                "returncode": {"type": "null"},
                "termination": {"const": "not_started"},
                "supervision_attempt": {"type": "null"},
                "resource_limit_execution": {"type": "null"},
                "post_supervision_acceptance": {"properties": {"status": {"const": "not_run"}}},
                "epistemic_effect": {"const": "none_operational_outcome_only"}
              }
            },
            {
              "properties": {
                "supervision_attempt": {"$ref": "#/$defs/supervisionAttemptV2"},
                "resource_limit_execution": {"$ref": "#/$defs/resourceLimitExecutionV2"},
                "post_supervision_acceptance": {"properties": {"status": {"enum": ["accepted", "rejected", "snapshot_failed", "deadline_overrun"]}}},
                "termination": {"oneOf": [{"enum": ["terminated", "killed"]}, {"type": "null"}]}
              }
            }
          ]
        },
        {
          "if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]},
          "then": {"properties": {"epistemic_effect": {"const": "awaiting_output_validation"}}},
          "else": {"properties": {"epistemic_effect": {"const": "none_operational_outcome_only"}}}
        }
      ]
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["budget_id", "wall_time_seconds", "grace_period_seconds", "cpu_seconds", "memory_bytes", "disk_bytes", "network_bytes", "token_count", "request_count", "cost_usd", "absolute_deadline"],
      "properties": {
        "budget_id": {"type": "string", "minLength": 1},
        "wall_time_seconds": {"type": "number", "exclusiveMinimum": 0},
        "grace_period_seconds": {"type": "number", "minimum": 0},
        "cpu_seconds": {"type": "number", "exclusiveMinimum": 0},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "disk_bytes": {"type": "integer", "minimum": 0},
        "network_bytes": {"type": "integer", "minimum": 0},
        "token_count": {"type": "integer", "minimum": 0},
        "request_count": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0},
        "absolute_deadline": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_time_seconds", "cpu_seconds", "peak_memory_bytes", "disk_bytes", "network_bytes", "token_count", "request_count", "cost_usd"],
      "properties": {
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "cpu_seconds": {"type": "number", "minimum": 0},
        "peak_memory_bytes": {"type": "integer", "minimum": 0},
        "disk_bytes": {"type": "integer", "minimum": 0},
        "network_bytes": {"type": "integer", "minimum": 0},
        "token_count": {"type": "integer", "minimum": 0},
        "request_count": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "resourceReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["budget", "usage", "status", "events", "deadline", "resource_measurement"],
      "properties": {
        "budget": {"$ref": "#/$defs/budget"},
        "usage": {"$ref": "#/$defs/usage"},
        "status": {"$ref": "#/$defs/processStatus"},
        "events": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/processEvent"}},
        "deadline": {"type": "string", "minLength": 1},
        "resource_measurement": {"$ref": "#/$defs/measurement"}
      }
    },
    "resourceReceiptV1": {
      "allOf": [
        {"$ref": "#/$defs/resourceReceipt"},
        {
          "properties": {
            "events": {
              "items": {"$ref": "#/$defs/processEventV1"}
            },
            "resource_measurement": {"$ref": "#/$defs/measurementV1"}
          }
        }
      ]
    },
    "resourceReceiptV2": {
      "allOf": [
        {"$ref": "#/$defs/resourceReceipt"},
        {
          "properties": {
            "events": {
              "items": {"$ref": "#/$defs/processEventV2"}
            },
            "resource_measurement": {"$ref": "#/$defs/measurementV2"}
          }
        }
      ]
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "error_type", "message", "message_digest"],
      "properties": {
        "stage": {"type": "string", "minLength": 1},
        "error_type": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "message_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
