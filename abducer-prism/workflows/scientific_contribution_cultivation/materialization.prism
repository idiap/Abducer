# Materialization layer for scientific_contribution_cultivation.
# Compiled modules snapshot current linked skill bytes without writing source trees;
# the manifest records paths/hashes. Fake execution proves typed integration only.
from workflows.scientific_contribution_cultivation.types import (
    ContributionReadinessAssessment,
    ContributionSupportAssessment,
    ResultAtlasSlice,
    ScientificContributionHypothesis,
)
from workflows.scientific_contribution_cultivation.occurrences import (
    ContributionReadinessInput,
)
from workflows.scientific_contribution_cultivation.reasoning import ScientificContributionCultivation
from workflows.scientific_contribution_cultivation.relations import (
    ContributionHypothesisTest,
    ContributionReadinessCalibration,
)
from workflows.scientific_contribution_cultivation.generated.a0_reasoning_skill_1 import kb_abduce_skill as a0_reasoning_skill_1
from workflows.scientific_contribution_cultivation.generated.r0_reasoning_skill_1 import counterexample_hunter_skill as r0_reasoning_skill_1
from workflows.scientific_contribution_cultivation.generated.e0_reasoning_skill_1 import epistemic_status_ledger_skill as e0_reasoning_skill_1

def r0_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ContributionHypothesisTest[SourceValue, TargetValue]:
    return ContributionHypothesisTest(source = source, target = target)

def e0_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ContributionReadinessCalibration[SourceValue, TargetValue]:
    return ContributionReadinessCalibration(source = source, target = target)

# AbductiveScientificContributionHypothesisFormation performs the reviewed abduct boundary.
# Granularity: The source exposes AbduceContribution as a separately consumed typed result in the scientific_contribution_cultivation occurrence graph.
# Linked source skill: skills/reasoning/kb-abduce/SKILL.md (sha256:3c0985794a9e14c75a8edc7a3ecccfa4ef28a51cd1b096985359d6cdab534a03).
agent a0_reasoning_agent(
    task: ResultAtlasSlice,
) -> Result[Generated[ScientificContributionHypothesis], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ResultAtlasSlice] = [a0_reasoning_skill_1]

# RefutationalContributionSupportAssessment performs the reviewed refute boundary.
# Granularity: The source exposes TestContribution as a separately consumed typed result in the scientific_contribution_cultivation occurrence graph.
# Linked source skill: skills/evaluation/counterexample-hunter/SKILL.md (sha256:413eb19c3dcdc59f53bac734b6a9864e1252095063f1cbb3674dcab3445c748d).
agent r0_reasoning_agent(
    task: ScientificContributionHypothesis,
) -> Result[Generated[ContributionSupportAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ScientificContributionHypothesis] = [r0_reasoning_skill_1]

# EvidentialContributionReadinessAssessment performs the reviewed calibrate boundary.
# Granularity: The source exposes CalibrateContribution as a separately consumed typed result in the scientific_contribution_cultivation occurrence graph.
# Linked source skill: skills/evaluation/epistemic-status-ledger/SKILL.md (sha256:980ad92b1f190316a941b8124eaffc6c414680666d2960ebcc8bd21444b4d454).
agent e0_reasoning_agent(
    task: ContributionReadinessInput,
) -> Result[Generated[ContributionReadinessAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ContributionReadinessInput] = [e0_reasoning_skill_1]

converted_reasoning = ScientificContributionCultivation(
    a0 = a0_reasoning_agent,
    r0 = r0_reasoning_agent,
    r0_by = r0_reasoning_relation_builder,
    e0 = e0_reasoning_agent,
    e0_by = e0_reasoning_relation_builder,
)
