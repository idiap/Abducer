digraph core {
 graph [rankdir=TB,bgcolor="white",nodesep=.35,ranksep=.35];
 node [shape=box,style="rounded,filled",fillcolor="#eef3f8",fontname="Helvetica",fontsize=12];
 edge [fontname="Helvetica",fontsize=10];
 a [label="A: propose a spectral-gap bound\nCandidate premise; still unproved"];
 d [label="D: derive conditional decay\nRetain the spectral-gap premise"];
 r [label="R: test the uniform claim\nLarge cycles defeat connectedness alone"];
 e [label="E: calibrate claim + critical evidence\nFixed-graph result retained; uniformity conditional"];
 a -> d [label="assume candidate"];
 d -> r [label="test scope"];
 d -> e [label="retain claim\nand premises",color="#245a81"];
 r -> e [label="critical evidence"];
}
