{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prism.local/to-prism/lock.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact": {"const": "to-prism-lock"},
    "converter_version": {"type": "string"},
    "decisions_hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "generated_files": {"items": {"type": "object"}, "type": "array"},
    "inventory_hash": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "prism": {"type": "object"},
    "profile_versions": {"type": "object"},
    "schema_version": {"const": "1.0"},
    "source_fingerprint": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "template_version": {"type": "string"}
  },
  "required": ["artifact", "converter_version", "decisions_hash", "generated_files", "inventory_hash", "prism", "profile_versions", "schema_version", "source_fingerprint", "template_version"],
  "type": "object"
}
