# Occurrence layer for cohere_fast_derivation_and_proof.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.

from types import (
    ConditionalDerivationPacket,
    DerivationReadinessDisposition,
    BoundedDomainFrontier,
)

type UnresolvedConditionalDerivationProjection = BoundedDomainFrontier -> Generated[ConditionalDerivationPacket]

type EvidentialDerivationReadinessAssessment = ConditionalDerivationPacket -> Generated[DerivationReadinessDisposition]
