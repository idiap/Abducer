{
  "version": 1,
  "required_fields": [
    "target_id",
    "raw_goal",
    "kb_path",
    "main_claim_ids",
    "desired_output_type",
    "quality_criteria",
    "acceptance_gates",
    "known_constraints",
    "unknowns",
    "validation_targets",
    "evidence_paths"
  ],
  "allowed_output_types": [
    "proof_route",
    "proof_sketch",
    "refutation",
    "dependency_map",
    "expert_handoff",
    "research_program_update",
    "controlled_iteration"
  ],
  "quality_criterion_required_fields": [
    "criterion_id",
    "question",
    "measurement",
    "pass_condition"
  ],
  "acceptance_gate_required_fields": [
    "gate_id",
    "kind",
    "required_evidence",
    "blocks_release"
  ],
  "validation_target_required_fields": [
    "target",
    "verification_method",
    "evidence_artifact"
  ],
  "policy": "A target packet is the first-class goal object for a controlled Abducer run. It must point to a local KB and must name concrete acceptance gates before a recursive dependency run is allowed."
}
