        "node_ids": {"$ref": "#/$defs/identifiers"},
        "edge_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "relation_kinds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "enum": [
              "causes", "constrains", "corrects", "depends_on", "distinguishes",
              "enables", "instantiates", "maps_to", "mediates", "obstructs",
              "precedes", "preserves", "transports"
            ]
          }
        },
        "unification_digest": {"$ref": "#/$defs/digest"},
        "before_graph_digest": {"$ref": "#/$defs/digest"},
        "after_graph_digest": {"$ref": "#/$defs/digest"},
        "graph_closed": {"const": true},
        "valid": {"const": true}
      }
