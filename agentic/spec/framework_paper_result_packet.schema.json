{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework_paper_result_packet.schema.json",
  "title": "Framework Paper Authorized Result Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "authorization_status", "evidence_tier", "protocol_id", "receipt_digests", "metric_definitions", "results", "uncertainty", "replication", "limitations", "content_digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "packet_id": {"type": "string", "minLength": 1},
    "authorization_status": {"enum": ["unauthorized", "authorized", "revoked"]},
    "evidence_tier": {"enum": ["synthetic_harness", "observed_single_run", "externally_authorized_replicated"]},
    "protocol_id": {"type": "string", "minLength": 1},
    "receipt_digests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "metric_definitions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "results": {"type": "object", "additionalProperties": {"type": ["number", "string", "null"]}},
    "uncertainty": {"type": "object"},
    "replication": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
