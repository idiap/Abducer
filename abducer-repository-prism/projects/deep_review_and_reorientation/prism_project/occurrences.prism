# Occurrence layer for deep_review_and_reorientation.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.

from types import (
    ReorientationDecisionAssessment,
    ReorientationRepairOptions,
    ReorientationDisposition,
    ReviewDefeaterAssessment,
    ReviewEvidenceBundle,
    FormalizedReviewState,
)

type ReorientationDecisionInput:
    defeater_assessment: ReviewDefeaterAssessment
    repair_options: ReorientationRepairOptions

type EvidentialReviewStateGrounding = ReviewEvidenceBundle -> Generated[FormalizedReviewState]

type RefutationalReviewDefeaterAssessment = FormalizedReviewState -> Generated[ReviewDefeaterAssessment]

type AbductiveReorientationRepairFormation = FormalizedReviewState -> Generated[ReorientationRepairOptions]

type EvidentialReorientationDecisionAssessment = ReorientationDecisionInput -> Generated[ReorientationDecisionAssessment]
