# Domain layer for cohere_fast_derivation_and_proof.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type BoundedDomainFrontier:
    domain_id: String
    frontier_ref: String
    claim_ceiling: String

type ConditionalDerivationPacket:
    domain_id: String
    derivation_ref: String
    open_obligations_ref: String
    claim_ceiling: String

type DerivationReadinessDisposition:
    | Accepted
    | Quarantined
