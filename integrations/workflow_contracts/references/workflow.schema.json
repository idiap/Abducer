{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workflow-skill:schema:v1",
  "title": "Workflow Skill v1",
  "$comment": "SPDX-FileCopyrightText: © 2026 Idiap Research Institute <contact@idiap.ch>; SPDX-License-Identifier: MIT",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "workflow-skill/v1"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_workflow$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "const": "workflow"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "lifecycle": {
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "activation": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "explicit",
            "conditional",
            "default"
          ]
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        }
      },
      "required": [
        "mode",
        "prerequisites"
      ],
      "additionalProperties": false
    },
    "types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "schema": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "representation": {
            "enum": [
              "value",
              "file",
              "directory"
            ]
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "schema"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
      },
      "minProperties": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "$ref": "#/$defs/expression"
          }
        },
        "required": [
          "type",
          "value"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "propertyNames": {
              "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
            }
          },
          "outputs": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "propertyNames": {
              "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
            }
          },
          "execution": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "specification_only",
                  "deterministic",
                  "generative",
                  "human",
                  "mixed"
                ]
              },
              "binding": {
                "type": "object",
                "properties": {
                  "adapter": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "profile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                  },
                  "kind": {
                    "enum": [
                      "skill",
                      "workflow",
                      "action",
                      "tool"
                    ]
                  }
                },
                "required": [
                  "adapter",
                  "target",
                  "operation",
                  "kind"
                ],
                "additionalProperties": false
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "specification_only"
                    }
                  }
                },
                "then": {
                  "required": [
                    "reason"
                  ],
                  "not": {
                    "required": [
                      "binding"
                    ]
                  }
                },
                "else": {
                  "required": [
                    "binding"
                  ]
                }
              }
            ]
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "effects": {
            "$ref": "#/$defs/effects"
          },
          "authority": {
            "$ref": "#/$defs/authority"
          }
        },
        "required": [
          "inputs",
          "outputs",
          "execution"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
      },
      "minProperties": 1
    },
    "flow": {
      "$ref": "#/$defs/node"
    },
    "policy": {
      "type": "object",
      "properties": {
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "limits": {
          "type": "object",
          "properties": {
            "wall_time_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "max_operation_calls": {
              "type": "integer",
              "minimum": 1
            },
            "max_cost": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "wall_time_seconds",
            "max_operation_calls"
          ],
          "additionalProperties": false,
          "dependentRequired": {
            "max_cost": [
              "currency"
            ]
          }
        },
        "failure": {
          "type": "object",
          "properties": {
            "default": {
              "enum": [
                "fail",
                "blocked",
                "quarantine",
                "needs_input"
              ]
            },
            "retry": {
              "type": "object",
              "properties": {
                "max_attempts": {
                  "type": "integer",
                  "minimum": 1
                },
                "retryable_codes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "max_attempts"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "default",
            "retry"
          ],
          "additionalProperties": false
        },
        "resume": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "checkpoint"
              ]
            },
            "require_matching_definition_and_inputs": {
              "const": true
            }
          },
          "required": [
            "mode",
            "require_matching_definition_and_inputs"
          ],
          "additionalProperties": false
        },
        "secret_references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "effects",
        "authority",
        "limits",
        "failure",
        "resume"
      ],
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "properties": {
        "receipts": {
          "const": "required"
        },
        "artifact_digests": {
          "const": "sha256"
        },
        "provenance": {
          "const": "required"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "receipts",
        "artifact_digests",
        "provenance",
        "events"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "coverage": {
          "enum": [
            "complete",
            "interface_only",
            "partial"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "coverage",
        "sources",
        "gaps"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "gaps": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "gaps": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "namespace",
    "id",
    "version",
    "kind",
    "description",
    "aliases",
    "lifecycle",
    "activation",
    "types",
    "inputs",
    "outputs",
    "operations",
    "flow",
    "policy",
    "observability",
    "provenance",
    "extensions"
  ],
  "additionalProperties": false,
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*$"
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "literal": {}
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "eq": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "eq"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "exists": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "exists"
          ],
          "additionalProperties": false
        }
      ]
    },
    "effects": {
      "type": "object",
      "properties": {
        "filesystem": {
          "type": "object",
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "read",
            "write"
          ],
          "additionalProperties": false
        },
        "network": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "external_write": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "filesystem",
        "network"
      ],
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "allowed",
        "forbidden"
      ],
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "on_failure": {
          "enum": [
            "fail",
            "blocked",
            "quarantine",
            "needs_input"
          ]
        },
        "kind": {
          "const": "call"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expression"
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          }
        }
      },
      "required": [
        "kind",
        "operation",
        "arguments"
      ],
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "on_failure": {
          "enum": [
            "fail",
            "blocked",
            "quarantine",
            "needs_input"
          ]
        },
        "kind": {
          "const": "handoff"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expression"
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          }
        },
        "continuation": {
          "enum": [
            "deferred",
            "automatic"
          ]
        }
      },
      "required": [
        "kind",
        "operation",
        "arguments",
        "continuation"
      ],
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "on_failure": {
          "enum": [
            "fail",
            "blocked",
            "quarantine",
            "needs_input"
          ]
        },
        "kind": {
          "const": "gate"
        },
        "condition": {
          "$ref": "#/$defs/expression"
        },
        "on_false": {
          "enum": [
            "blocked",
            "needs_input",
            "quarantine",
            "fail"
          ]
        }
      },
      "required": [
        "kind",
        "condition",
        "on_false"
      ],
      "additionalProperties": false
    },
    "sequence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "on_failure": {
          "enum": [
            "fail",
            "blocked",
            "quarantine",
            "needs_input"
          ]
        },
        "kind": {
          "const": "sequence"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 1
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "$ref": "#/$defs/expression"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          }
        }
      },
      "required": [
        "kind",
        "steps"
      ],
      "additionalProperties": false
    },
    "parallel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "on_failure": {
          "enum": [
            "fail",
            "blocked",
            "quarantine",
            "needs_input"
          ]
        },
        "kind": {
          "const": "parallel"
        },
        "branches": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/node"
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          },
          "minProperties": 2
        },
        "join": {
          "const": "all"
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "$ref": "#/$defs/expression"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          }
        }
      },
      "required": [
        "kind",
        "branches",
        "join",
        "max_concurrency"
      ],
      "additionalProperties": false
    },
    "switch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "on_failure": {
          "enum": [
            "fail",
            "blocked",
            "quarantine",
            "needs_input"
          ]
        },
        "kind": {
          "const": "switch"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "when": {
                "$ref": "#/$defs/expression"
              },
              "body": {
                "$ref": "#/$defs/node"
              }
            },
            "required": [
              "id",
              "when",
              "body"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "default": {
          "$ref": "#/$defs/node"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "$ref": "#/$defs/expression"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          }
        }
      },
      "required": [
        "kind",
        "cases",
        "default"
      ],
      "additionalProperties": false
    },
    "map": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "on_failure": {
