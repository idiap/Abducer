# Relation layer for cohere_fast_independent_audit.
# Owns edge/certificate contracts only; builders belong to future materialization.

type IndependentAuditCalibrationBasis[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation CalibratesIndependentAuditDisposition[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> IndependentAuditCalibrationBasis[SourceValue, TargetValue]
