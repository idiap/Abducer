def defeater_assessment_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ReorientationAlternativeConstraint[SourceValue, TargetValue]:
    return ReorientationAlternativeConstraint(source = source, target = target)

def repair_options_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ReorientationAlternativeConstraint[SourceValue, TargetValue]:
    return ReorientationAlternativeConstraint(source = source, target = target)

def reorientation_decision_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ReorientationDecisionCalibration[SourceValue, TargetValue]:
    return ReorientationDecisionCalibration(source = source, target = target)

# EvidentialReviewStateGrounding performs the reviewed calibrate boundary.
# Granularity: The source exposes EvidentialReviewGrounding as a separately consumed typed result in the deep_review_and_reorientation occurrence graph.
# Linked source skill: skills/evaluation/epistemic-status-ledger/SKILL.md (sha256:980ad92b1f190316a941b8124eaffc6c414680666d2960ebcc8bd21444b4d454).
agent review_state_reasoning_agent(
    task: ReviewEvidenceBundle,
) -> Result[Generated[FormalizedReviewState], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ReviewEvidenceBundle] = [review_state_reasoning_skill_1]

