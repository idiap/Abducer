type ReleaseCandidate:
    name: String
    tests_passed: Bool
    approved: Bool
    rollback_ready: Bool

type ReleaseChecks:
    tests_passed: Bool
    approved: Bool
    rollback_ready: Bool

type DefeaterReview:
    tests_failed: Bool
    approval_missing: Bool
    rollback_missing: Bool
    clear: Bool

type ReadinessPacket:
    change: ReleaseCandidate
    checks: ReleaseChecks
    defeaters: DefeaterReview

readiness_claim = "the supplied release is ready to deploy"

def ReadyToDeploy() -> Prop:
    return claim(readiness_claim)
