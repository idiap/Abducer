# Domain layer for scientific_contribution_cultivation.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type ResultAtlasSlice:
    result_id: String

type ScientificContributionHypothesis:
    contribution_hypothesis_id: String

type ContributionSupportAssessment:
    support_assessment_id: String

type ContributionValueAssessment:
    value_assessment_id: String

type MainProblemAlignmentAudit:
    audit_id: String

type EnablementAudit:
    audit_id: String

type ScientificContributionDisposition:
    | PaperReady
    | Refuted
    | Stalled

type ContributionReadinessAssessment:
    disposition: ScientificContributionDisposition
    value: ContributionValueAssessment
    alignment: MainProblemAlignmentAudit
    enablement: EnablementAudit
