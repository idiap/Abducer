{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/schemas/central_conceptual_route_reflection_request_v2.schema.json",
  "title": "Generation-correct theory-subordinate central reflection request",
  "description": "A failure-preserving projection of one authoritatively reopened central-route bundle. The central source commit N and canonical cycle input head N are separate typed roles even when they name the same immutable commit. The packet is authored against input head N; only the canonical compare-and-swap may commit its descendant effect at N+1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "request_id",
    "target_id",
    "run_id",
    "central_source_commit_generation",
    "cycle_input_head_generation",
    "descendant_effect_commit_generation",
    "central_source_verified_commit",
    "cycle_input_head_verified_commit",
    "generation_contract",
    "source_committed_input",
    "conceptual_ancestry_digest",
    "literature_projection_digest",
    "source_packet",
    "source_packet_digest",
    "source_bundle_manifest",
    "route_observations",
    "selected_candidate_set",
    "selection_is_set_valued",
    "current_theory_effect",
    "permitted_descendant_effect",
    "experiment_role",
    "authority_nulls",
    "authority_boundary",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "central_conceptual_route_reflection_request"},
    "request_id": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/id"},
    "target_id": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/id"},
    "run_id": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/id"},
    "central_source_commit_generation": {"type": "integer", "minimum": 1},
    "cycle_input_head_generation": {"type": "integer", "minimum": 1},
    "descendant_effect_commit_generation": {"type": "integer", "minimum": 2},
    "central_source_verified_commit": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/verifiedCommit"},
    "cycle_input_head_verified_commit": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/verifiedCommit"},
    "generation_contract": {"$ref": "#/$defs/generationContract"},
    "source_committed_input": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/committedInputBinding"},
    "conceptual_ancestry_digest": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/digest"},
    "literature_projection_digest": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/digest"},
    "source_packet": {"$ref": "./central_conceptual_route_packet_v3.schema.json"},
    "source_packet_digest": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/digest"},
    "source_bundle_manifest": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/bundleManifest"},
    "route_observations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/routeObservation"}
    },
    "selected_candidate_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/selectedCandidate"}
    },
    "selection_is_set_valued": {"const": true},
    "current_theory_effect": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/currentTheoryEffect"},
    "permitted_descendant_effect": {"const": "reflective_synthesis_proposal_at_cycle_input_head_committed_only_by_exact_n_plus_one_cas"},
    "experiment_role": {"const": "secondary_descendant_falsifier_only_after_reflective_theory_request"},
    "authority_nulls": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/authorityNulls"},
    "authority_boundary": {"type": "string", "minLength": 260},
    "content_digest": {"$ref": "./central_conceptual_route_reflection_request_v1.schema.json#/$defs/digest"}
  },
  "$defs": {
    "generationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "central_source_role",
        "cycle_packet_state_role",
        "descendant_effect_role",
        "same_generation_effect_authorized",
        "canonical_compare_and_swap_required"
      ],
      "properties": {
        "central_source_role": {"const": "postcommit_central_route_source"},
        "cycle_packet_state_role": {"const": "canonical_cycle_input_head"},
        "descendant_effect_role": {"const": "canonical_compare_and_swap_result"},
        "same_generation_effect_authorized": {"const": false},
        "canonical_compare_and_swap_required": {"const": true}
      }
    }
  }
}
