{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/schemas/discovery_operator_receipt.schema.json",
  "title": "Discovery operator execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "receipt_digest",
    "request_id",
    "request_digest",
    "invocation_id",
    "attempt",
    "operator",
    "identity",
    "required",
    "input_digest",
    "started_at",
    "completed_at",
    "duration_seconds",
    "status",
    "exit_code",
    "stdout_digest",
    "stderr_digest",
    "output_artifacts",
    "output_history_artifacts",
    "explicit_unknowns",
    "validator_receipts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"$ref": "#/$defs/identifier"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "invocation_id": {"$ref": "#/$defs/identifier"},
    "attempt": {"type": "integer", "minimum": 1},
    "operator": {"$ref": "#/$defs/operator"},
    "identity": {"$ref": "#/$defs/namespace"},
    "required": {"type": "boolean"},
    "input_digest": {"$ref": "#/$defs/digest"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "status": {"enum": ["succeeded", "failed", "timed_out", "skipped"]},
    "exit_code": {"type": ["integer", "null"]},
    "stdout_digest": {"$ref": "#/$defs/digest"},
    "stderr_digest": {"$ref": "#/$defs/digest"},
    "output_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "output_history_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "explicit_unknowns": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validator_receipts": {
      "type": "array",
      "items": {"$ref": "#/$defs/validatorReceipt"}
    },
    "search_provenance": {"$ref": "#/$defs/searchProvenance"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "stderr_excerpt": {"type": "string", "minLength": 1, "maxLength": 4096},
        "traceback_digest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {
        "properties": {
          "output_artifacts": {"minItems": 1},
          "output_history_artifacts": {"minItems": 1},
          "validator_receipts": {
            "minItems": 1,
            "items": {"properties": {"status": {"const": "passed"}}}
          }
        },
        "not": {"required": ["error"]}
      }
    },
    {
      "if": {
        "properties": {
          "operator": {"properties": {"kind": {"const": "literature_search"}}},
          "status": {"const": "succeeded"}
        }
      },
      "then": {"required": ["search_provenance"]}
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {"enum": ["latest", "current", "global"]}
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)(?:latest(?:\\.json)?|current)(?:/|$)).+$"
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "run_id", "branch_id", "state_version"],
      "properties": {
        "target_id": {"$ref": "#/$defs/identifier"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "branch_id": {"$ref": "#/$defs/identifier"},
        "state_version": {"type": "integer", "minimum": 0}
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "version", "kind"],
      "properties": {
        "operator_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/identifier"},
        "kind": {
          "enum": [
            "theory",
            "literature_search",
            "literature_assimilation",
            "hypothesis",
            "proof",
            "support_probe",
            "reducer",
            "evaluation"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "namespace"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "namespace": {"$ref": "#/$defs/namespace"},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "validatorReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_id",
        "validator_version",
        "validator_code_digest",
        "validator_authority",
        "request_id",
        "input_digest",
        "started_at",
        "completed_at",
        "status",
        "artifact_digests",
        "output_artifacts",
        "receipt_digest"
      ],
      "properties": {
        "validator_id": {"$ref": "#/$defs/identifier"},
        "validator_version": {"$ref": "#/$defs/identifier"},
        "validator_code_digest": {"$ref": "#/$defs/digest"},
        "validator_authority": {"$ref": "#/$defs/validatorAuthority"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "input_digest": {"$ref": "#/$defs/digest"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["passed", "failed"]},
        "artifact_digests": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
        "output_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "receipt_digest": {"$ref": "#/$defs/digest"},
        "detail": {"type": "string"}
      }
    },
    "validatorAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding_kind",
        "validator_id",
        "validator_version",
        "runtime_identity",
        "dependency_identities",
        "dependency_policy",
        "files",
        "coverage",
        "authority_digest"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "binding_kind": {"enum": ["command", "callable"]},
        "validator_id": {"$ref": "#/$defs/identifier"},
        "validator_version": {"$ref": "#/$defs/identifier"},
        "runtime_identity": {"type": "object", "minProperties": 2},
        "dependency_identities": {"type": "array", "items": {"type": "object"}},
        "dependency_policy": {
          "enum": [
            "declared_only",
            "derived_repository_closure_v2",
            "explicit_local_semantic_closure"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roles", "path_scope", "runtime_path", "sha256", "size_bytes",
              "snapshot_descriptor"
            ],
            "properties": {
              "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "path_scope": {"enum": ["workspace_relative", "repository_relative", "absolute_runtime"]},
              "runtime_path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/digest"},
              "size_bytes": {"type": "integer", "minimum": 0},
              "snapshot_descriptor": {"$ref": "#/$defs/artifact"}
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bound", "excluded"],
          "properties": {
            "bound": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "excluded": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "authority_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "searchProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queries",
        "providers",
        "completed_at",
        "coverage_cutoff",
        "inclusion_policy",
        "source_count",
        "content_digest"
      ],
      "properties": {
        "queries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "providers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "completed_at": {"type": "string", "format": "date-time"},
        "coverage_cutoff": {"type": "string", "format": "date-time"},
        "inclusion_policy": {"type": "string", "minLength": 1},
        "source_count": {"type": "integer", "minimum": 1},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
