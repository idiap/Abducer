# Domain layer for cohere_fast.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type CohereDomainTarget:
    domain_id: String
    target_ref: String

type CohereScopeActivation:
    domain_id: String
    target_ref: String
    activation_ref: String

type CohereIntakeDisposition:
    | Ready
    | Blocked
    | Stalled
