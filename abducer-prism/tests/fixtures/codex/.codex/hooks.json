{
  "description": "Minimal project guard",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {"type": "command", "command": "python scripts/policy.py", "timeout": 5}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python scripts/check_complete.py"}
        ]
      }
    ]
  }
}
