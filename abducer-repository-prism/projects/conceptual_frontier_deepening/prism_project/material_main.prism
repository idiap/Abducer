# Host-executed material graph for the complete reviewed reasoning path.
# Generated values retain the source epistemic boundary and are not native proof or experiment receipts.

from types import (
    BoundedConceptualFrontier,
    BridgeDerivedFormalClaim,
    ConceptualHypothesisRefutationAssessment,
    ConceptualHypothesisSelection,
    DiscriminatingConceptualHypothesis,
    FormalizationDisposition,
    FormalizationReadinessAssessment,
    FrozenConceptualContext,
    RevisedConceptualBridge,
)
from occurrences import (
    ConceptualHypothesisSelectionInput,
)

from generated.material_types import (
    MaterialFormalizationReadinessAssessment,
)

from generated.calibrated_candidate_skill_1 import calibrated_candidate_skill_1
from generated.conceptual_bridge_skill_1 import conceptual_bridge_skill_1
from generated.conceptual_frontier_skill_1 import conceptual_frontier_skill_1
from generated.conceptual_hypothesis_skill_1 import conceptual_hypothesis_skill_1
from generated.formal_claim_skill_1 import formal_claim_skill_1
from generated.hypothesis_selection_skill_1 import hypothesis_selection_skill_1
from generated.refutation_assessment_skill_1 import refutation_assessment_skill_1

# Real model capability for source occurrence conceptual_frontier:EvidentialConceptualFrontierGrounding.
agent conceptual_frontier_material_agent(
    task: FrozenConceptualContext,
) -> Result[Generated[BoundedConceptualFrontier], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[FrozenConceptualContext] = [conceptual_frontier_skill_1]

# Real model capability for source occurrence conceptual_hypothesis:AbductiveConceptualHypothesisFormation.
agent conceptual_hypothesis_material_agent(
    task: BoundedConceptualFrontier,
) -> Result[Generated[DiscriminatingConceptualHypothesis], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[BoundedConceptualFrontier] = [conceptual_hypothesis_skill_1]

# Real model capability for source occurrence refutation_assessment:RefutationalConceptualHypothesisAssessment.
agent refutation_assessment_material_agent(
    task: DiscriminatingConceptualHypothesis,
) -> Result[Generated[ConceptualHypothesisRefutationAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[DiscriminatingConceptualHypothesis] = [refutation_assessment_skill_1]

# Real model capability for source occurrence hypothesis_selection:EvidentialConceptualHypothesisSelection.
agent hypothesis_selection_material_agent(
    task: ConceptualHypothesisSelectionInput,
) -> Result[Generated[ConceptualHypothesisSelection], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ConceptualHypothesisSelectionInput] = [hypothesis_selection_skill_1]

# Real model capability for source occurrence conceptual_bridge:AnalogicalConceptualBridgeRevision.
agent conceptual_bridge_material_agent(
    task: ConceptualHypothesisSelection,
) -> Result[Generated[RevisedConceptualBridge], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ConceptualHypothesisSelection] = [conceptual_bridge_skill_1]

# Real model capability for source occurrence formal_claim:DeductiveFormalClaimDerivation.
agent formal_claim_material_agent(
    task: RevisedConceptualBridge,
) -> Result[Generated[BridgeDerivedFormalClaim], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[RevisedConceptualBridge] = [formal_claim_skill_1]

# Real model capability for source occurrence calibrated_candidate:EvidentialFormalizationReadinessAssessment.
agent calibrated_candidate_material_agent(
    task: BridgeDerivedFormalClaim,
) -> Result[Generated[MaterialFormalizationReadinessAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[BridgeDerivedFormalClaim] = [calibrated_candidate_skill_1]

workflow MaterializedConceptualFrontierDeepening(
    context: FrozenConceptualContext,
) -> Generated[MaterialFormalizationReadinessAssessment]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        # Grounding bounds the search before abductive formation begins.
        [conceptual_frontier: conceptual_frontier_material_agent(context)]
        [conceptual_hypothesis: conceptual_hypothesis_material_agent(conceptual_frontier.value)]
        # Refutation and selection prevent an attractive hypothesis from advancing alone.
        [refutation_assessment: refutation_assessment_material_agent(conceptual_hypothesis.value)]
        [hypothesis_selection: hypothesis_selection_material_agent(ConceptualHypothesisSelectionInput(
            conceptual_hypothesis = conceptual_hypothesis.value,
            refutation_assessment = refutation_assessment.value,
        ))]
        # Transfer creates a bridge; deduction makes its formal consequence explicit.
        [conceptual_bridge: conceptual_bridge_material_agent(hypothesis_selection.value)]
        [formal_claim: formal_claim_material_agent(conceptual_bridge.value)]
        # The final assessment routes the claim; it does not itself prove it.
        [calibrated_candidate: calibrated_candidate_material_agent(formal_claim.value)]

    return calibrated_candidate


def main(
    context: FrozenConceptualContext,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[MaterialFormalizationReadinessAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve MaterializedConceptualFrontierDeepening(context)
