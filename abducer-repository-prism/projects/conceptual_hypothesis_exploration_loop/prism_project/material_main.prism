# Host-executed material graph for the complete reviewed reasoning path.
# Generated values retain the source epistemic boundary and are not native proof or experiment receipts.

from types import (
    BridgeConsequenceRefutationAssessment,
    BridgeDerivedConsequence,
    ConceptualFailureState,
    ConceptualMediationHypothesis,
    ConceptualObstructionPressure,
    ConceptualRefinementDisposition,
    ConceptualRefinementRoutingAssessment,
    MediatingConceptualBridge,
)
from occurrences import (
    ConceptualRefinementRoutingInput,
)

from generated.material_types import (
    MaterialConceptualRefinementRoutingAssessment,
)

from generated.bridge_consequence_skill_1 import bridge_consequence_skill_1
from generated.conceptual_bridge_skill_1 import conceptual_bridge_skill_1
from generated.mediation_hypothesis_skill_1 import mediation_hypothesis_skill_1
from generated.obstruction_pressure_skill_1 import obstruction_pressure_skill_1
from generated.refinement_routing_skill_1 import refinement_routing_skill_1
from generated.refutation_assessment_skill_1 import refutation_assessment_skill_1

# Real model capability for source occurrence obstruction_pressure:EvidentialConceptualObstructionAssessment.
agent obstruction_pressure_material_agent(
    task: ConceptualFailureState,
) -> Result[Generated[ConceptualObstructionPressure], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ConceptualFailureState] = [obstruction_pressure_skill_1]

# Real model capability for source occurrence mediation_hypothesis:AbductiveMediationHypothesisFormation.
agent mediation_hypothesis_material_agent(
    task: ConceptualObstructionPressure,
) -> Result[Generated[ConceptualMediationHypothesis], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ConceptualObstructionPressure] = [mediation_hypothesis_skill_1]

# Real model capability for source occurrence conceptual_bridge:AnalogicalConceptualBridgeTransfer.
agent conceptual_bridge_material_agent(
    task: ConceptualMediationHypothesis,
) -> Result[Generated[MediatingConceptualBridge], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ConceptualMediationHypothesis] = [conceptual_bridge_skill_1]

# Real model capability for source occurrence bridge_consequence:DeductiveConceptualBridgeConsequenceDerivation.
agent bridge_consequence_material_agent(
    task: MediatingConceptualBridge,
) -> Result[Generated[BridgeDerivedConsequence], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[MediatingConceptualBridge] = [bridge_consequence_skill_1]

# Real model capability for source occurrence refutation_assessment:RefutationalBridgeConsequenceAssessment.
agent refutation_assessment_material_agent(
    task: BridgeDerivedConsequence,
) -> Result[Generated[BridgeConsequenceRefutationAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[BridgeDerivedConsequence] = [refutation_assessment_skill_1]

# Real model capability for source occurrence refinement_routing:EvidentialConceptualRefinementRoutingAssessment.
agent refinement_routing_material_agent(
    task: ConceptualRefinementRoutingInput,
) -> Result[Generated[MaterialConceptualRefinementRoutingAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ConceptualRefinementRoutingInput] = [refinement_routing_skill_1]

workflow MaterializedConceptualHypothesisExplorationLoop(
    failure_state: ConceptualFailureState,
) -> Generated[MaterialConceptualRefinementRoutingAssessment]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        # Diagnosis bounds what the abductive repair must explain.
        [obstruction_pressure: obstruction_pressure_material_agent(failure_state)]
        [mediation_hypothesis: mediation_hypothesis_material_agent(obstruction_pressure.value)]
        # Analogy constructs a bridge; deduction exposes a consequence that can fail.
        [conceptual_bridge: conceptual_bridge_material_agent(mediation_hypothesis.value)]
        [bridge_consequence: bridge_consequence_material_agent(conceptual_bridge.value)]
        # Refutation tests the consequence before the final routing calibration.
        [refutation_assessment: refutation_assessment_material_agent(bridge_consequence.value)]
        [refinement_routing: refinement_routing_material_agent(ConceptualRefinementRoutingInput(
            conceptual_bridge = conceptual_bridge.value,
            refutation_assessment = refutation_assessment.value,
        ))]

    return refinement_routing


def main(
    failure_state: ConceptualFailureState,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[MaterialConceptualRefinementRoutingAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve MaterializedConceptualHypothesisExplorationLoop(failure_state)
