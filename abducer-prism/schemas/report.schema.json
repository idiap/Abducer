{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prism.local/to-prism/report.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact": {"const": "report"},
    "conversion_class": {"enum": ["linked", "portable"]},
    "debts": {"items": {"type": "object"}, "type": "array"},
    "preservation": {"items": {"type": "object"}, "type": "array"},
    "publication": {"enum": ["blocked", "review_required", "publishable"]},
    "schema_version": {"const": "1.0"},
    "summary": {"type": "object"},
    "tool": {"type": "object"}
  },
  "required": ["artifact", "conversion_class", "debts", "preservation", "publication", "schema_version", "summary", "tool"],
  "type": "object"
}
