{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yang-Mills Endpoint Source Table Artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "target_id",
    "artifact_id",
    "fixed_regulated_geometry",
    "gauge_group",
    "regulator",
    "source_equivalence_class",
    "D_c",
    "seven_logZ_samples",
    "kappa_c_intervals",
    "M8",
    "M_G",
    "C_N",
    "T_tail",
    "I_gate_interval",
    "outcome_rules",
    "physical_relevance_boundary",
    "field_status"
  ],
  "properties": {
    "target_id": {
      "const": "yang-mills-existence-and-mass-gap-target"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "fixed_regulated_geometry": {
      "type": "string",
      "minLength": 1
    },
    "gauge_group": {
      "type": "string",
      "minLength": 1
    },
    "regulator": {
      "type": "string",
      "minLength": 1
    },
    "source_equivalence_class": {
      "type": "string",
      "minLength": 1
    },
    "D_c": {
      "type": ["string", "number", "object"]
    },
    "seven_logZ_samples": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7
    },
    "kappa_c_intervals": {
      "type": ["array", "object"]
    },
    "M8": {
      "type": ["string", "number", "object"]
    },
    "M_G": {
      "type": ["string", "number", "object"]
    },
    "C_N": {
      "type": ["string", "number", "object"]
    },
    "T_tail": {
      "type": ["string", "number", "object"]
    },
    "I_gate_interval": {
      "type": ["string", "array", "object"]
    },
    "outcome_rules": {
      "type": "object",
      "required": ["promote", "finite_falsifier", "quarantine"]
    },
    "physical_relevance_boundary": {
      "type": "string",
      "minLength": 1
    },
    "field_status": {
      "type": "object"
    }
  }
}
