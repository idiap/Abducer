{
  "version": 1,
  "purpose": "Typed route contract for proof-by-contradiction branches in Abducer's recursive discovery loop.",
  "required_fields": [
    "route_id",
    "target_claim",
    "route_family",
    "exact_negation",
    "preserved_commitments",
    "same_theory_invariant",
    "contradiction_carrier",
    "derived_consequence",
    "conflict_target",
    "conflict_target_status",
    "proof_obligations",
    "failure_modes",
    "validation_handoff",
    "domain_markers",
    "generative_interpretation",
    "expected_verdict"
  ],
  "list_fields": [
    "preserved_commitments",
    "proof_obligations",
    "failure_modes",
    "domain_markers"
  ],
  "allowed_verdicts": [
    "promote",
    "repair",
    "evidence-acquire",
    "revise",
    "quarantine",
    "reject",
    "watch"
  ],
  "allowed_conflict_target_status": [
    "accepted",
    "validator-backed",
    "proof-obligation",
    "conjectural",
    "missing",
    "incompatible"
  ],
  "audit_policy": {
    "minimum_exact_negation_words": 14,
    "minimum_domain_marker_count": 3,
    "minimum_preserved_commitments": 3,
    "minimum_proof_obligations": 3,
    "minimum_failure_modes": 2,
    "required_physics_markers": [
      "yang-mills",
      "gauge",
      "continuum",
      "hamiltonian",
      "spectral",
      "schwinger",
      "os",
      "reflection",
      "cutoff",
      "observable",
      "cumulant"
    ],
    "cross_theory_red_flags": [
      "different theory",
      "different hamiltonian",
      "finite lattice only",
      "fixed cutoff only",
      "fixed lattice spacing only",
      "strong-coupling only",
      "different subsequence",
      "not reconstructed"
    ],
    "too_strong_negation_red_flags": [
      "every possible",
      "all conceivable",
      "no state exists",
      "all excitations vanish",
      "all observables vanish"
    ]
  },
  "validation_policy": "A route is promotable only as a proof obligation, never as a completed proof. Promotion requires exact negation, same-theory preservation, a valid carrier, an evidence-backed conflict target, domain-specific mathematical language, and explicit failure modes."
}
