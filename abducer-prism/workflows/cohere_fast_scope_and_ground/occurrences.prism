# Occurrence layer for cohere_fast_scope_and_ground.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.

from workflows.cohere_fast_scope_and_ground.types import (
    DomainScopeGroundingRequest,
    DomainScopeGrounding,
    ScopeGroundingDisposition,
)

type UnresolvedDomainScopeGroundingProjection = DomainScopeGroundingRequest -> Generated[DomainScopeGrounding]

type EvidentialScopeGroundingDispositionAssessment = DomainScopeGrounding -> Generated[ScopeGroundingDisposition]
