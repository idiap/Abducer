# Occurrence layer for conceptual_hypothesis_exploration_loop.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.

from types import (
    BridgeDerivedConsequence,
    MediatingConceptualBridge,
    ConceptualFailureState,
    ConceptualObstructionPressure,
    BridgeConsequenceRefutationAssessment,
    ConceptualMediationHypothesis,
    ConceptualRefinementDisposition,
    ConceptualRefinementRoutingAssessment,
)

type ConceptualRefinementRoutingInput:
    conceptual_bridge: MediatingConceptualBridge
    refutation_assessment: BridgeConsequenceRefutationAssessment

type EvidentialConceptualObstructionAssessment = ConceptualFailureState -> Generated[ConceptualObstructionPressure]

type AbductiveMediationHypothesisFormation = ConceptualObstructionPressure -> Generated[ConceptualMediationHypothesis]

type AnalogicalConceptualBridgeTransfer = ConceptualMediationHypothesis -> Generated[MediatingConceptualBridge]

type DeductiveConceptualBridgeConsequenceDerivation = MediatingConceptualBridge -> Generated[BridgeDerivedConsequence]

type RefutationalBridgeConsequenceAssessment = BridgeDerivedConsequence -> Generated[BridgeConsequenceRefutationAssessment]

type EvidentialConceptualRefinementRoutingAssessment = ConceptualRefinementRoutingInput -> Generated[ConceptualRefinementRoutingAssessment]
