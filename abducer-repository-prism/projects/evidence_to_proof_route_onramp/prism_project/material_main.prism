# Host-executed material graph for the complete reviewed reasoning path.
# Generated values retain the source epistemic boundary and are not native proof or experiment receipts.

from types import (
    EntrypointFalsificationAssessment,
    ExpertRouteDossier,
    HubBiasAudit,
    ProofObligationEntrypointHypothesis,
    ProofRouteConsequenceAssessment,
    ProofRouteDerivedConsequence,
    ProofRouteDisposition,
    ProofRouteEvidenceGround,
    ProofRouteHypothesis,
    ProofRouteReadinessAssessment,
    ProofRouteSourceBundle,
)
from occurrences import (
    ProofRouteReadinessInput,
)

from generated.material_types import (
    MaterialProofRouteReadinessAssessment,
)

from generated.a0_skill_1 import a0_skill_1
from generated.a1_skill_1 import a1_skill_1
from generated.d0_skill_1 import d0_skill_1
from generated.e0_skill_1 import e0_skill_1
from generated.e1_skill_1 import e1_skill_1
from generated.e2_skill_1 import e2_skill_1
from generated.r0_skill_1 import r0_skill_1

# Real model capability for source occurrence e0:EvidentialProofRouteGrounding.
agent e0_material_agent(
    task: ProofRouteSourceBundle,
) -> Result[Generated[ProofRouteEvidenceGround], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ProofRouteSourceBundle] = [e0_skill_1]

# Real model capability for source occurrence a0:AbductiveProofRouteHypothesisFormation.
agent a0_material_agent(
    task: ProofRouteEvidenceGround,
) -> Result[Generated[ProofRouteHypothesis], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ProofRouteEvidenceGround] = [a0_skill_1]

# Real model capability for source occurrence d0:DeductiveProofRouteConsequenceDerivation.
agent d0_material_agent(
    task: ProofRouteHypothesis,
) -> Result[Generated[ProofRouteDerivedConsequence], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ProofRouteHypothesis] = [d0_skill_1]

# Real model capability for source occurrence e1:EvidentialProofRouteConsequenceAssessment.
agent e1_material_agent(
    task: ProofRouteDerivedConsequence,
) -> Result[Generated[ProofRouteConsequenceAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ProofRouteDerivedConsequence] = [e1_skill_1]

# Real model capability for source occurrence a1:AbductiveProofObligationEntrypointRevision.
agent a1_material_agent(
    task: ProofRouteConsequenceAssessment,
) -> Result[Generated[ProofObligationEntrypointHypothesis], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ProofRouteConsequenceAssessment] = [a1_skill_1]

# Real model capability for source occurrence r0:RefutationalProofEntrypointAssessment.
agent r0_material_agent(
    task: ProofObligationEntrypointHypothesis,
) -> Result[Generated[EntrypointFalsificationAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ProofObligationEntrypointHypothesis] = [r0_skill_1]

# Real model capability for source occurrence e2:EvidentialProofRouteReadinessAssessment.
agent e2_material_agent(
    task: ProofRouteReadinessInput,
) -> Result[Generated[MaterialProofRouteReadinessAssessment], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[ProofRouteReadinessInput] = [e2_skill_1]

workflow MaterializedEvidenceToProofRouteOnramp(
    source: ProofRouteSourceBundle,
) -> Generated[MaterialProofRouteReadinessAssessment]
    fails ModelFailure
    ! {AI.Generate, Context.Disclose}:
    sequence:
        # Grounding and abduction create a source-constrained route hypothesis.
        [e0: e0_material_agent(source)]
        [a0: a0_material_agent(e0.value)]
        # Deduction and evidence assessment make the route's consequences inspectable.
        [d0: d0_material_agent(a0.value)]
        [e1: e1_material_agent(d0.value)]
        # Revision selects a proof entrypoint; refutation then challenges that entry.
        [a1: a1_material_agent(e1.value)]
        [r0: r0_material_agent(a1.value)]
        # The final join preserves both the proposed entrypoint and its falsification record.
        [e2: e2_material_agent(ProofRouteReadinessInput(
            proof_entrypoint = a1.value,
            falsification_assessment = r0.value,
        ))]

    return e2

# HANDOFF (non-executable): when e2 is theorem-shaped and route-ready, adapt
# the dossier to ProofQueueItem and offer it to theorem_proof_delivery. When
# conceptual refinement is required, pass the dossier through the declared
# legacy conceptual-input adapter. A handoff transports provenance, claim
# ceilings, taints, and open obligations; it adds no proof or truth warrant.
# ACCEPT (non-executable): this onramp has no local terminal accept transition;
# route_ready is a handoff condition, not proof acceptance.
# STOP (non-executable): a refuted r0 stops this route. Contract failures stop
# or quarantine as declared; exit requires ExpertRouteDossier,
# EntrypointFalsificationAssessment, and HubBiasAudit, with open obligations declared.


def main(
    source: ProofRouteSourceBundle,
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[MaterialProofRouteReadinessAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    return solve MaterializedEvidenceToProofRouteOnramp(source)
