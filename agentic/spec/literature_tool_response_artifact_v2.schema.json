{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/schemas/literature_tool_response_artifact_v2.schema.json",
  "title": "Sealed multi-execution literature observation artifact v2",
  "description": "A closed record of one differentiated literature lane whose exposed items may be reconstructed from several separately observed web or primary-API executions. Execution identity proves only agent-recorded provenance: provider authentication, source truth, ranking completeness, and exhaustiveness remain unavailable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "target_id",
    "lane_id",
    "lane_type",
    "executions",
    "execution_bindings",
    "response_exposure",
    "result_items",
    "normalization_links",
    "claim_boundary",
    "content_digest"
  ],
  "$defs": {
    "id": {"$ref": "literature_tool_response_artifact.schema.json#/$defs/id"},
    "digest": {"$ref": "literature_tool_response_artifact.schema.json#/$defs/digest"},
    "nonempty": {"$ref": "literature_tool_response_artifact.schema.json#/$defs/nonempty"},
    "lane_type": {"$ref": "literature_tool_response_artifact.schema.json#/$defs/lane_type"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "operation", "locator", "domains", "response_length", "request_digest"],
      "properties": {
        "request_id": {"$ref": "#/$defs/id"},
        "operation": {"enum": ["search_query", "https_get"]},
        "locator": {"$ref": "#/$defs/nonempty"},
        "domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "response_length": {
          "oneOf": [
            {"enum": ["short", "medium", "long"]},
            {"type": "null"}
          ]
        },
        "request_digest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "search_query"}}},
          "then": {
            "properties": {
              "response_length": {"enum": ["short", "medium", "long"]}
            }
          }
        },
        {
          "if": {"properties": {"operation": {"const": "https_get"}}},
          "then": {
            "properties": {
              "locator": {"type": "string", "format": "uri"},
              "domains": {"maxItems": 0},
              "response_length": {"type": "null"}
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "tool_name",
        "request",
        "observed_started_at",
        "observed_completed_at",
        "execution_mode",
        "external_provider_request_id",
        "external_authentication_status",
        "complete_response_available_to_agent",
        "raw_response_retained",
        "response_projection_mode",
        "observation_authority",
        "exposure_boundary",
        "execution_digest"
      ],
      "properties": {
        "execution_id": {"$ref": "#/$defs/id"},
        "tool_name": {"enum": ["web.run", "zenodo.records-api"]},
        "request": {"$ref": "#/$defs/request"},
        "observed_started_at": {"type": "string", "format": "date-time"},
        "observed_completed_at": {"type": "string", "format": "date-time"},
        "execution_mode": {
          "enum": ["agent_observed_tool_call", "agent_observed_https_request"]
        },
        "external_provider_request_id": {"type": "null"},
        "external_authentication_status": {"const": "unavailable"},
        "complete_response_available_to_agent": {"type": "boolean"},
        "raw_response_retained": {"const": false},
        "response_projection_mode": {
          "enum": ["bounded_tool_visible_metadata", "bounded_primary_api_metadata"]
        },
        "observation_authority": {"const": "agent_recorded_unauthenticated_execution"},
        "exposure_boundary": {"$ref": "#/$defs/nonempty"},
        "execution_digest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {"properties": {"tool_name": {"const": "web.run"}}},
          "then": {
            "properties": {
              "request": {"properties": {"operation": {"const": "search_query"}}},
              "execution_mode": {"const": "agent_observed_tool_call"},
              "complete_response_available_to_agent": {"const": false},
              "response_projection_mode": {"const": "bounded_tool_visible_metadata"}
            }
          }
        },
        {
          "if": {"properties": {"tool_name": {"const": "zenodo.records-api"}}},
          "then": {
            "properties": {
              "request": {"properties": {"operation": {"const": "https_get"}}},
              "execution_mode": {"const": "agent_observed_https_request"},
              "complete_response_available_to_agent": {"const": true},
              "response_projection_mode": {"const": "bounded_primary_api_metadata"}
            }
          }
        }
      ]
    },
    "execution_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "item_ids", "lineage_evidence_ids", "binding_digest"],
      "properties": {
        "execution_id": {"$ref": "#/$defs/id"},
        "item_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "lineage_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "binding_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "result_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "provider_rank",
        "title",
        "url",
        "displayed_publication",
        "bounded_excerpt",
        "excerpt_word_count",
        "retrieval_class",
        "source_observation",
        "item_digest"
      ],
      "properties": {
        "item_id": {"$ref": "#/$defs/id"},
        "provider_rank": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "title": {"$ref": "#/$defs/nonempty"},
        "url": {"type": "string", "format": "uri"},
        "displayed_publication": {"type": ["string", "null"]},
        "bounded_excerpt": {"$ref": "#/$defs/nonempty"},
        "excerpt_word_count": {"type": "integer", "minimum": 1, "maximum": 24},
        "retrieval_class": {
          "enum": [
            "search_result_metadata",
            "primary_page_metadata",
            "primary_api_metadata",
            "publisher_metadata"
          ]
        },
        "source_observation": {
          "$ref": "literature_tool_response_artifact.schema.json#/$defs/source_observation"
        },
        "item_digest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_kind": {"const": "codex_multi_execution_literature_observation"},
    "target_id": {"$ref": "#/$defs/id"},
    "lane_id": {"$ref": "#/$defs/id"},
    "lane_type": {"$ref": "#/$defs/lane_type"},
    "executions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/execution"}
    },
    "execution_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/execution_binding"}
    },
    "response_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_mode",
        "complete_backend_payload_available",
        "complete_ranking_trace_available",
        "selected_result_count",
        "lane_outcome",
        "selection_rule"
      ],
      "properties": {
        "capture_mode": {"const": "bounded_multi_execution_metadata_projection"},
        "complete_backend_payload_available": {"const": false},
        "complete_ranking_trace_available": {"const": false},
        "selected_result_count": {"type": "integer", "minimum": 0},
        "lane_outcome": {"enum": ["completed_with_results", "completed_no_results"]},
        "selection_rule": {"$ref": "#/$defs/nonempty"}
      }
    },
    "result_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/result_item"}
    },
    "normalization_links": {
      "type": "array",
      "items": {
        "$ref": "literature_tool_response_artifact.schema.json#/$defs/normalization_link"
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_truth_authority",
        "peer_review_authority",
        "exhaustiveness_authority",
        "novelty_authority",
        "provider_authentication_authority",
        "allowed_use"
      ],
      "properties": {
        "source_truth_authority": {"const": false},
        "peer_review_authority": {"const": false},
        "exhaustiveness_authority": {"const": false},
        "novelty_authority": {"const": false},
        "provider_authentication_authority": {"const": false},
        "allowed_use": {"const": "bounded discovery routing and explicit claim-audit creation only"}
      }
    },
    "content_digest": {"$ref": "#/$defs/digest"}
  }
}
