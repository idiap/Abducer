{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/schemas/adjacent_abstraction_method_literature_lane.schema.json",
  "title": "Target-separated adjacent abstraction-method literature lane",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "lane_id",
    "target_id",
    "selection_basis",
    "sources",
    "permitted_uses",
    "forbidden_uses",
    "target_separation",
    "authority",
    "authority_boundary",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "adjacent_abstraction_method_literature_lane"},
    "lane_id": {"$ref": "#/$defs/identifier"},
    "target_id": {"$ref": "#/$defs/identifier"},
    "selection_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observed_at", "record_count", "primary_record_class"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "record_count": {"type": "integer", "minimum": 1},
        "primary_record_class": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "permitted_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_uses": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "target_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship",
        "direct_target_source_ids",
        "excluded_target_source_ids",
        "excluded_capture_dates",
        "target_specific_forbidden_claims",
        "target_claim_support"
      ],
      "properties": {
        "relationship": {"const": "adjacent_abstraction_method_only"},
        "direct_target_source_ids": {"type": "array", "maxItems": 0},
        "excluded_target_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "excluded_capture_dates": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "format": "date"}
        },
        "target_specific_forbidden_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "target_claim_support": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_context_only",
        "direct_target_claim_authority",
        "proof_authority",
        "global_latestness_authority",
        "exhaustiveness_authority"
      ],
      "properties": {
        "method_context_only": {"const": true},
        "direct_target_claim_authority": {"const": false},
        "proof_authority": {"const": false},
        "global_latestness_authority": {"const": false},
        "exhaustiveness_authority": {"const": false}
      }
    },
    "authority_boundary": {"type": "string", "minLength": 180},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "version_id",
        "title",
        "authors",
        "version_date",
        "version_event",
        "url",
        "method_topic",
        "method_relevance",
        "target_relevance"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "version_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "authors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "version_date": {"type": "string", "format": "date"},
        "version_event": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "method_topic": {"type": "string", "minLength": 1},
        "method_relevance": {"type": "string", "minLength": 40},
        "target_relevance": {
          "const": "adjacent_method_only_no_direct_target_support"
        }
      }
    }
  }
}
