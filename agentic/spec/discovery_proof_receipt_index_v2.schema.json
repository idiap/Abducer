{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/discovery_proof_receipt_index_v2.schema.json",
  "title": "Immutable proof receipt and coordination-terminal index v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "index_kind",
    "index_id",
    "index_digest",
    "receipt_id",
    "receipt_content_digest",
    "receipt_ref",
    "receipt_file_sha256",
    "authorization_id",
    "handoff_id",
    "handoff_digest",
    "formal_claim_digest",
    "target_id",
    "run_id",
    "cycle_id",
    "branch_id",
    "obligation_id",
    "attempt_id",
    "attempt_number",
    "action_id",
    "action_digest",
    "reservation_id",
    "reservation_digest",
    "terminal_record_id",
    "terminal_record_digest",
    "terminal_record_ref",
    "terminal_status",
    "source_theory_generation",
    "source_commit_id",
    "created_at",
    "authority_nulls"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "index_kind": {"const": "proof_receipt_coordination_terminal_join"},
    "index_id": {"$ref": "#/$defs/identifier"},
    "index_digest": {"$ref": "#/$defs/digest"},
    "receipt_id": {"$ref": "#/$defs/identifier"},
    "receipt_content_digest": {"$ref": "#/$defs/digest"},
    "receipt_ref": {"$ref": "#/$defs/safePath"},
    "receipt_file_sha256": {"$ref": "#/$defs/digest"},
    "authorization_id": {"$ref": "#/$defs/identifier"},
    "handoff_id": {"$ref": "#/$defs/identifier"},
    "handoff_digest": {"$ref": "#/$defs/digest"},
    "formal_claim_digest": {"$ref": "#/$defs/digest"},
    "target_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "cycle_id": {"$ref": "#/$defs/identifier"},
    "branch_id": {"$ref": "#/$defs/identifier"},
    "obligation_id": {"$ref": "#/$defs/identifier"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "attempt_number": {"type": "integer", "minimum": 1},
    "action_id": {"$ref": "#/$defs/identifier"},
    "action_digest": {"$ref": "#/$defs/digest"},
    "reservation_id": {"$ref": "#/$defs/identifier"},
    "reservation_digest": {"$ref": "#/$defs/digest"},
    "terminal_record_id": {"$ref": "#/$defs/identifier"},
    "terminal_record_digest": {"$ref": "#/$defs/digest"},
    "terminal_record_ref": {"$ref": "#/$defs/safePath"},
    "terminal_status": {"enum": ["completed", "failed", "rebase_required", "cancelled"]},
    "source_theory_generation": {"type": "integer", "minimum": 1},
    "source_commit_id": {"$ref": "#/$defs/identifier"},
    "created_at": {"type": "string", "format": "date-time"},
    "authority_nulls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth_authority", "theory_selection_authority", "same_cycle_theory_mutation", "physics_authority"],
      "properties": {
        "truth_authority": {"const": false},
        "theory_selection_authority": {"const": false},
        "same_cycle_theory_mutation": {"const": false},
        "physics_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)latest(?:/|$)).+$"}
  }
}
