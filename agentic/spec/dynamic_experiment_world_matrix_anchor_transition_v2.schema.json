{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/dynamic_experiment_world_matrix_anchor_transition_v2.schema.json",
  "title": "Thin canonical world-matrix anchor transition v2",
  "description": "The anchor owns one commission, its producer binding, and exactly five request/binding pairs as separate immutable objects. No recursive domain object is embedded in the transition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "transition_kind", "programme_id", "target_id", "run_id",
    "prior_generation", "prior_commit_identity", "expected_commit_generation", "cycle_id",
    "authority_projection_id", "authority_projection_digest",
    "commission_id", "commission_digest", "commission_object",
    "commission_producer_binding_object", "world_request_objects",
    "world_request_producer_binding_objects", "world_request_batch_digest",
    "world_order", "observed_world_ids", "missing_world_ids", "observation_count",
    "new_observation_count", "status", "certificate",
    "prior_state_semantic_digest", "next_state_semantic_digest",
    "changed_state_paths", "theory_state_changed",
    "frozen_theory_state_projection_digest", "commit_local_evidence_manifest",
    "authority_boundary", "transition_digest"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "transition_kind": {"const": "theory_and_commission_anchor"},
    "programme_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "target_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "run_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "prior_generation": {"type": "integer", "minimum": 1},
    "prior_commit_identity": {"$ref": "./discovery_verified_commit_identity.schema.json"},
    "expected_commit_generation": {"type": "integer", "minimum": 2},
    "cycle_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "authority_projection_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "authority_projection_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "commission_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
    "commission_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "commission_object": {"$ref": "./dynamic_experiment_committed_object_descriptor_v1.schema.json"},
    "commission_producer_binding_object": {"$ref": "./dynamic_experiment_committed_object_descriptor_v1.schema.json"},
    "world_request_objects": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {"$ref": "./dynamic_experiment_committed_object_descriptor_v1.schema.json"}
    },
    "world_request_producer_binding_objects": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {"$ref": "./dynamic_experiment_committed_object_descriptor_v1.schema.json"}
    },
    "world_request_batch_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "world_order": {"const": ["no_probe", "neutral_inconclusive", "misleading_toy_positive", "registered_premise_falsifier", "operational_failure"]},
    "observed_world_ids": {"const": []},
    "missing_world_ids": {"const": ["no_probe", "neutral_inconclusive", "misleading_toy_positive", "registered_premise_falsifier", "operational_failure"]},
    "observation_count": {"const": 0},
    "new_observation_count": {"const": 0},
    "status": {"const": "commissioned"},
    "certificate": {"type": "null"},
    "prior_state_semantic_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "next_state_semantic_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "changed_state_paths": {"const": ["/generation"]},
    "theory_state_changed": {"const": false},
    "frozen_theory_state_projection_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"},
    "commit_local_evidence_manifest": {"$ref": "#/$defs/evidenceManifest"},
    "authority_boundary": {"$ref": "#/$defs/authorityBoundary"},
    "transition_digest": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"}
  },
  "$defs": {
    "evidenceEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_authority_id", "files"],
      "properties": {
        "evidence_authority_id": {"$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"},
        "files": {
          "type": "object", "additionalProperties": false,
          "required": ["producer_request", "producer_receipt", "artifact", "immutable_history", "governed_clock"],
          "properties": {
            "producer_request": {"$ref": "./dynamic_experiment_committed_object_descriptor_v1.schema.json"},
            "producer_receipt": {"$ref": "./dynamic_experiment_committed_object_descriptor_v1.schema.json"},
            "artifact": {"$ref": "./dynamic_experiment_committed_object_descriptor_v1.schema.json"},
            "immutable_history": {"$ref": "./dynamic_experiment_committed_object_descriptor_v1.schema.json"},
            "governed_clock": {"$ref": "./dynamic_experiment_committed_object_descriptor_v1.schema.json"}
          }
        }
      }
    },
    "evidenceManifest": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceEntry"}
    },
    "authorityBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["theory_first", "experiment_role", "theory_mutation_authorized", "certificate_authority_before_aggregation"],
      "properties": {
        "theory_first": {"const": true},
        "experiment_role": {"const": "secondary_theory_support_only"},
        "theory_mutation_authorized": {"const": false},
        "certificate_authority_before_aggregation": {"const": false}
      }
    }
  }
}
