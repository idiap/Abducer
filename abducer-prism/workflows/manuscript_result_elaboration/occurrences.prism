from workflows.manuscript_result_elaboration.types import (
    ManuscriptReadinessAssessment,
    ExpansionValidation,
    ExtensionValidityAssessment,
    IntegratedPaperDraft,
    ManuscriptReadinessDisposition,
    PaperDraft,
    PaperReadinessDecision,
    ManuscriptExtensionHypothesis,
    ManuscriptResultScope,
)

type ManuscriptReadinessInput:
    extension_hypothesis: ManuscriptExtensionHypothesis
    validity_assessment: ExtensionValidityAssessment

type EvidentialManuscriptResultScopeAssessment = PaperDraft -> Generated[ManuscriptResultScope]

type AbductiveManuscriptExtensionHypothesisFormation = ManuscriptResultScope -> Generated[ManuscriptExtensionHypothesis]

type RefutationalManuscriptExtensionAssessment = ManuscriptExtensionHypothesis -> Generated[ExtensionValidityAssessment]

type EvidentialManuscriptReadinessAssessment = ManuscriptReadinessInput -> Generated[ManuscriptReadinessAssessment]
