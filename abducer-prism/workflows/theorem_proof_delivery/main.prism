# Fixture-backed typed smoke entrypoint for theorem_proof_delivery.
# Routing comments and linked validators remain outside this executable boundary.
from workflows.theorem_proof_delivery.materialization import converted_reasoning
from workflows.theorem_proof_delivery.reasoning import TheoremProofDelivery
from workflows.theorem_proof_delivery.types import ExplicitPremises, ProofQueueItem, TheoremProofDispositionAssessment

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[TheoremProofDispositionAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    item = ProofQueueItem(
        queue_item_id = "fixture:theorem_proof_delivery:item.queue_item_id",
        premises = ExplicitPremises(
            premise_set_id = "fixture:theorem_proof_delivery:item.premises.premise_set_id",
            exact_statement = "fixture:theorem_proof_delivery:item.premises.exact_statement",
        ),
    )
    flow = converted_reasoning(item)
    return solve TheoremProofDelivery(item) using flow
