# Domain layer for conceptual_hypothesis_exploration_loop.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type ConceptualFailureState:
    obstruction: String

type ConceptualObstructionPressure:
    structural_pressure: String

type ConceptualMediationHypothesis:
    mediation_hypothesis: String

type MediatingConceptualBridge:
    correspondence: String

type BridgeDerivedConsequence:
    bridge_consequence: String

type BridgeConsequenceRefutationAssessment:
    scoped_refutation: String

type ConceptualRefinementDisposition:
    | WorkReady
    | ReadyForReleasePromotion
    | Refuted

type ConceptualRefinementRoutingAssessment:
    disposition: ConceptualRefinementDisposition
    routing_basis: String
