{
  "version": 1,
  "purpose": "Typed packet for Abducer Gedanken experiments: imagined but concrete situations designed to elicit transferable conceptual or mathematical insight for later discovery cycles.",
  "required_fields": [
    "packet_id",
    "target_id",
    "created_utc",
    "source_artifacts",
    "originating_cycle_ids",
    "originating_branch_ids",
    "need_decision",
    "need_assessment",
    "trigger_criteria",
    "situation",
    "variables",
    "interventions",
    "expected_observations",
    "variants",
    "insight_hypotheses",
    "transfer_scope",
    "affected_node_ids",
    "affected_edge_ids",
    "graph_update_action",
    "proposed_graph_updates",
    "followup_cycle_tasks",
    "failure_modes",
    "epistemic_status",
    "validation_handoff"
  ],
  "allowed_need_decisions": [
    "not_needed",
    "design_now",
    "run_concrete_probe_first",
    "defer_until_variable_typed",
    "defer_until_regime_typed",
    "quarantine_as_analogy"
  ],
  "allowed_epistemic_status": [
    "conceptual_probe",
    "conjectural",
    "validated_probe",
    "challenged",
    "invalidated",
    "explicit_unknown",
    "proof_obligation"
  ],
  "allowed_followup_actions": [
    "derive",
    "compute",
    "falsify",
    "formalize",
    "search_prior_art",
    "update_graph",
    "rank_next_experiment",
    "backtrack",
    "quarantine"
  ],
  "allowed_graph_update_actions": [
    "none",
    "needs_probe",
    "challenge_edge",
    "revise_edge",
    "annotate_edge",
    "quarantine"
  ],
  "need_assessment_required_fields": [
    "decision",
    "criteria_met",
    "criteria_missing",
    "rejected_alternatives",
    "why_not_direct_derivation_or_probe"
  ],
  "situation_required_fields": [
    "title",
    "purpose",
    "minimal_world",
    "mathematical_carrier",
    "controlled_contrast",
    "why_this_situation_is_informative",
    "non_claims"
  ],
  "variable_required_fields": [
    "id",
    "role",
    "control_status",
    "held_fixed_or_varied",
    "validity_regime"
  ],
  "intervention_required_fields": [
    "id",
    "operation",
    "varied_variable",
    "held_fixed",
    "predicted_direction",
    "decision_value"
  ],
  "observation_required_fields": [
    "id",
    "observable",
    "expected_pattern",
    "what_it_would_teach",
    "what_would_disconfirm_it"
  ],
  "variant_required_fields": [
    "id",
    "changed_condition",
    "predicted_change",
    "reason_for_variant"
  ],
  "followup_required_fields": [
    "action",
    "description",
    "success_criterion",
    "failure_or_demotion_criterion",
    "required_skills",
    "packet_id",
    "situation_title",
    "transfer_verdict"
  ]
}
