# Domain layer for evidence_to_proof_route_onramp.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type ProofRouteSourceBundle:
    source_id: String

type ProofRouteEvidenceGround:
    source_id: String

type ProofRouteHypothesis:
    route_hypothesis_id: String

type ProofRouteDerivedConsequence:
    derived_consequence_id: String

type ProofRouteConsequenceAssessment:
    consequence_assessment_id: String

type ProofObligationEntrypointHypothesis:
    entrypoint_hypothesis_id: String

type EntrypointFalsificationAssessment:
    falsification_assessment_id: String

type HubBiasAudit:
    audit_id: String

type ExpertRouteDossier:
    dossier_id: String

type ProofRouteDisposition:
    | RouteReady
    | RequiresConceptualRefinement
    | Refuted

type ProofRouteReadinessAssessment:
    disposition: ProofRouteDisposition
    dossier: ExpertRouteDossier
    falsification: EntrypointFalsificationAssessment
    hub_bias: HubBiasAudit
