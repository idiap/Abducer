# Primitive fields and an immutable nominal record.
type ReviewRequest:
    text: String
    revision: Nat
    urgent: Bool
    tags: List[String]

type ReviewFinding:
    summary: String
    accepted: Bool
    score: Float

# A closed sum for exhaustive routing or failure handling.
type ReviewError:
    | MissingInput
    | PolicyViolation(rule: String)

# A generic record and ordinary collection fields.
type Envelope[Payload]:
    value: Payload
    source_name: String
    attributes: Map[String, String]
    flags: Set[String]

# Callable, optional, and explicit-failure contracts.
type ReviewStep = (
    request: ReviewRequest,
) -> Result[Computed[ReviewFinding], ReviewError]

type OptionalFinding = Option[ReviewFinding]
type ReviewPair = Tuple[ReviewRequest, ReviewFinding]

# A proposition is a claim, not a Bool-valued test.
def FindingAccepted(finding: Computed[ReviewFinding]) -> Prop:
    return claim("the computed review finding satisfies the acceptance policy")

def ReviewPolicySatisfied() -> Prop:
    return claim("the release review policy is satisfied")

# Provenance families. These aliases do not create or upgrade values.
type ModelDraft = Generated[ReviewFinding]
type ObservedRequest = Evidence[ReviewRequest]
type DeterministicFinding = Computed[ReviewFinding]

# Assurance families. Each requires its own explicit construction boundary.
type AcceptedFinding = Validated[
    value: Computed[ReviewFinding],
    FindingAccepted(value),
]

type MaterialFinding = Supported[ReviewPolicySatisfied()]
type FindingProof = Proof[ReviewPolicySatisfied()]
type KernelVerifiedFinding = Verified[
    Computed[ReviewFinding],
    ReviewPolicySatisfied(),
]

# Capability and artifact contracts used at material boundaries.
type PythonReview = (
    request: ReviewRequest,
    access: PythonCall,
) -> Result[ReviewFinding, PythonError] ! {Python.Call}

type ReviewTool = Tool[ReviewStep]
type ReviewSkill = Skill[ReviewRequest]
type ReviewHooks = Hooks[Codex]
type ReviewResource = Resource[String]
type ReviewSource = Source[ReviewRequest]
