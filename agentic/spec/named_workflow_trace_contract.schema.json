{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/named_workflow_trace_contract.schema.json",
  "title": "Named workflow public reasoning trace requirements",
  "type": "object",
  "required": ["version", "source_registry", "workflows"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "source_registry": {"type": "string", "minLength": 1},
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/workflowTraceContract"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "step_id", "skill", "mode", "disposition", "event_family",
        "inference_operator", "required_fields", "evidence_roles",
        "required_contrast", "authority_boundary"
      ],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "skill": {"type": "string", "minLength": 1},
        "mode": {"enum": ["required", "conditional", "advisory", "validator_only", "specialist"]},
        "disposition": {"enum": ["semantic_event_required", "validator_event_required", "conditional_event_or_justified_na", "specialist_event_required"]},
        "event_family": {"type": "string", "minLength": 1},
        "inference_operator": {"type": "string", "minLength": 1},
        "required_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "evidence_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["supports", "refutes", "constrains", "background"]}},
        "required_contrast": {"type": "string", "minLength": 1},
        "authority_boundary": {"type": "string", "minLength": 1},
        "consumes": {"type": "array", "items": {"type": "string"}},
        "produces": {"type": "array", "items": {"type": "string"}},
        "when": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "profileTraceContract": {
      "type": "object",
      "required": ["id", "version", "trace_spine", "steps", "specialists"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "trace_spine": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
        "specialists": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
        "validation_tail_start": {"type": ["string", "null"]},
        "validation_tail_adapter": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    "workflowTraceContract": {
      "type": "object",
      "required": ["id", "version", "trace_spine", "expert_question", "steps", "profiles"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "trace_spine": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expert_question": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
        "profiles": {"type": "array", "items": {"$ref": "#/$defs/profileTraceContract"}}
      },
      "additionalProperties": false
    }
  }
}
