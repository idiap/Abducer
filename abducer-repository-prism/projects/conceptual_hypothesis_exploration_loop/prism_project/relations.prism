# Relation layer for conceptual_hypothesis_exploration_loop.
# Owns edge/certificate contracts only; builders belong to future materialization.

type ObstructionPressureConstraint[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

type ConceptualMediationTransfer[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

type BridgeConsequenceAssumption[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

type BridgeConsequenceTest[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

type ConceptualRefinementCalibration[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation BoundsConceptualObstructionPressure[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ObstructionPressureConstraint[SourceValue, TargetValue]

relation TransfersMediationIntoBridge[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ConceptualMediationTransfer[SourceValue, TargetValue]

relation TreatsBridgeAsConsequencePremise[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> BridgeConsequenceAssumption[SourceValue, TargetValue]

relation TestsBridgeConsequence[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> BridgeConsequenceTest[SourceValue, TargetValue]

relation CalibratesConceptualRefinementRouting[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ConceptualRefinementCalibration[SourceValue, TargetValue]
