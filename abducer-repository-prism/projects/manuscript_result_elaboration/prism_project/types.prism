# Domain layer for manuscript_result_elaboration.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type PaperDraft:
    draft_id: String

type ManuscriptResultScope:
    scope_id: String

type ManuscriptExtensionHypothesis:
    extension_id: String

type ExtensionValidityAssessment:
    validity_assessment_id: String

type IntegratedPaperDraft:
    draft_id: String

type ExpansionValidation:
    validation_id: String

type PaperReadinessDecision:
    readiness_decision_id: String

type ManuscriptReadinessDisposition:
    | ProofRequired
    | PaperReady
    | Stalled

type ManuscriptReadinessAssessment:
    disposition: ManuscriptReadinessDisposition
    draft: IntegratedPaperDraft
    expansion: ExpansionValidation
    readiness: PaperReadinessDecision
