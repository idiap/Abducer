# Relation layer for target_navigation_loop.
# Owns edge/certificate contracts only; builders belong to future materialization.

type TargetNavigationDependency[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation DependencyFrontierEnablesTargetDisposition[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> TargetNavigationDependency[SourceValue, TargetValue]
