# Relation layer for theorem_proof_delivery.
# Owns edge/certificate contracts only; builders belong to future materialization.

type ExactTheoremClaimTest[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

type TheoremProofDispositionCalibration[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation TestsExactTheoremClaim[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ExactTheoremClaimTest[SourceValue, TargetValue]

relation CalibratesTheoremProofDisposition[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> TheoremProofDispositionCalibration[SourceValue, TargetValue]
