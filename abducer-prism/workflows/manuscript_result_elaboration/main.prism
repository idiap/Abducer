# Fixture-backed typed smoke entrypoint for manuscript_result_elaboration.
# Routing comments and linked validators remain outside this executable boundary.
from workflows.manuscript_result_elaboration.materialization import converted_reasoning
from workflows.manuscript_result_elaboration.reasoning import ManuscriptResultElaboration
from workflows.manuscript_result_elaboration.types import ManuscriptReadinessAssessment, PaperDraft

def main(
    model_access: ModelGenerate,
    disclosure: ContextDisclose,
) -> Result[Generated[ManuscriptReadinessAssessment], ModelFailure] ! {AI.Generate, Context.Disclose}:
    paper = PaperDraft(
        draft_id = "fixture:manuscript_result_elaboration:paper.draft_id",
    )
    flow = converted_reasoning(paper)
    return solve ManuscriptResultElaboration(paper) using flow
