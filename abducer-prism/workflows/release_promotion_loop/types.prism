# Domain layer for release_promotion_loop.
# Owns nominal workflow data and closed alternatives; no operations or effects.

type PromotionEvidencePacket:
    run_id: String
    evidence_ref: String

type ClaimBoundedReleaseProposal:
    run_id: String
    proposal_ref: String

type ReleasePromotionDisposition:
    | Promoted
    | RepairTarget
    | RepairConcept
    | Rejected
