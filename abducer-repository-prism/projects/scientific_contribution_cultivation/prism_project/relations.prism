# Relation layer for scientific_contribution_cultivation.
# Owns edge/certificate contracts only; builders belong to future materialization.

type ContributionHypothesisTest[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

type ContributionReadinessCalibration[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation TestsContributionHypothesis[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ContributionHypothesisTest[SourceValue, TargetValue]

relation CalibratesContributionReadiness[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ContributionReadinessCalibration[SourceValue, TargetValue]
