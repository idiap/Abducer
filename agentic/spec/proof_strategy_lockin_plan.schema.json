{
  "version": 1,
  "schema_id": "proof_strategy_lockin_plan",
  "description": "Bounded proof-strategy lock-in plan for completing, demoting, or blocking a publication-worthy subgoal.",
  "required_fields": [
    "subgoal_statement",
    "non_claims",
    "locked_hard_gates",
    "allowed_cycle_types",
    "cycle_budget",
    "stop_conditions",
    "publication_target",
    "anti_definitionality_tests",
    "return_to_exploration_trigger",
    "final_state",
    "learning_events_to_write",
    "evidence",
    "validation_handoff"
  ],
  "allowed_final_states": [
    "publication_ready_subgoal",
    "precise_demotion",
    "blocked_named_lemma",
    "no_publication_result",
    "released_to_exploration",
    "quarantined"
  ]
}
