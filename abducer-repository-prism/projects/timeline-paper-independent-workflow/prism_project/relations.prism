# Relation layer for timeline-paper-independent-workflow.
# Owns edge/certificate contracts only; builders belong to future materialization.

type TimelinePaperDependency[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation ClaimSetEnablesPaperDisposition[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> TimelinePaperDependency[SourceValue, TargetValue]
