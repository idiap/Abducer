{
  "version": 1,
  "purpose": "Visible reasoning-progress events for monitoring Abducer's conceptual and mathematical work without storing hidden chain-of-thought.",
  "required_fields": [
    "event_id",
    "run_id",
    "target_id",
    "workflow_id",
    "timestamp_utc",
    "phase",
    "event_type",
    "title",
    "narrative_summary",
    "mathematical_objects",
    "conceptual_move",
    "target_commitments",
    "evidence_paths",
    "epistemic_status",
    "uncertainty",
    "proof_obligations",
    "visual_encoding"
  ],
  "allowed_event_types": [
    "target_spine",
    "dependency_frontier",
    "conceptual_pressure",
    "candidate_generation",
    "validation_gate",
    "route_ranking",
    "proof_obligation",
    "contradiction_route",
    "subgoal_control_decision",
    "evidence_request",
    "drift_guard",
    "reflection",
    "stop_condition"
  ],
  "allowed_epistemic_status": [
    "conjectural",
    "evidence-backed",
    "proof-obligation",
    "blocked",
    "refuted",
    "promoted",
    "quarantined",
    "watch/archive"
  ],
  "visual_encoding_required_fields": [
    "lane",
    "salience",
    "color_token",
    "glyph",
    "detail_level"
  ],
  "allowed_lanes": [
    "target",
    "dependency",
    "conceptual",
    "candidate",
    "validation",
    "drift",
    "reflection"
  ],
  "allowed_salience": [
    "low",
    "medium",
    "high",
    "critical"
  ],
  "policy": "Reasoning event logs communicate public, inspectable mathematical and epistemic reasoning. They must cite artifacts or explicit unknowns and must not store hidden chain-of-thought."
}
