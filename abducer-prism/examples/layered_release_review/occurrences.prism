from examples.layered_release_review.types import (
    DefeaterReview,
    ReadyToDeploy,
    ReleaseCandidate,
    ReleaseChecks,
)

type CaptureEvidence = ReleaseCandidate -> Evidence[ReleaseCandidate]
type DeriveChecks = Evidence[ReleaseCandidate] -> ReleaseChecks

type DefeaterInput:
    checks: ReleaseChecks
    change: ReleaseCandidate

type ReadinessInput:
    evidence: Evidence[ReleaseCandidate]
    checks: ReleaseChecks
    defeaters: DefeaterReview
    change: ReleaseCandidate

type FindDefeaters = DefeaterInput -> DefeaterReview
type SupportReadiness = ReadinessInput -> Supported[ReadyToDeploy()]
