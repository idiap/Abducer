def a0_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ManuscriptScopeConstraint[SourceValue, TargetValue]:
    return ManuscriptScopeConstraint(source = source, target = target)

def r0_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ManuscriptExtensionTest[SourceValue, TargetValue]:
    return ManuscriptExtensionTest(source = source, target = target)

def e1_reasoning_relation_builder[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> ManuscriptReadinessCalibration[SourceValue, TargetValue]:
    return ManuscriptReadinessCalibration(source = source, target = target)

# EvidentialManuscriptResultScopeAssessment performs the reviewed calibrate boundary.
# Granularity: The source exposes CalibrateResultScope as a separately consumed typed result in the manuscript_result_elaboration occurrence graph.
# Linked source skill: skills/evaluation/epistemic-status-ledger/SKILL.md (sha256:980ad92b1f190316a941b8124eaffc6c414680666d2960ebcc8bd21444b4d454).
agent e0_reasoning_agent(
    task: PaperDraft,
) -> Result[Generated[ManuscriptResultScope], ModelFailure]
    ! {AI.Generate, Context.Disclose}:
    skills: Skills[PaperDraft] = [e0_reasoning_skill_1]

