{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/dynamic_experiment_causal_materializer_portable_headers_v3.schema.json",
  "title": "Structural headers for portable causal byte-materialization v3",
  "description": "Six typed evidence headers and one binding root turn a locally verified path-bearing materializer seal into a relocation-safe content graph. Header validity establishes only structural protocol authority. It never authors scientific content, selects a theory, interprets an experiment, proves a claim, or grants physics authority.",
  "oneOf": [
    {"$ref": "#/$defs/evidenceHeader"},
    {"$ref": "#/$defs/bindingHeader"}
  ],
  "$defs": {
    "digest": {
      "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/digest"
    },
    "identifier": {
      "$ref": "./dynamic_experiment_v3_common.schema.json#/$defs/identifier"
    },
    "identity": {
      "$ref": "./dynamic_experiment_compact_evidence_ref_v3.schema.json#/properties/namespace"
    },
    "contentRef": {
      "$ref": "./dynamic_experiment_content_object_ref_v1.schema.json"
    },
    "artifactRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"object_kind": {"const": "causal_materializer_artifact_evidence_v3"}}}
      ]
    },
    "requestRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"object_kind": {"const": "causal_materializer_request_record_v3"}}}
      ]
    },
    "attemptRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"object_kind": {"const": "causal_materializer_attempt_record_v3"}}}
      ]
    },
    "clockRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"object_kind": {"const": "causal_materializer_clock_record_v3"}}}
      ]
    },
    "dependencyRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"object_kind": {"const": "causal_materializer_dependency_record_v3"}}}
      ]
    },
    "evidenceHeaderRef": {
      "allOf": [
        {"$ref": "#/$defs/contentRef"},
        {"properties": {"object_kind": {"const": "causal_materializer_evidence_header_v3"}}}
      ]
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_graph_authority",
        "domain_payload_authority",
        "scientific_authority",
        "theory_mutation_authorized"
      ],
      "properties": {
        "storage_graph_authority": {"const": "structural_reference_only"},
        "domain_payload_authority": {"const": false},
        "scientific_authority": {"const": false},
        "theory_mutation_authorized": {"const": false}
      }
    },
    "baseHeader": {
      "type": "object",
      "required": [
        "schema_version",
        "header_kind",
        "header_id",
        "header_digest",
        "source_snapshot_digest",
        "semantic_authorship",
        "authority_boundary"
      ],
      "properties": {
        "schema_version": {"const": "3.0.0"},
        "header_id": {"$ref": "#/$defs/identifier"},
        "header_digest": {"$ref": "#/$defs/digest"},
        "source_snapshot_digest": {"$ref": "#/$defs/digest"},
        "semantic_authorship": {"const": false},
        "authority_boundary": {"$ref": "#/$defs/authorityBoundary"}
      }
    },
    "evidenceHeader": {
      "allOf": [
        {"$ref": "#/$defs/baseHeader"},
        {
          "type": "object",
          "required": [
            "contract_version",
            "evidence_authority_id",
            "stage_id",
            "materializer_role",
            "identity",
            "evidence_kind",
            "evidence_payload_refs",
            "successful_attempt"
          ],
          "properties": {
            "contract_version": {"const": "causal-byte-materializer-portable-evidence-header/3.0.0"},
            "header_kind": {"const": "causal_materializer_evidence_header_v3"},
            "evidence_authority_id": {"$ref": "#/$defs/identifier"},
            "stage_id": {"$ref": "#/$defs/identifier"},
            "materializer_role": {"$ref": "#/$defs/identifier"},
            "identity": {"$ref": "#/$defs/identity"},
            "evidence_kind": {
              "enum": [
                "staged_input",
                "producer_request",
                "attempt_receipts",
                "producer_artifact",
                "immutable_history",
                "governed_clock"
              ]
            },
            "evidence_payload_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/contentRef"}
            },
            "successful_attempt": {"type": ["integer", "null"], "minimum": 1, "maximum": 32}
          }
        },
        {
          "if": {
            "properties": {"evidence_kind": {"enum": ["staged_input", "producer_artifact", "immutable_history"]}},
            "required": ["evidence_kind"]
          },
          "then": {
            "properties": {
              "evidence_payload_refs": {"minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
              "successful_attempt": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"evidence_kind": {"const": "producer_request"}}, "required": ["evidence_kind"]},
          "then": {
            "properties": {
              "evidence_payload_refs": {"minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/requestRef"}},
              "successful_attempt": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"evidence_kind": {"const": "attempt_receipts"}}, "required": ["evidence_kind"]},
          "then": {
            "properties": {
              "evidence_payload_refs": {"items": {"$ref": "#/$defs/attemptRef"}},
              "successful_attempt": {"type": "integer", "minimum": 1, "maximum": 32}
            }
          }
        },
        {
          "if": {"properties": {"evidence_kind": {"const": "governed_clock"}}, "required": ["evidence_kind"]},
          "then": {
            "properties": {
              "evidence_payload_refs": {"minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/clockRef"}},
              "successful_attempt": {"type": "null"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ceilings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_artifact_bytes",
        "max_request_bytes",
        "max_receipt_bytes",
        "max_binding_bytes",
        "max_path_bytes",
        "max_attempts",
        "subprocess_timeout_seconds"
      ],
      "properties": {
        "max_artifact_bytes": {"const": 8388608},
        "max_request_bytes": {"const": 262144},
        "max_receipt_bytes": {"const": 1048576},
        "max_binding_bytes": {"const": 4194304},
        "max_path_bytes": {"const": 512},
        "max_attempts": {"const": 32},
        "subprocess_timeout_seconds": {"const": 30}
      }
    },
    "bindingHeader": {
      "allOf": [
        {"$ref": "#/$defs/baseHeader"},
        {
          "type": "object",
          "required": [
            "contract_version",
            "source_binding_id",
            "source_binding_digest",
            "capability_kind",
            "materialization_semantics",
            "local_protocol_valid",
            "evidence_authority_id",
            "stage_id",
            "materializer_role",
            "artifact_id",
            "artifact_digest",
            "identity",
            "invocation_id",
            "dependency_record_ref",
            "staged_input_evidence_header_ref",
            "producer_request_evidence_header_ref",
            "attempt_receipts_evidence_header_ref",
            "producer_artifact_evidence_header_ref",
            "immutable_history_evidence_header_ref",
            "governed_clock_evidence_header_ref",
            "successful_attempt",
            "artifact_alias_policy",
            "ceilings"
          ],
          "properties": {
            "contract_version": {"const": "causal-byte-materializer-portable-binding-header/3.0.0"},
            "header_kind": {"const": "causal_materializer_binding_header_v3"},
            "source_binding_id": {"$ref": "#/$defs/identifier"},
            "source_binding_digest": {"$ref": "#/$defs/digest"},
            "capability_kind": {"const": "causal_byte_materializer"},
            "materialization_semantics": {"const": "exact_canonical_input_bytes_copied_without_interpretation"},
            "local_protocol_valid": {"const": true},
            "evidence_authority_id": {"$ref": "#/$defs/identifier"},
            "stage_id": {"$ref": "#/$defs/identifier"},
            "materializer_role": {"$ref": "#/$defs/identifier"},
            "artifact_id": {"$ref": "#/$defs/identifier"},
            "artifact_digest": {"$ref": "#/$defs/digest"},
            "identity": {"$ref": "#/$defs/identity"},
            "invocation_id": {"$ref": "#/$defs/identifier"},
            "dependency_record_ref": {"$ref": "#/$defs/dependencyRef"},
            "staged_input_evidence_header_ref": {"$ref": "#/$defs/evidenceHeaderRef"},
            "producer_request_evidence_header_ref": {"$ref": "#/$defs/evidenceHeaderRef"},
            "attempt_receipts_evidence_header_ref": {"$ref": "#/$defs/evidenceHeaderRef"},
            "producer_artifact_evidence_header_ref": {"$ref": "#/$defs/evidenceHeaderRef"},
            "immutable_history_evidence_header_ref": {"$ref": "#/$defs/evidenceHeaderRef"},
            "governed_clock_evidence_header_ref": {"$ref": "#/$defs/evidenceHeaderRef"},
            "successful_attempt": {"type": "integer", "minimum": 1, "maximum": 32},
            "artifact_alias_policy": {"const": "one_content_object_for_verified_staged_output_history_bytes"},
            "ceilings": {"$ref": "#/$defs/ceilings"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
