              "record_index": {"type": "integer", "minimum": 0},
              "record_digest": {"$ref": "#/$defs/digest"},
              "semantic_signature": {"$ref": "#/$defs/semanticSignature"}
            }
          }
        },
        "candidate_signature_multiset_digest": {"$ref": "#/$defs/digest"},
        "genealogy_signature_multiset_digest": {"$ref": "#/$defs/digest"},
        "closure_digest": {"$ref": "#/$defs/digest"}
      }
