# Occurrence layer for cohere_fast_independent_audit.
# Owns semantic join records and exact generative operation signatures.
# Occurrence boundaries follow independently consumed epistemic commitments,
# not the number or order of linked skills.

from types import (
    IndependentAuditDisposition,
    ConditionalDerivationPacket,
    IndependentRefutationAssessment,
)

type IndependentAuditDispositionInput:
    derivation: ConditionalDerivationPacket
    refutation_assessment: IndependentRefutationAssessment

type RefutationalIndependentDerivationAudit = ConditionalDerivationPacket -> Generated[IndependentRefutationAssessment]

type EvidentialIndependentAuditDispositionAssessment = IndependentAuditDispositionInput -> Generated[IndependentAuditDisposition]
