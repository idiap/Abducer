{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abducer.local/spec/discovery_formal_claim_producer_output_v2.schema.json",
  "title": "Registered formal-claim producer output v2",
  "description": "One claim-and-checker plan derived by the registered formal-claim producer from an exact sealed conceptual source row. This output carries claim identity and provenance, not truth, theorem, theory-selection, or physics authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "output_kind",
    "output_id",
    "content_digest",
    "target_id",
    "run_id",
    "source_prior_state_version",
    "source_theory_generation",
    "branch_id",
    "hypothesis_id",
    "concept_id",
    "conceptual_system_ids",
    "conjecture_id",
    "source_operator_id",
    "source_operator_request_id",
    "source_operator_receipt_id",
    "source_operator_receipt_digest",
    "source_output_path",
    "source_output_digest",
    "source_finalized_reflection_id",
    "source_finalized_reflection_digest",
    "source_conceptual_authority_digest",
    "source_semantic_kind",
    "source_semantic_row_id",
    "source_semantic_row_digest",
    "source_theory_programme_id",
    "source_theory_programme_digest",
    "literature_authority",
    "literature_authority_digest",
    "theory_ancestry",
    "theory_ancestry_digest",
    "producer_generation_mode",
    "status",
    "rejection_reason",
    "display_statement",
    "formal_claim",
    "formal_claim_digest",
    "proof_adapter",
    "execution_plan",
    "execution_plan_digest",
    "no_same_cycle_experiment_ancestry",
    "authority_nulls"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "output_kind": {"const": "registered_formal_claim_producer_output"},
    "output_id": {"$ref": "#/$defs/identifier"},
    "content_digest": {"$ref": "#/$defs/digest"},
    "target_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "source_prior_state_version": {"type": "integer", "minimum": 0},
    "source_theory_generation": {"type": "integer", "minimum": 1},
    "branch_id": {"$ref": "#/$defs/identifier"},
    "hypothesis_id": {"$ref": "#/$defs/identifier"},
    "concept_id": {"$ref": "#/$defs/identifier"},
    "conceptual_system_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "conjecture_id": {"$ref": "#/$defs/identifier"},
    "source_operator_id": {"const": "reflective-theory-synthesizer"},
    "source_operator_request_id": {"$ref": "#/$defs/identifier"},
    "source_operator_receipt_id": {"$ref": "#/$defs/identifier"},
    "source_operator_receipt_digest": {"$ref": "#/$defs/digest"},
    "source_output_path": {"$ref": "#/$defs/safePath"},
    "source_output_digest": {"$ref": "#/$defs/digest"},
    "source_finalized_reflection_id": {"$ref": "#/$defs/identifier"},
    "source_finalized_reflection_digest": {"$ref": "#/$defs/digest"},
    "source_conceptual_authority_digest": {"$ref": "#/$defs/digest"},
    "source_semantic_kind": {"const": "formalization_seed"},
    "source_semantic_row_id": {"$ref": "#/$defs/identifier"},
    "source_semantic_row_digest": {"$ref": "#/$defs/digest"},
    "source_theory_programme_id": {"$ref": "#/$defs/identifier"},
    "source_theory_programme_digest": {"$ref": "#/$defs/digest"},
    "literature_authority": {
      "$ref": "./discovery_proof_handoff.schema.json#/$defs/literatureAuthority"
    },
    "literature_authority_digest": {"$ref": "#/$defs/digest"},
    "theory_ancestry": {
      "$ref": "#/$defs/precommitTheoryAncestry"
    },
    "theory_ancestry_digest": {"$ref": "#/$defs/digest"},
    "producer_generation_mode": {
      "const": "registered_deterministic_compiler"
    },
    "status": {"enum": ["ready", "not_ready"]},
    "rejection_reason": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "detail"],
          "properties": {
            "code": {
              "enum": [
                "untyped_formalization_seed",
                "unsupported_formal_claim_kind",
                "unsupported_proof_adapter",
                "source_ancestry_mismatch",
                "source_not_formalization_ready"
              ]
            },
            "detail": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "display_statement": {"type": "string", "minLength": 1},
    "formal_claim": {
      "oneOf": [
        {"$ref": "./discovery_proof_handoff.schema.json#/$defs/formalClaim"},
        {"type": "null"}
      ]
    },
    "formal_claim_digest": {
      "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    },
    "proof_adapter": {
      "oneOf": [
        {"enum": ["exact", "finite_model", "lean", "command"]},
        {"type": "null"}
      ]
    },
    "execution_plan": {
      "oneOf": [
        {"$ref": "./discovery_proof_handoff.schema.json#/$defs/executionPlan"},
        {"type": "null"}
      ]
    },
    "execution_plan_digest": {
      "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    },
    "no_same_cycle_experiment_ancestry": {"const": true},
    "authority_nulls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_truth",
        "checker_soundness",
        "theorem_status",
        "theory_selection",
        "same_cycle_theory_mutation",
        "independent_semantic_authorship",
        "physics_value"
      ],
      "properties": {
        "claim_truth": {"const": false},
        "checker_soundness": {"const": false},
        "theorem_status": {"const": false},
        "theory_selection": {"const": false},
        "same_cycle_theory_mutation": {"const": false},
        "independent_semantic_authorship": {"const": false},
        "physics_value": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "ready"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "rejection_reason": {"type": "null"},
          "formal_claim": {
            "$ref": "./discovery_proof_handoff.schema.json#/$defs/formalClaim"
          },
          "formal_claim_digest": {"$ref": "#/$defs/digest"},
          "proof_adapter": {"enum": ["exact", "finite_model", "lean", "command"]},
          "execution_plan": {
            "$ref": "./discovery_proof_handoff.schema.json#/$defs/executionPlan"
          },
          "execution_plan_digest": {"$ref": "#/$defs/digest"}
        }
      },
      "else": {
        "properties": {
          "rejection_reason": {"type": "object"},
          "formal_claim": {"type": "null"},
          "formal_claim_digest": {"type": "null"},
          "proof_adapter": {"type": "null"},
          "execution_plan": {"type": "null"},
          "execution_plan_digest": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1},
    "precommitTheoryAncestry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conceptual_authority_digest",
        "parent_adjudication_evidence_digest",
        "synthesis_adjudication_evidence_digest",
        "preferred_system_ids"
      ],
      "properties": {
        "conceptual_authority_digest": {"$ref": "#/$defs/digest"},
        "parent_adjudication_evidence_digest": {"$ref": "#/$defs/digest"},
        "synthesis_adjudication_evidence_digest": {"$ref": "#/$defs/digest"},
        "preferred_system_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)latest(?:/|$)).+$"
    }
  }
}
