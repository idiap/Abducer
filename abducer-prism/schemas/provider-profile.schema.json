{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prism.local/to-prism/provider-profile.schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_rules": {"items": {"type": "object"}, "type": "array"},
    "hooks": {"type": "object"},
    "limitations": {"items": {"type": "string"}, "type": "array"},
    "profile_version": {"minLength": 1, "type": "string"},
    "project_markers": {"items": {"type": "string"}, "type": "array"},
    "provider": {"enum": ["codex", "claude", "opencode", "open-agent-skill"]},
    "retrieved_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "type": "string"},
    "schema_version": {"const": 1},
    "sources": {"items": {"type": "object"}, "type": "array"}
  },
  "required": ["artifact_rules", "hooks", "limitations", "profile_version", "project_markers", "provider", "retrieved_at", "schema_version", "sources"],
  "type": "object"
}
