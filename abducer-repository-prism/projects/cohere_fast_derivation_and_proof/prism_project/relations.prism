# Relation layer for cohere_fast_derivation_and_proof.
# Owns edge/certificate contracts only; builders belong to future materialization.

type DerivationAssessmentDependency[SourceValue, TargetValue]:
    source: SourceValue
    target: Generated[TargetValue]

relation DerivationPacketEnablesReadinessAssessment[SourceValue, TargetValue](
    source: SourceValue,
    target: Generated[TargetValue],
) -> DerivationAssessmentDependency[SourceValue, TargetValue]
